        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam проналази велике видео снимке, снимке екрана и дупликате да бисте могли да изаберете шта да обришете. Ваше фотографије остају на iPhone-у."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam pronalazi velike video snimke, snimke ekrana i duplikate da biste mogli da izaberete šta da obrišete. Vaše fotografije ostaju na iPhone-u."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam hittar stora videor, skärmbilder och dubbletter så att du kan välja vad som ska raderas. Dina foton stannar på din iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam, neyi sileceğinizi seçebilmeniz için büyük videoları, ekran görüntülerini ve kopyaları bulur. Fotoğraflarınız iPhone’unuzda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam 会查找大视频、截屏和重复项，让你选择要删除什么。你的照片会保留在 iPhone 上。"
