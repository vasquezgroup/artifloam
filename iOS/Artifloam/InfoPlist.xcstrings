    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر Artifloam على مقاطع الفيديو الكبيرة ولقطات الشاشة والنسخ المكررة لتختار ما تحذفه. تبقى صورك على الـ iPhone."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam troba vídeos grans, captures de pantalla i duplicats perquè triïs què esborrar. Les teves fotos es queden a l’iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam findet große Videos, Screenshots und Duplikate, damit du wählen kannst, was du löschst. Deine Fotos bleiben auf deinem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds large videos, screenshots and duplicates so you can choose what to delete. Your photos stay on your iPhone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds large videos, screenshots and duplicates so you can choose what to delete. Your photos stay on your iPhone."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
