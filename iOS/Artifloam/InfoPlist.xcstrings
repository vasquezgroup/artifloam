        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam findet doppleti Kontakt, damit du chasch wähle, welli du zämefüehrsch. Dini Kontakt blibed uf dim iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam डुप्लिकेट संपर्क खोजता है ताकि आप चुन सकें कि कौन से मर्ज करने हैं। आपके संपर्क आपके iPhone पर ही रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam pronalazi duplicirane kontakte da možeš odabrati koje spojiti. Tvoji kontakti ostaju na iPhoneu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam trova i contatti duplicati così puoi scegliere quali unire. I tuoi contatti restano sul tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloamは重複した連絡先を見つけ、統合するものを選べるようにします。連絡先はiPhoneに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam이 중복된 연락처를 찾아 병합할 항목을 선택할 수 있게 합니다. 연락처는 iPhone에 그대로 남습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam atrod dublētus kontaktus, lai varētu izvēlēties, kurus apvienot. Tavi kontakti paliek tavā iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam znajduje zduplikowane kontakty, aby można było wybrać, które scalić. Twoje kontakty zostają na iPhonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Artifloam encontra contactos duplicados para que escolha quais unir. Os seus contactos ficam no iPhone."
