{
  "sourceLanguage" : "en",
  "strings" : {
    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر Artifloam على جهات الاتصال المكررة لتختار أيها تدمج. تبقى جهات اتصالك على الـ iPhone."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam troba contactes duplicats perquè triïs quins combinar. Els teus contactes es queden a l’iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam findet doppelte Kontakte, damit du wählen kannst, welche du zusammenführst. Deine Kontakte bleiben auf deinem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds duplicate contacts so you can choose which to merge. Your contacts stay on your iPhone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds duplicate contacts so you can choose which to merge. Your contacts stay on your iPhone."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds duplicate contacts so you can choose which to merge. Your contacts stay on your iPhone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds duplicate contacts so you can choose which to merge. Your contacts stay on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam encuentra contactos duplicados para que elijas cuáles fusionar. Tus contactos se quedan en tu iPhone."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam encuentra contactos duplicados para que elijas cuáles fusionar. Tus contactos se quedan en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam repère les contacts en double pour que vous choisissiez lesquels fusionner. Vos contacts restent sur votre iPhone."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam findet doppleti Kontakt, damit du chasch wähle, welli du zämefüehrsch. Dini Kontakt blibed uf dim iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam डुप्लिकेट संपर्क खोजता है ताकि आप चुन सकें कि कौन से मर्ज करने हैं। आपके संपर्क आपके iPhone पर ही रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam pronalazi duplicirane kontakte da možeš odabrati koje spojiti. Tvoji kontakti ostaju na iPhoneu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam trova i contatti duplicati così puoi scegliere quali unire. I tuoi contatti restano sul tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloamは重複した連絡先を見つけ、統合するものを選べるようにします。連絡先はiPhoneに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam이 중복된 연락처를 찾아 병합할 항목을 선택할 수 있게 합니다. 연락처는 iPhone에 그대로 남습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam atrod dublētus kontaktus, lai varētu izvēlēties, kurus apvienot. Tavi kontakti paliek tavā iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam znajduje zduplikowane kontakty, aby można było wybrać, które scalić. Twoje kontakty zostają na iPhonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Artifloam encontra contactos duplicados para que escolha quais unir. Os seus contactos ficam no iPhone."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam gjen kontakte të dyfishuara që të zgjedhësh cilat do të bashkosh. Kontaktet e tua mbeten në iPhone tënd."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam проналази дуплиране контакте да бисте могли да изаберете које да спојите. Ваши контакти остају на iPhone-у."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam pronalazi duplirane kontakte da biste mogli da izaberete koje da spojite. Vaši kontakti ostaju na iPhone-u."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam hittar dubbletter av kontakter så att du kan välja vilka som ska slås ihop. Dina kontakter stannar på din iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam, hangilerini birleştireceğinizi seçebilmeniz için kopya kişileri bulur. Kişileriniz iPhone’unuzda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam 会查找重复的联系人，让你选择要合并哪些。你的联系人会保留在 iPhone 上。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل Artifloam قائمة تطبيقات هذا iPhone بين Mac وiPhone عبر شبكة Wi-Fi الخاصة بك. القائمة مشفّرة وتبقى على أجهزتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam envia la llista d'apps d'aquest iPhone entre el teu Mac i l'iPhone per la teva xarxa Wi-Fi. Està xifrada i es queda als teus dispositius."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam überträgt die App-Liste dieses iPhone über dein WLAN zwischen deinem Mac und iPhone. Sie ist verschlüsselt und bleibt auf deinen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam sends the list of this iPhone's apps between your Mac and iPhone over your Wi-Fi. It's encrypted and stays on your devices."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam sends the list of this iPhone's apps between your Mac and iPhone over your Wi-Fi. It's encrypted and stays on your devices."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam sends the list of this iPhone's apps between your Mac and iPhone over your Wi-Fi. It's encrypted and stays on your devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam sends the list of this iPhone's apps between your Mac and iPhone over your Wi-Fi. It's encrypted and stays on your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam envía la lista de apps de este iPhone entre tu Mac y tu iPhone por tu red Wi-Fi. Está cifrada y se queda en tus dispositivos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam envía la lista de apps de este iPhone entre tu Mac y tu iPhone por tu red Wi-Fi. Está cifrada y permanece en tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam transfère la liste des apps de cet iPhone entre votre Mac et votre iPhone via votre réseau Wi-Fi. Elle est chiffrée et reste sur vos appareils."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam schickt d App-Lischte vo dem iPhone über dis WLAN zwüsched dim Mac und iPhone. Si isch verschlüsslet und bliibt uf dine Grät."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam इस iPhone की ऐप सूची को आपके Wi-Fi पर आपके Mac और iPhone के बीच भेजता है। यह एन्क्रिप्टेड है और आपके डिवाइस पर ही रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam šalje popis aplikacija ovog iPhonea između tvog Maca i iPhonea preko tvoje Wi-Fi mreže. Popis je šifriran i ostaje na tvojim uređajima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam invia l'elenco delle app di questo iPhone tra il tuo Mac e il tuo iPhone tramite la tua rete Wi-Fi. È criptato e resta sui tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloamは、このiPhoneのアプリ一覧をWi-Fi経由でMacとiPhoneの間で送信します。一覧は暗号化され、お使いのデバイス内にとどまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam은 이 iPhone의 앱 목록을 Wi-Fi를 통해 Mac과 iPhone 간에 전송합니다. 목록은 암호화되며 사용자의 기기에만 보관됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam pārsūta šī iPhone lietotņu sarakstu starp tavu Mac un iPhone tavā Wi-Fi tīklā. Tas ir šifrēts un paliek tavās ierīcēs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam przesyła listę aplikacji tego iPhone’a między Twoim Makiem a iPhone’em przez Twoją sieć Wi-Fi. Lista jest zaszyfrowana i pozostaje na Twoich urządzeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Artifloam envia a lista de apps deste iPhone entre o seu Mac e o seu iPhone pela sua rede Wi-Fi. Ela é criptografada e fica nos seus dispositivos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam dërgon listën e aplikacioneve të këtij iPhone ndërmjet Mac-ut dhe iPhone-it tuaj përmes rrjetit tuaj Wi-Fi. Ajo është e enkriptuar dhe qëndron në pajisjet tuaja."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam шаље списак апликација овог iPhone уређаја између твог Mac рачунара и iPhone уређаја преко твоје Wи-Фи мреже. Списак је шифрован и остаје на твојим уређајима."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam šalje spisak aplikacija ovog iPhone uređaja između tvog Mac računara i iPhone uređaja preko tvoje Wi-Fi mreže. Spisak je šifrovan i ostaje na tvojim uređajima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam skickar listan över appar på den här iPhonen mellan din Mac och iPhone via ditt Wi-Fi. Den är krypterad och stannar på dina enheter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam, bu iPhone’daki uygulamaların listesini Wi-Fi ağınız üzerinden Mac’iniz ile iPhone’unuz arasında gönderir. Liste şifrelidir ve aygıtlarınızda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam 通过你的 Wi-Fi 在 Mac 和 iPhone 之间发送这台 iPhone 的 App 列表。列表已加密，只保存在你的设备上。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر Artifloam على مقاطع الفيديو الكبيرة ولقطات الشاشة والنسخ المكررة لتختار ما تحذفه. تبقى صورك على الـ iPhone."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam troba vídeos grans, captures de pantalla i duplicats perquè triïs què esborrar. Les teves fotos es queden a l’iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam findet große Videos, Screenshots und Duplikate, damit du wählen kannst, was du löschst. Deine Fotos bleiben auf deinem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds large videos, screenshots and duplicates so you can choose what to delete. Your photos stay on your iPhone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds large videos, screenshots and duplicates so you can choose what to delete. Your photos stay on your iPhone."
          }
