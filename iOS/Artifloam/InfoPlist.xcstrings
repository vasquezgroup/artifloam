        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam बड़े वीडियो, स्क्रीनशॉट और डुप्लिकेट खोजता है ताकि आप चुन सकें कि क्या डिलीट करना है। आपकी फ़ोटो आपके iPhone पर ही रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam pronalazi velike videozapise, snimke zaslona i duplikate da možeš odabrati što izbrisati. Tvoje fotografije ostaju na iPhoneu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam trova video grandi, screenshot e duplicati così puoi scegliere cosa eliminare. Le tue foto restano sul tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloamは大きなビデオ、スクリーンショット、重複を見つけ、削除するものを選べるようにします。写真はiPhoneに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam이 용량이 큰 비디오, 스크린샷, 중복 항목을 찾아 삭제할 항목을 선택할 수 있게 합니다. 사진은 iPhone에 그대로 남습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam atrod lielus video, ekrānuzņēmumus un dublikātus, lai varētu izvēlēties, ko dzēst. Tavi foto paliek tavā iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam znajduje duże filmy, zrzuty ekranu i duplikaty, aby można było wybrać, co usunąć. Twoje zdjęcia zostają na iPhonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Artifloam encontra vídeos grandes, capturas de ecrã e duplicados para que escolha o que eliminar. As suas fotos ficam no iPhone."
