  "strings" : {
    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر Artifloam على جهات الاتصال المكررة لتختار أيها تدمج. تبقى جهات اتصالك على الـ iPhone."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam troba contactes duplicats perquè triïs quins combinar. Els teus contactes es queden a l’iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam findet doppelte Kontakte, damit du wählen kannst, welche du zusammenführst. Deine Kontakte bleiben auf deinem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds duplicate contacts so you can choose which to merge. Your contacts stay on your iPhone."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam finds duplicate contacts so you can choose which to merge. Your contacts stay on your iPhone."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
