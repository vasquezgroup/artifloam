    "Remove downloads there too if you need more room." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزل التنزيلات هناك أيضًا إذا احتجت إلى مساحة أكبر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esborra també les baixades d’allà si necessites més espai."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne dort auch Downloads, wenn du mehr Platz brauchst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove downloads there too if you need more room."
