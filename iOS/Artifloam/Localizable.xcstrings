    "Battery wear, cycle counts and available iOS updates aren't shared with apps. You'll find them in Settings, Battery and Settings, General, Software Update." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتم مشاركة تآكل البطارية وعدد دورات الشحن وتحديثات iOS المتاحة مع التطبيقات. ستجدها في الإعدادات، البطارية وفي الإعدادات، عام، تحديث البرنامج."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desgast de la bateria, els cicles de càrrega i les actualitzacions d’iOS disponibles no es comparteixen amb les apps. Els trobaràs a Ajustos, Bateria i Ajustos, General, Actualització de programari."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriezustand, Ladezyklen und verfügbare iOS-Updates werden nicht mit Apps geteilt. Du findest sie unter Einstellungen, Batterie und Einstellungen, Allgemein, Softwareupdate."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery wear, cycle counts and available iOS updates aren't shared with apps. You'll find them in Settings, Battery and Settings, General, Software Update."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery wear, cycle counts and available iOS updates aren't shared with apps. You'll find them in Settings, Battery and Settings, General, Software Update."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery wear, cycle counts and available iOS updates aren't shared with apps. You'll find them in Settings, Battery and Settings, General, Software Update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desgaste de la batería, el número de ciclos y las actualizaciones de iOS disponibles no se comparten con las apps. Puedes encontrarlos en Ajustes, Batería y en Ajustes, General, Actualización de software."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desgaste de la batería, el número de ciclos y las actualizaciones de iOS disponibles no se comparten con las apps. Puedes encontrarlos en Configuración, Batería y en Configuración, General, Actualización de Software."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’usure de la batterie, le nombre de cycles et les mises à jour iOS disponibles ne sont pas partagés avec les apps. Vous les trouverez dans Réglages, Batterie et Réglages, Général, Mise à jour logicielle."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriezuestand, Ladezyklen und verfügbari iOS-Updates werded nöd mit Apps teilt. Du findisch si under Einstellungen, Batterie und Einstellungen, Allgemein, Softwareupdate."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैटरी की घिसावट, साइकल की संख्या और उपलब्ध iOS अपडेट ऐप के साथ साझा नहीं होते। वे आपको सेटिंग, बैटरी और सेटिंग, सामान्य, सॉफ़्टवेयर अपडेट में मिलेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istrošenost baterije, broj ciklusa i dostupna iOS ažuriranja nisu dostupni aplikacijama. Pronaći ćeš ih u Postavke, Baterija i Postavke, Općenito, Ažuriranje softvera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usura della batteria, conteggio dei cicli e aggiornamenti iOS disponibili non sono condivisi con le app. Li trovi in Impostazioni, Batteria e Impostazioni, Generali, Aggiornamento software."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーの劣化、充放電回数、利用可能なiOSアップデートはアプリには共有されません。設定、バッテリー、または設定、一般、ソフトウェアアップデートで確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리 마모, 충전 횟수, 사용 가능한 iOS 업데이트는 앱과 공유되지 않습니다. 설정, 배터리 및 설정, 일반, 소프트웨어 업데이트에서 확인할 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akumulatora nolietojums, ciklu skaits un pieejamie iOS atjauninājumi lietotnēm netiek rādīti. Tos atradīsi sadaļā Iestatījumi, Akumulators un Iestatījumi, Vispārīgi, Programmatūras atjaunināšana."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zużycie baterii, liczba cykli i dostępne uaktualnienia iOS nie są udostępniane aplikacjom. Znajdziesz je w Ustawienia, Bateria oraz w Ustawienia, Ogólne, Uaktualnienie oprogramowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desgaste da bateria, a contagem de ciclos e as atualizações do iOS disponíveis não são partilhados com as apps. Pode encontrá-los em Definições, Bateria e em Definições, Geral, Atualização de Software."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsumimi i baterisë, numri i cikleve dhe përditësimet e disponueshme të iOS nuk ndahen me aplikacionet. Do t'i gjesh te Cilësimet, Bateria dhe Cilësimet, Të përgjithshme, Përditësimi i softuerit."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истрошеност батерије, број циклуса и доступна iOS ажурирања нису доступни апликацијама. Можете их наћи у Подешавања, Батерија и Подешавања, Опште, Ажурирање софтвера."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istrošenost baterije, broj ciklusa i dostupna iOS ažuriranja nisu dostupni aplikacijama. Možete ih naći u Podešavanja, Baterija i Podešavanja, Opšte, Ažuriranje softvera."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterislitage, laddningscykler och tillgängliga iOS-uppdateringar delas inte med appar. Du hittar dem under Inställningar, Batteri och Inställningar, Allmänt, Programuppdatering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pil aşınması, döngü sayıları ve mevcut iOS güncellemeleri uygulamalarla paylaşılmaz. Bunları Ayarlar, Pil ve Ayarlar, Genel, Yazılım Güncelleme bölümlerinde bulabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池损耗、循环次数和可用的 iOS 更新不会与 App 共享。你可以在“设置”、“电池”以及“设置”、“通用”、“软件更新”中查看。"
          }
        }
      }
    },
    "Big memories, smaller files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذكريات كبيرة، وملفات أصغر."
          }
