    "This is managed by iOS and can't be removed by you or any app. iOS frees part of it when space runs low." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُدار هذا بواسطة iOS ولا يمكنك أو أي تطبيق إزالته. يحرّر iOS جزءًا منه عندما تقل المساحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho gestiona l’iOS i no ho pot eliminar ni tu ni cap app. L’iOS n’allibera una part quan queda poc espai."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das verwaltet iOS, weder du noch eine App kann es entfernen. iOS gibt einen Teil frei, wenn der Platz knapp wird."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is managed by iOS and can't be removed by you or any app. iOS frees part of it when space runs low."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is managed by iOS and can't be removed by you or any app. iOS frees part of it when space runs low."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is managed by iOS and can't be removed by you or any app. iOS frees part of it when space runs low."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto lo gestiona iOS y no lo puedes quitar ni tú ni ninguna app. iOS libera una parte cuando queda poco espacio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto lo gestiona iOS y no lo puedes quitar ni tú ni ninguna app. iOS libera una parte cuando queda poco espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Géré par iOS, cet espace ne peut être retiré ni par vous ni par une app. iOS en libère une partie quand l’espace manque."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das verwaltet iOS, weder du na e App chan das entferne. iOS git en Teil frei, wenn de Platz knapp wird."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे iOS प्रबंधित करता है और आप या कोई ऐप इसे हटा नहीं सकता। जगह कम होने पर iOS इसका कुछ हिस्सा खाली करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovime upravlja iOS i ne možeš to ukloniti ti niti bilo koja aplikacija. iOS oslobađa dio kad ponestane prostora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È gestito da iOS e non può essere rimosso né da te né da un'app. iOS ne libera una parte quando lo spazio sta finendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはiOSが管理しており、ユーザやアプリでは削除できません。空きが少なくなると、iOSが一部を解放します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 관리하는 항목이므로 사용자나 어떤 앱도 제거할 수 없습니다. 공간이 부족해지면 iOS가 일부를 확보합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To pārvalda iOS, un ne tu, ne kāda lietotne to nevar noņemt. iOS atbrīvo daļu no tā, kad vietas kļūst maz."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tym zarządza iOS i nie możesz tego usunąć ani Ty, ani żadna aplikacja. iOS zwalnia część, gdy brakuje miejsca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é gerido pelo iOS e não pode ser removido por si nem por nenhuma app. O iOS liberta uma parte quando o espaço escasseia."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo menaxhohet nga iOS dhe nuk mund të hiqet nga ti ose ndonjë aplikacion. iOS çliron një pjesë të saj kur hapësira pakësohet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овим управља iOS и не можете то уклонити ни ви ни било која апликација. iOS ослобађа део када понестане простора."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovim upravlja iOS i ne možete to ukloniti ni vi ni bilo koja aplikacija. iOS oslobađa deo kada ponestane prostora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta hanteras av iOS och kan inte tas bort av dig eller någon app. iOS frigör en del av det när utrymmet börjar ta slut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, iOS tarafından yönetilir ve sizin ya da herhangi bir uygulama tarafından kaldırılamaz. Alan azaldığında iOS bir kısmını boşaltır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项由 iOS 管理，你和任何 App 都无法删除。空间不足时，iOS 会释放其中一部分。"
          }
        }
      }
    },
