          }
        }
      }
    },
    "In Settings, General, iPhone Storage, open the app. Offload App frees only the app's size and keeps its data. Delete App removes both." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الإعدادات، عام، مساحة تخزين iPhone، افتح التطبيق. «إلغاء تحميل التطبيق» يحرّر حجم التطبيق فقط ويُبقي بياناته. «حذف التطبيق» يزيل الاثنين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Ajustos, General, Emmagatzematge de l’iPhone, obre l’app. Descarrega l’app només allibera la mida de l’app i en conserva les dades. Esborra l’app elimina totes dues coses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die App unter Einstellungen, Allgemein, iPhone-Speicher. „App auslagern“ schafft nur Platz in Höhe der App-Größe und behält die Daten. „App löschen“ entfernt beides."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Settings, General, iPhone Storage, open the app. Offload App frees only the app's size and keeps its data. Delete App removes both."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Settings, General, iPhone Storage, open the app. Offload App frees only the app's size and keeps its data. Delete App removes both."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Settings, General, iPhone Storage, open the app. Offload App frees only the app's size and keeps its data. Delete App removes both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes, General, Almacenamiento del iPhone, abre la app. Descargar app libera solo el tamaño de la app y conserva sus datos. Eliminar app quita ambos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Configuración, General, Almacenamiento del iPhone, abre la app. Descargar app libera solo el tamaño de la app y conserva sus datos. Eliminar app quita ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages, Général, Stockage de l’iPhone, ouvrez l’app. « Désinstaller l’app » ne libère que la taille de l’app et conserve ses données. « Supprimer l’app » retire les deux."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne d App under Einstellungen, Allgemein, iPhone-Speicher. «App auslagern» schafft nur Platz i de Grössi vo de App und behaltet d Date. «App löschen» entfernt beides."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग, सामान्य, iPhone स्टोरेज में ऐप खोलें। “ऐप ऑफ़लोड करें” सिर्फ़ ऐप का आकार खाली करता है और उसका डेटा रखता है। “ऐप डिलीट करें” दोनों हटा देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U Postavke, Općenito, Pohrana na iPhoneu otvori aplikaciju. Rasteri aplikaciju oslobađa samo veličinu aplikacije i zadržava njezine podatke. Izbriši aplikaciju uklanja oboje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Impostazioni, Generali, Spazio iPhone, apri l'app. Rimuovi app libera solo lo spazio dell'app e ne mantiene i dati. Elimina app rimuove entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定、一般、iPhoneストレージでアプリを開きます。「Appを取り除く」はアプリ本体の容量だけを空け、データは残します。「Appを削除」は両方を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정, 일반, iPhone 저장 공간에서 앱을 여세요. ‘앱 오프로드’는 앱 크기만큼만 공간을 확보하고 데이터는 유지합니다. ‘앱 삭제’는 둘 다 제거합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadaļā Iestatījumi, Vispārīgi, iPhone krātuve atver lietotni. Izlādēt lietotni atbrīvo tikai lietotnes izmēru un patur datus. Dzēst lietotni noņem abus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Ustawienia, Ogólne, Pamięć iPhone’a otwórz aplikację. Odciąż aplikację zwalnia tylko miejsce zajmowane przez aplikację i zachowuje jej dane. Usuń aplikację usuwa jedno i drugie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Definições, Geral, Armazenamento do iPhone, abra a app. Descarregar App liberta apenas o tamanho da app e mantém os dados. Eliminar App remove ambos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te Cilësimet, Të përgjithshme, Ruajtja e iPhone, hap aplikacionin. Çngarko aplikacionin çliron vetëm madhësinë e aplikacionit dhe i mban të dhënat. Fshi aplikacionin heq të dyja."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Подешавања, Опште, Складиште iPhone-а отворите апликацију. Растери апликацију ослобађа само величину апликације и задржава њене податке. Обриши апликацију уклања обоје."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U Podešavanja, Opšte, Skladište iPhone-a otvorite aplikaciju. Rasteri aplikaciju oslobađa samo veličinu aplikacije i zadržava njene podatke. Obriši aplikaciju uklanja oboje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna appen under Inställningar, Allmänt, iPhone-lagring. Avlasta app frigör bara appens storlek och behåller dess data. Radera app tar bort båda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar, Genel, iPhone Depolama Alanı’nda uygulamayı açın. Uygulamayı Boşalt yalnızca uygulamanın boyutunu açar ve verilerini korur. Uygulamayı Sil ikisini de kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”、“通用”、“iPhone 储存空间”中打开该 App。“卸载 App”只释放 App 本身的大小并保留数据。“删除 App”则两者都会移除。"
          }
        }
      }
    },
