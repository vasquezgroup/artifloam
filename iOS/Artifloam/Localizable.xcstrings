    "Offload App keeps this data, so it won't shrink it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«إلغاء تحميل التطبيق» يُبقي هذه البيانات، لذا لن يقلّص حجمها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarrega l’app conserva aquestes dades, així que no les reduirà."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„App auslagern“ behält diese Daten und verkleinert sie daher nicht."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offload App keeps this data, so it won't shrink it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offload App keeps this data, so it won't shrink it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offload App keeps this data, so it won't shrink it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargar app conserva estos datos, así que no los reducirá."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargar app conserva estos datos, así que no los reducirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Désinstaller l’app » conserve ces données, elles ne diminueront donc pas."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«App auslagern» behaltet die Date und macht si drum nöd chliner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ऐप ऑफ़लोड करें” इस डेटा को रखता है, इसलिए यह घटेगा नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasteri aplikaciju zadržava ove podatke, pa ih neće smanjiti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi app mantiene questi dati, quindi non li riduce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Appを取り除く」ではこのデータは残るため、小さくなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘앱 오프로드’는 이 데이터를 유지하므로 크기가 줄지 않습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izlādēt lietotni patur šos datus, tāpēc tas tos nesamazinās."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Odciąż aplikację” zachowuje te dane, więc ich nie zmniejszy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarregar App mantém estes dados, por isso não os reduz."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çngarko aplikacionin i mban këto të dhëna, ndaj nuk i zvogëlon."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растери апликацију задржава ове податке, па их неће смањити."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasteri aplikaciju zadržava ove podatke, pa ih neće smanjiti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avlasta app behåller de här data, så de krymper inte."
