    "Take it out of the sun, stop heavy apps and let it cool down." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبعده عن الشمس، وأوقف التطبيقات الثقيلة، واتركه ليبرد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treu-lo del sol, tanca les apps pesades i deixa que es refredi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm es aus der Sonne, beende aufwendige Apps und lass es abkühlen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take it out of the sun, stop heavy apps and let it cool down."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take it out of the sun, stop heavy apps and let it cool down."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take it out of the sun, stop heavy apps and let it cool down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sácalo del sol, cierra las apps pesadas y deja que se enfríe."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sácalo del sol, cierra las apps pesadas y deja que se enfríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortez-le du soleil, arrêtez les apps gourmandes et laissez-le refroidir."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm en us de Sunne, beende aaspruchsvolli Apps und lass en abchühle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसे धूप से हटाएँ, भारी ऐप बंद करें और ठंडा होने दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makni ga sa sunca, zaustavi zahtjevne aplikacije i pusti da se ohladi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toglilo dal sole, chiudi le app pesanti e lascialo raffreddare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日なたから移し、負荷の高いアプリを終了して、冷ましてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햇빛을 피하고 무거운 앱을 종료한 다음 식히세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iznes to no saules, aptur prasīgas lietotnes un ļauj atdzist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabierz go ze słońca, zamknij wymagające aplikacje i pozwól mu ostygnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire-o do sol, pare as apps pesadas e deixe-o arrefecer."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largoje nga dielli, ndalo aplikacionet e rënda dhe lëre të ftohet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Склоните га са сунца, зауставите захтевне апликације и пустите да се охлади."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sklonite ga sa sunca, zaustavite zahtevne aplikacije i pustite da se ohladi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort den från solen, stoppa krävande appar och låt den svalna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güneşten uzaklaştırın, ağır uygulamaları durdurun ve soğumasını bekleyin."
