    "Avoid Clear chat if you only want to free space. It removes the messages too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجنّب «مسح المحادثة» إذا أردت تحرير المساحة فقط. فهو يزيل الرسائل أيضًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita Buida el xat si només vols alliberar espai. També elimina els missatges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle nicht „Chat leeren“, wenn du nur Platz schaffen willst. Das entfernt auch die Nachrichten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid Clear chat if you only want to free space. It removes the messages too."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid Clear chat if you only want to free space. It removes the messages too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid Clear chat if you only want to free space. It removes the messages too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita Vaciar chat si solo quieres liberar espacio. También elimina los mensajes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita Vaciar chat si solo quieres liberar espacio. También elimina los mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez « Effacer la discussion » si vous voulez seulement libérer de l’espace. Cela supprime aussi les messages."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl nöd «Chat leeren», wenn du nur Platz wotsch schaffe. Das entfernt au d Nachrichte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप सिर्फ़ जगह खाली करना चाहते हैं तो “चैट साफ़ करें” से बचें। यह संदेश भी हटा देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbjegavaj Očisti chat ako želiš samo osloboditi prostor. Uklanja i poruke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita Svuota chat se vuoi solo liberare spazio. Elimina anche i messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量を空けるだけなら「チャットを消去」は避けてください。メッセージも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간만 확보하려면 ‘채팅 지우기’는 사용하지 마세요. 메시지도 함께 삭제됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvairies no Notīrīt čatu, ja gribi tikai atbrīvot vietu. Tas noņem arī ziņojumus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj opcji Wyczyść czat, jeśli chcesz tylko zwolnić miejsce. Usuwa też wiadomości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite Limpar conversa se só quer libertar espaço. Também remove as mensagens."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shmang Pastro bisedën nëse do vetëm të çlirosh hapësirë. Ajo heq edhe mesazhet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избегавајте Обриши ћаскање ако само желите да ослободите простор. Уклања и поруке."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbegavajte Obriši ćaskanje ako samo želite da oslobodite prostor. Uklanja i poruke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvik Töm chatt om du bara vill frigöra utrymme. Det tar bort meddelandena också."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca yer açmak istiyorsanız Sohbeti temizle’yi kullanmayın. Mesajları da kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果只想释放空间，请不要使用“清空聊天”。它也会删除信息。"
          }
        }
      }
    },
