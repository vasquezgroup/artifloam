    "Run a scan to see what can go. Under 10% free, iOS may slow down and updates can fail." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل فحصًا لترى ما يمكن إزالته. عندما تقل المساحة المتاحة عن 10%، قد يبطؤ iOS وقد تفشل التحديثات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes una anàlisi per veure què es pot esborrar. Amb menys del 10% lliure, l’iOS pot anar més lent i les actualitzacions poden fallar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte einen Scan, um zu sehen, was weg kann. Bei unter 10 % frei kann iOS langsamer werden und Updates können fehlschlagen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run a scan to see what can go. Under 10% free, iOS may slow down and updates can fail."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run a scan to see what can go. Under 10% free, iOS may slow down and updates can fail."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run a scan to see what can go. Under 10% free, iOS may slow down and updates can fail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un análisis para ver qué se puede borrar. Con menos del 10 % libre, iOS puede ir más lento y las actualizaciones pueden fallar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un análisis para ver qué se puede borrar. Con menos del 10 % libre, iOS puede ir más lento y las actualizaciones pueden fallar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez une analyse pour voir ce qui peut partir. Sous 10 % d’espace libre, iOS peut ralentir et les mises à jour peuvent échouer."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start en Scan, zum gseh, was cha gah. Bi under 10 % frei cha iOS langsamer werde und Updates chönd fehlschlah."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या हट सकता है, यह देखने के लिए स्कैन चलाएँ। 10% से कम खाली होने पर iOS धीमा हो सकता है और अपडेट विफल हो सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokreni skeniranje da vidiš što se može ukloniti. Uz manje od 10% slobodnog, iOS se može usporiti, a ažuriranja mogu ne uspjeti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui una scansione per vedere cosa si può eliminare. Con meno del 10% libero, iOS può rallentare e gli aggiornamenti possono non riuscire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンを実行して、削除できるものを確認しましょう。空きが10%未満になると、iOSの動作が遅くなったり、アップデートに失敗したりすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검사를 실행해 지울 수 있는 항목을 확인하세요. 여유 공간이 10% 미만이면 iOS가 느려지고 업데이트가 실패할 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veic skenēšanu, lai redzētu, ko var dzēst. Ja brīvs ir mazāk par 10%, iOS var darboties lēnāk un atjauninājumi var neizdoties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom skanowanie, aby zobaczyć, co można usunąć. Przy mniej niż 10% wolnego miejsca iOS może zwolnić, a uaktualnienia mogą się nie udać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma análise para ver o que pode ser eliminado. Com menos de 10% livre, o iOS pode ficar lento e as atualizações podem falhar."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bëj një skanim për të parë çfarë mund të hiqet. Nën 10% të lirë, iOS mund të ngadalësohet dhe përditësimet mund të dështojnë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покрените скенирање да видите шта може да се уклони. Са мање од 10% слободног, iOS може да успори, а ажурирања могу да не успеју."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrenite skeniranje da vidite šta može da se ukloni. Sa manje od 10% slobodnog, iOS može da uspori, a ažuriranja mogu da ne uspeju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör en skanning för att se vad som kan bort. Med under 10 % ledigt kan iOS bli långsammare och uppdateringar kan misslyckas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelerin silinebileceğini görmek için bir tarama çalıştırın. %10’un altında boş alanda iOS yavaşlayabilir ve güncellemeler başarısız olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行扫描，查看哪些内容可以删除。可用空间低于 10% 时，iOS 可能变慢，更新也可能失败。"
          }
        }
      }
    },
