    "Add the free space widget by holding your Home Screen, then tapping Edit and Add Widget." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أداة المساحة المتاحة بالضغط مطولًا على الشاشة الرئيسية، ثم اضغط على تحرير ثم إضافة أداة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix el widget d’espai lliure mantenint premuda la pantalla d’inici i tocant Edita i Afegeix un widget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge das Widget für freien Speicherplatz hinzu: Halte den Home-Bildschirm gedrückt und tippe auf „Bearbeiten“ und „Widget hinzufügen“."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the free space widget by holding your Home Screen, then tapping Edit and Add Widget."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the free space widget by holding your Home Screen, then tapping Edit and Add Widget."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the free space widget by holding your Home Screen, then tapping Edit and Add Widget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el widget de espacio libre manteniendo pulsada la pantalla de inicio y tocando Editar y Añadir widget."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega el widget de espacio libre manteniendo presionada la pantalla de inicio y tocando Editar y Agregar widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le widget d’espace disponible : maintenez le doigt sur l’écran d’accueil, touchez Modifier, puis Ajouter un widget."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füeg s Widget für freie Speicherplatz hinzu: Halt dä Home-Bildschirm gdrückt und tipp uf «Bearbeiten» und «Widget hinzufügen»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाली जगह वाला विजेट जोड़ने के लिए होम स्क्रीन को दबाकर रखें, फिर संपादित करें और विजेट जोड़ें पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj widget za slobodan prostor: dugo pritisni početni zaslon, zatim dodirni Uredi i Dodaj widget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il widget dello spazio libero tenendo premuta la schermata Home, poi tocca Modifica e Aggiungi widget."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き容量のウィジェットを追加するには、ホーム画面を長押しして、「編集」、「ウィジェットを追加」の順にタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면을 길게 누른 다음 편집과 위젯 추가를 탭하여 여유 공간 위젯을 추가하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievieno brīvās vietas logrīku: pieturi Sākuma ekrānu, pēc tam pieskaries Rediģēt un Pievienot logrīku."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj widżet wolnego miejsca: przytrzymaj ekran początkowy, a potem stuknij w Edytuj i Dodaj widżet."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o widget de espaço livre mantendo premido o ecrã principal, tocando em Editar e em Adicionar widget."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shto widget-in e hapësirës së lirë: mbaj shtypur Ekranin kryesor, pastaj trokit Ndrysho dhe Shto widget."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додајте виџет слободног простора тако што ћете држати почетни екран, па додирнути Уреди и Додај виџет."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte vidžet slobodnog prostora tako što ćete držati početni ekran, pa dodirnuti Uredi i Dodaj vidžet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till widgeten för ledigt utrymme genom att hålla ned på hemskärmen och sedan trycka på Redigera och Lägg till widget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş alan widget’ını eklemek için Ana Ekran’a basılı tutun, ardından Düzenle’ye ve Widget Ekle’ye dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按主屏幕，然后轻点“编辑”和“添加小组件”，即可添加可用空间小组件。"
          }
        }
      }
    },
