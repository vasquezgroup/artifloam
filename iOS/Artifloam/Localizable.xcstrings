    "iOS can clear about %@ by itself when it needs room." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ iOS مسح نحو %@ من تلقاء نفسه عندما يحتاج إلى مساحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iOS pot buidar uns %@ pel seu compte quan necessita espai."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kann etwa %@ von selbst leeren, wenn es Platz braucht."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS can clear about %@ by itself when it needs room."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS can clear about %@ by itself when it needs room."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS can clear about %@ by itself when it needs room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS puede borrar por sí solo unos %@ cuando necesita espacio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS puede borrar por sí solo unos %@ cuando necesita espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS peut vider environ %@ de lui-même quand il a besoin de place."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS cha öppe %@ vo sich uus leere, wenn es Platz bruucht."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जगह चाहिए होने पर iOS लगभग %@ अपने आप साफ़ कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS može sam očistiti oko %@ kad treba prostor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS può liberare circa %@ da solo quando serve spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量が必要になると、iOSが約%@を自動的に消去できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간이 필요하면 iOS가 약 %@를 자동으로 지울 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pats var notīrīt aptuveni %@, kad vajag vietu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS może sam wyczyścić około %@, gdy potrzebuje miejsca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pode limpar cerca de %@ sozinho quando precisa de espaço."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mund të pastrojë vetë rreth %@ kur i duhet hapësirë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS може сам да очисти око %@ када му треба простор."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS može sam da očisti oko %@ kada mu treba prostor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kan rensa cirka %@ av sig själv när det behöver plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS, yere ihtiyaç duyduğunda yaklaşık %@ kadarını kendiliğinden temizleyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要空间时，iOS 可以自行清除约 %@。"
          }
        }
      }
    },
