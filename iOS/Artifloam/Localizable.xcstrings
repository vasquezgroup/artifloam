          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es listet dini Chats nach Grössi uf. Öffne eine und wähl d Medie, wo du wotsch entferne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपकी चैट को आकार के अनुसार दिखाता है। कोई चैट खोलें, फिर वह मीडिया चुनें जिसे हटाना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
