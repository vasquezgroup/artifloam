          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita también las descargas de ahí si necesitas más espacio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita también las descargas de ahí si necesitas más espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez aussi les téléchargements si vous avez besoin de plus de place."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfern det au Downloads, wenn du meh Platz bruuchsch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा जगह चाहिए तो वहाँ के डाउनलोड भी हटाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukloni i ondje preuzimanja ako trebaš više prostora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi anche i download lì se ti serve più spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらに容量が必要な場合は、そこのダウンロードも削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간이 더 필요하면 그곳의 다운로드 항목도 삭제하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja vajag vairāk vietas, noņem arī tur esošās lejupielādes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń tam też pobrane, jeśli potrzebujesz więcej miejsca."
