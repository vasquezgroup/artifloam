    "Items can be in more than one group, so the total counts each once: %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يكون العنصر في أكثر من مجموعة، لذا يحتسب الإجمالي كل عنصر مرة واحدة: %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un element pot ser a més d’un grup, així que el total en compta cadascun una sola vegada: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte können in mehreren Gruppen sein, daher zählt die Summe jedes nur einmal: %@."
