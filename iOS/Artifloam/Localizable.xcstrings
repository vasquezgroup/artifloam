    "Cards with the same name and a shared phone number or email. Merging keeps the fullest card and adds everything the others have." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بطاقات بالاسم نفسه ورقم هاتف أو بريد إلكتروني مشترك. يُبقي الدمج البطاقة الأكثر اكتمالًا ويضيف إليها كل ما في البطاقات الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitxes amb el mateix nom i un número de telèfon o un correu en comú. En combinar-les es conserva la fitxa més completa i s’hi afegeix tot el que tenen les altres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten mit demselben Namen und gemeinsamer Telefonnummer oder E-Mail. Beim Zusammenführen bleibt die vollständigste Karte erhalten und alles, was die anderen haben, wird ergänzt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards with the same name and a shared phone number or email. Merging keeps the fullest card and adds everything the others have."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards with the same name and a shared phone number or email. Merging keeps the fullest card and adds everything the others have."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards with the same name and a shared phone number or email. Merging keeps the fullest card and adds everything the others have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjetas con el mismo nombre y un teléfono o correo en común. Al fusionar se conserva la tarjeta más completa y se añade todo lo que tienen las demás."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjetas con el mismo nombre y un teléfono o correo en común. Al fusionar se conserva la tarjeta más completa y se agrega todo lo que tienen las demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiches de même nom avec un numéro de téléphone ou un e-mail en commun. La fusion conserve la fiche la plus complète et y ajoute tout ce que contiennent les autres."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charte mit em gliiche Name und gmeinsamer Telefonnummere oder E-Mail. Bim Zämefüehre blibt di vollständigscht Charte und alles, was di andere händ, wird ergänzt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक जैसे नाम और साझा फ़ोन नंबर या ईमेल वाले कार्ड। मर्ज करने पर सबसे पूरा कार्ड रहता है और बाकियों की सारी जानकारी उसमें जुड़ जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartice s istim imenom te zajedničkim brojem telefona ili e-adresom. Spajanje zadržava najpotpuniju karticu i dodaje sve što imaju ostale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schede con lo stesso nome e un numero di telefono o un'e-mail in comune. L'unione mantiene la scheda più completa e aggiunge tutto ciò che hanno le altre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前が同じで、電話番号またはメールアドレスが共通のカードです。統合すると、最も情報の多いカードが残り、ほかのカードの内容が追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름이 같고 전화번호나 이메일이 겹치는 카드입니다. 병합하면 정보가 가장 많은 카드가 유지되고 나머지 카드의 내용이 추가됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartītes ar tādu pašu vārdu un kopīgu tālruņa numuru vai e-pastu. Apvienojot tiek paturēta pilnīgākā kartīte un pievienots viss, kas ir pārējās."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty o tej samej nazwie i wspólnym numerze telefonu lub adresie e-mail. Scalenie zachowuje najpełniejszą kartę i dodaje wszystko, co mają pozostałe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartões com o mesmo nome e um telefone ou email em comum. Unir mantém o cartão mais completo e acrescenta tudo o que os outros têm."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta me të njëjtin emër dhe numër telefoni ose email të përbashkët. Bashkimi mban kartën më të plotë dhe shton gjithçka që kanë të tjerat."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картице са истим именом и заједничким бројем телефона или адресом е-поште. Спајање задржава најпотпунију картицу и додаје све што имају остале."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartice sa istim imenom i zajedničkim brojem telefona ili adresom e-pošte. Spajanje zadržava najpotpuniju karticu i dodaje sve što imaju ostale."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kort med samma namn och ett gemensamt telefonnummer eller en gemensam e-postadress. Vid sammanslagning behålls det fullaste kortet och allt de andra har läggs till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı ada ve ortak bir telefon numarasına ya da e-postaya sahip kartlar. Birleştirme en dolu kartı korur ve diğerlerindeki her şeyi ekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姓名相同且电话号码或邮箱相同的名片。合并后会保留信息最完整的名片，并加入其他名片中的所有内容。"
          }
        }
      }
    },
