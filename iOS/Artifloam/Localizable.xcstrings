          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente espacio libre para hacerlo de forma segura. Se necesita aproximadamente el doble del tamaño del elemento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente espacio libre para hacerlo de forma segura. Se necesita aproximadamente el doble del tamaño del elemento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace libre est insuffisant pour le faire en toute sécurité. Il faut environ le double de la taille de l’élément."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es isch nöd gnueg freie Spicherplatz da, zum das sicher uszfüehre. Es bruucht öppe di doppleti Grössi vom Objekt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे सुरक्षित रूप से करने के लिए पर्याप्त खाली जगह नहीं है। इसके लिए आइटम के आकार से लगभग दोगुनी जगह चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema dovoljno slobodnog prostora za sigurno izvršavanje. Potrebno je otprilike dvostruko više od veličine stavke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’è abbastanza spazio libero per farlo in sicurezza. Serve circa il doppio delle dimensioni dell’elemento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全に実行するための空き容量が足りません。項目のサイズの約2倍が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전하게 수행하기에 여유 공간이 부족합니다. 항목 크기의 약 두 배가 필요합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav pietiekami daudz brīvas vietas, lai to izdarītu droši. Nepieciešams aptuveni divreiz vairāk, nekā aizņem vienums."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje wolnego miejsca, aby zrobić to bezpiecznie. Potrzeba około dwukrotności rozmiaru elementu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há espaço livre suficiente para o fazer em segurança. É necessário cerca do dobro do tamanho do item."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk ka hapësirë të lirë të mjaftueshme për ta bërë këtë me siguri. Duhet afërsisht dyfishi i madhësisë së artikullit."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нема довољно слободног простора да се ово уради безбедно. Потребно је отприлике двоструко више од величине ставке."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema dovoljno slobodnog prostora da se ovo uradi bezbedno. Potrebno je otprilike dvostruko više od veličine stavke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inte tillräckligt med ledigt utrymme för att göra detta säkert. Det behövs ungefär dubbelt så mycket som objektets storlek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu güvenle yapmak için yeterli boş alan yok. Öğenin boyutunun yaklaşık iki katı gerekiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间不足，无法安全地执行此操作。大约需要项目大小两倍的空间。"
          }
        }
      }
    },
