    "The compressed copy didn't match the original." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخة المضغوطة لم تطابق الأصل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La còpia comprimida no coincidia amb l’original."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die komprimierte Kopie stimmte nicht mit dem Original überein."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The compressed copy didn't match the original."
          }
        },
        "en-CA" : {
