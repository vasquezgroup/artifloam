    "Choose a folder, like On My iPhone or iCloud Drive. Apps that share files there have their own folder. Most apps don't, and iOS keeps those private." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مجلدًا، مثل «على iPhone» أو iCloud Drive. للتطبيقات التي تشارك ملفات هناك مجلدها الخاص. معظم التطبيقات لا تفعل ذلك، ويُبقي iOS ملفاتها خاصة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria una carpeta, com ara Al meu iPhone o iCloud Drive. Les apps que hi comparteixen arxius tenen una carpeta pròpia. La majoria no, i l’iOS les manté privades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner, etwa „Auf meinem iPhone“ oder iCloud Drive. Apps, die dort Dateien teilen, haben einen eigenen Ordner. Die meisten Apps nicht, und iOS hält diese privat."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a folder, like On My iPhone or iCloud Drive. Apps that share files there have their own folder. Most apps don't, and iOS keeps those private."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a folder, like On My iPhone or iCloud Drive. Apps that share files there have their own folder. Most apps don't, and iOS keeps those private."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a folder, like On My iPhone or iCloud Drive. Apps that share files there have their own folder. Most apps don't, and iOS keeps those private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una carpeta, como En mi iPhone o iCloud Drive. Las apps que comparten archivos ahí tienen su propia carpeta. La mayoría no, y iOS las mantiene privadas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una carpeta, como En mi iPhone o iCloud Drive. Las apps que comparten archivos ahí tienen su propia carpeta. La mayoría no, y iOS las mantiene privadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier, comme Sur mon iPhone ou iCloud Drive. Les apps qui partagent des fichiers à cet endroit ont leur propre dossier. La plupart ne le font pas, et iOS garde ces données privées."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl en Ordner, zum Bispiel «Auf meinem iPhone» oder iCloud Drive. Apps, wo det Dateie teiled, händ en eigete Ordner. Di meiste Apps nöd, und iOS haltet die privat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई फ़ोल्डर चुनें, जैसे “मेरे iPhone पर” या iCloud Drive। वहाँ फ़ाइलें साझा करने वाले ऐप का अपना फ़ोल्डर होता है। ज़्यादातर ऐप में नहीं होता, और iOS उन्हें निजी रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberi mapu, poput Na mom iPhoneu ili iCloud Drive. Aplikacije koje tamo dijele datoteke imaju vlastitu mapu. Većina aplikacija nema, a iOS ih čuva privatnima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una cartella, come Su iPhone o iCloud Drive. Le app che condividono file lì hanno una cartella propria. La maggior parte no, e iOS le tiene private."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このiPhone内」やiCloud Driveなどのフォルダを選択してください。そこでファイルを共有するアプリには、専用のフォルダがあります。ほとんどのアプリにはなく、iOSが非公開にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나의 iPhone 또는 iCloud Drive 같은 폴더를 선택하세요. 그곳에서 파일을 공유하는 앱에는 자체 폴더가 있습니다. 대부분의 앱에는 없으며, iOS가 비공개로 유지합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvēlies mapi, piemēram, Šajā iPhone vai iCloud Drive. Lietotnēm, kas tur koplieto failus, ir sava mape. Lielākajai daļai lietotņu tādas nav, un iOS tās glabā privāti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz folder, np. Na moim iPhonie lub iCloud Drive. Aplikacje, które tam udostępniają pliki, mają własny folder. Większość aplikacji tego nie robi, a iOS zachowuje ich dane jako prywatne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma pasta, como No meu iPhone ou iCloud Drive. As apps que partilham ficheiros aí têm a sua própria pasta. A maioria não tem, e o iOS mantém-nas privadas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgjidh një dosje, si Në iPhone tim ose iCloud Drive. Aplikacionet që ndajnë skedarë aty kanë dosjen e tyre. Shumica nuk e kanë, dhe iOS i mban ato private."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изаберите фасциклу, као На мом iPhone-у или iCloud Дриве. Апликације које тамо деле фајлове имају сопствену фасциклу. Већина апликација нема, а iOS их чува приватним."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izaberite fasciklu, kao Na mom iPhone-u ili iCloud Drive. Aplikacije koje tamo dele fajlove imaju sopstvenu fasciklu. Većina aplikacija nema, a iOS ih čuva privatnim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en mapp, som På min iPhone eller iCloud Drive. Appar som delar filer där har en egen mapp. De flesta appar gör inte det, och iOS håller dem privata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’umda veya iCloud Drive gibi bir klasör seçin. Dosyaları orada paylaşan uygulamaların kendi klasörü vardır. Çoğunda yoktur ve iOS bunları gizli tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取一个文件夹，例如“我的 iPhone”或“iCloud 云盘”。在那里共享文件的 App 有各自的文件夹。大多数 App 没有，iOS 会将其保密。"
          }
        }
      }
    },
