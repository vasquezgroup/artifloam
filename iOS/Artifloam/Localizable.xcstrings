    "Shots taken moments apart that look alike. The sharpest one stays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقطات التُقطت بفارق لحظات وتبدو متشابهة. تبقى الأوضح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos fetes amb pocs instants de diferència que s’assemblen. Es conserva la més nítida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen, die kurz nacheinander entstanden und sich ähneln. Die schärfste bleibt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shots taken moments apart that look alike. The sharpest one stays."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shots taken moments apart that look alike. The sharpest one stays."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shots taken moments apart that look alike. The sharpest one stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos hechas con segundos de diferencia que se parecen. Se conserva la más nítida."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos hechas con segundos de diferencia que se parecen. Se conserva la más nítida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prises de vue à quelques instants d’intervalle qui se ressemblent. La plus nette est conservée."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufnahme, wo churz nacheinand gmacht worde sind und sich ähnlich sind. D schärfscht blibt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ पलों के अंतर पर ली गई मिलती-जुलती तस्वीरें। सबसे साफ़ वाली रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snimke nastale u razmaku od nekoliko trenutaka koje izgledaju slično. Najoštrija ostaje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatti fatti a pochi istanti di distanza e molto simili. Resta il più nitido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほぼ同時に撮影された、よく似た写真です。いちばん鮮明なものが残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 초 간격으로 찍은 비슷한 사진입니다. 가장 선명한 사진이 유지됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadri, kas uzņemti ar īsu starpību un izskatās līdzīgi. Asākais paliek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujęcia zrobione w odstępie chwil, które wyglądają podobnie. Najostrzejsze zostaje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos tiradas com poucos instantes de intervalo e parecidas. A mais nítida fica."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamje të bëra me pak sekonda diferencë që duken njësoj. Më e mprehta mbetet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимци настали у размаку од неколико тренутака који изгледају слично. Најоштрији остаје."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snimci nastali u razmaku od nekoliko trenutaka koji izgledaju slično. Najoštriji ostaje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder som tagits med några ögonblicks mellanrum och ser likadana ut. Den skarpaste behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç an arayla çekilmiş, benzer görünen kareler. En net olan kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "间隔很短、看起来相似的照片。会保留最清晰的一张。"
          }
        }
      }
    },
