    "Without a passcode, anyone holding this iPhone can open it, and its data isn't protected. Turn it on in Settings, Face ID & Passcode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون رمز دخول، يمكن لأي شخص يحمل هذا الـ iPhone فتحه، وبياناته غير محمية. فعّله من الإعدادات، Face ID ورمز الدخول."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense codi, qualsevol persona que tingui aquest iPhone el pot obrir, i les dades no estan protegides. Activa’l a Ajustos, Face ID i codi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Code kann jeder, der dieses iPhone in der Hand hält, es öffnen, und seine Daten sind nicht geschützt. Aktiviere ihn unter Einstellungen, Face ID & Code."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a passcode, anyone holding this iPhone can open it, and its data isn't protected. Turn it on in Settings, Face ID & Passcode."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a passcode, anyone holding this iPhone can open it, and its data isn't protected. Turn it on in Settings, Face ID & Passcode."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a passcode, anyone holding this iPhone can open it, and its data isn't protected. Turn it on in Settings, Face ID & Passcode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin código, cualquiera que tenga este iPhone puede abrirlo y sus datos no están protegidos. Actívalo en Ajustes, Face ID y código."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin código, cualquiera que tenga este iPhone puede abrirlo y sus datos no están protegidos. Actívalo en Configuración, Face ID y código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans code, quiconque tient cet iPhone peut l’ouvrir, et ses données ne sont pas protégées. Activez-en un dans Réglages, Face ID et code."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohni Code cha jede, wo dä iPhone i de Hand het, en öffne, und sini Date sind nöd gschützt. Aktivier en under Einstellungen, Face ID & Code."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासकोड के बिना, इस iPhone को पकड़ने वाला कोई भी इसे खोल सकता है, और इसका डेटा सुरक्षित नहीं है। इसे सेटिंग, Face ID और पासकोड में चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez šifre svatko tko drži ovaj iPhone može ga otvoriti, a njegovi podaci nisu zaštićeni. Uključi je u Postavke, Face ID i šifra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un codice, chiunque abbia in mano questo iPhone può aprirlo e i suoi dati non sono protetti. Attivalo in Impostazioni, Face ID e codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスコードがないと、このiPhoneを持っている人は誰でも開くことができ、データは保護されません。設定、Face IDとパスコードでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호가 없으면 이 iPhone을 가진 누구나 열 수 있고 데이터도 보호되지 않습니다. 설정, Face ID 및 암호에서 켜세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez piekļuves koda ikviens, kam ir šis iPhone, var to atvērt, un tā dati nav aizsargāti. Ieslēdz to sadaļā Iestatījumi, Face ID un piekļuves kods."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez kodu każdy, kto trzyma ten iPhone, może go otworzyć, a jego dane nie są chronione. Włącz go w Ustawienia, Face ID i kod."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem código, qualquer pessoa com este iPhone pode abri-lo e os dados não estão protegidos. Ative-o em Definições, Face ID e Código."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa kod kalimi, çdokush që mban këtë iPhone mund ta hapë, dhe të dhënat e tij nuk janë të mbrojtura. Aktivizoje te Cilësimet, Face ID dhe kodi i kalimit."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без шифре свако ко држи овај iPhone може да га отвори, а његови подаци нису заштићени. Укључите је у Подешавања, Face ID и шифра."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez šifre svako ko drži ovaj iPhone može da ga otvori, a njegovi podaci nisu zaštićeni. Uključite je u Podešavanja, Face ID i šifra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan lösenkod kan vem som helst som håller i den här iPhonen öppna den, och dess data är inte skyddad. Slå på den under Inställningar, Face ID och lösenkod."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola olmadan bu iPhone’u elinde tutan herkes onu açabilir ve verileri korunmaz. Ayarlar, Face ID ve Parola bölümünden açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有密码，任何拿到这台 iPhone 的人都可以打开它，其中的数据也不受保护。请在“设置”、“面容 ID 与密码”中开启。"
          }
        }
      }
    },
