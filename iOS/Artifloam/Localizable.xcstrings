          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرر iOS وقت إجراء هذا الفحص، لذا قد يتأخر التذكير."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iOS decideix quan s’executa aquesta comprovació, així que un recordatori pot arribar tard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS entscheidet, wann diese Prüfung läuft, daher kann eine Erinnerung verspätet kommen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decides when this check runs, so a reminder can come late."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decides when this check runs, so a reminder can come late."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decides when this check runs, so a reminder can come late."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decide cuándo se hace esta comprobación, así que un aviso puede llegar tarde."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decide cuándo se hace esta comprobación, así que un aviso puede llegar tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS décide du moment de cette vérification ; un rappel peut donc arriver en retard."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS entscheidet, wänn die Prüefig laufft, drum cha e Erinnerig spöter cho."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह जाँच कब चलेगी, यह iOS तय करता है, इसलिए रिमाइंडर देर से आ सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS odlučuje kad se ova provjera pokreće, pa podsjetnik može kasniti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decide quando eseguire questo controllo, quindi un promemoria può arrivare in ritardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチェックが実行されるタイミングはiOSが決めるため、通知が遅れることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 확인이 실행되는 시점은 iOS가 결정하므로 알림이 늦게 올 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS izlemj, kad šī pārbaude tiek veikta, tāpēc atgādinājums var kavēties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS decyduje, kiedy ta kontrola się uruchamia, więc przypomnienie może przyjść z opóźnieniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS decide quando esta verificação é feita, por isso um lembrete pode chegar tarde."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vendos kur kryhet kjo kontrollë, ndaj një kujtesë mund të vonojë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS одлучује када се ова провера покреће, па подсетник може да касни."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS odlučuje kada se ova provera pokreće, pa podsetnik može da kasni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS bestämmer när den här kontrollen körs, så en påminnelse kan komma sent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu denetimin ne zaman çalışacağına iOS karar verir, bu yüzden hatırlatma geç gelebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此检查何时运行由 iOS 决定，因此提醒可能会延迟。"
          }
        }
      }
    },
    "iOS doesn't show other apps' sizes to an iPhone app. Connect this iPhone to Artifloam on your Mac to list every app, delete the ones you don't need, and see WhatsApp by person or group." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعرض iOS أحجام التطبيقات الأخرى لتطبيق على iPhone. وصّل هذا الـ iPhone بـ Artifloam على الـ Mac لعرض كل التطبيقات، وحذف ما لا تحتاج إليه، ورؤية WhatsApp حسب الشخص أو المجموعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iOS no mostra les mides de les altres apps a una app de l’iPhone. Connecta aquest iPhone a Artifloam al Mac per llistar totes les apps, esborrar les que no necessitis i veure WhatsApp per persona o grup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS zeigt einer iPhone-App die Größen anderer Apps nicht an. Verbinde dieses iPhone mit Artifloam auf deinem Mac, um alle Apps zu listen, nicht benötigte zu löschen und WhatsApp nach Person oder Gruppe zu sehen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't show other apps' sizes to an iPhone app. Connect this iPhone to Artifloam on your Mac to list every app, delete the ones you don't need, and see WhatsApp by person or group."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't show other apps' sizes to an iPhone app. Connect this iPhone to Artifloam on your Mac to list every app, delete the ones you don't need, and see WhatsApp by person or group."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't show other apps' sizes to an iPhone app. Connect this iPhone to Artifloam on your Mac to list every app, delete the ones you don't need, and see WhatsApp by person or group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no muestra los tamaños de otras apps a una app del iPhone. Conecta este iPhone a Artifloam en tu Mac para ver todas las apps, borrar las que no necesites y ver WhatsApp por persona o grupo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no muestra los tamaños de otras apps a una app del iPhone. Conecta este iPhone a Artifloam en tu Mac para ver todas las apps, borrar las que no necesites y ver WhatsApp por persona o grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS n’affiche pas la taille des autres apps à une app iPhone. Connectez cet iPhone à Artifloam sur votre Mac pour lister toutes les apps, supprimer celles dont vous n’avez pas besoin et voir WhatsApp par personne ou groupe."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS zeigt eire iPhone-App d Grössine vo andere Apps nöd aa. Verbind dä iPhone mit Artifloam uf dim Mac, zum alli Apps uflischte, nöd bruuchti lösche und WhatsApp nach Person oder Gruppe gseh."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS किसी iPhone ऐप को दूसरे ऐप के आकार नहीं दिखाता। हर ऐप देखने, जो ज़रूरी नहीं उन्हें डिलीट करने, और WhatsApp को व्यक्ति या समूह के अनुसार देखने के लिए इस iPhone को अपने Mac पर Artifloam से कनेक्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne prikazuje veličine drugih aplikacija aplikaciji na iPhoneu. Spoji ovaj iPhone s Artifloamom na Macu da navedeš svaku aplikaciju, izbrišeš one koje ne trebaš i vidiš WhatsApp po osobi ili grupi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non mostra le dimensioni delle altre app a un'app per iPhone. Collega questo iPhone ad Artifloam sul Mac per elencare ogni app, eliminare quelle che non ti servono e vedere WhatsApp per persona o gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSは、iPhoneアプリに他のアプリのサイズを見せません。このiPhoneをMacのArtifloamに接続すると、すべてのアプリの一覧表示、不要なアプリの削除、WhatsAppの個人別・グループ別の確認ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 iPhone 앱에 다른 앱의 크기를 알려 주지 않습니다. 이 iPhone을 Mac의 Artifloam에 연결하면 모든 앱을 나열하고, 필요 없는 앱을 삭제하고, WhatsApp을 개인별·그룹별로 확인할 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS neparāda citu lietotņu izmērus iPhone lietotnei. Pievieno šo iPhone Artifloam savā Mac datorā, lai uzskaitītu visas lietotnes, dzēstu nevajadzīgās un redzētu WhatsApp pēc personas vai grupas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nie pokazuje aplikacji na iPhonie rozmiarów innych aplikacji. Połącz ten iPhone z Artifloam na Macu, aby wyświetlić każdą aplikację, usunąć niepotrzebne i zobaczyć WhatsApp według osoby lub grupy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não mostra os tamanhos de outras apps a uma app do iPhone. Ligue este iPhone ao Artifloam no seu Mac para listar todas as apps, eliminar as que não precisa e ver o WhatsApp por pessoa ou grupo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nuk ia tregon madhësitë e aplikacioneve të tjera një aplikacioni iPhone. Lidhe këtë iPhone me Artifloam në Mac-un tënd për të listuar çdo aplikacion, për të fshirë ato që nuk të duhen dhe për të parë WhatsApp sipas personit ose grupit."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не приказује величине других апликација апликацији на iPhone-у. Повежите овај iPhone са Artifloam-ом на Mac-у да наведете сваку апликацију, обришете оне које не требате и видите WhatsApp по особи или групи."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne prikazuje veličine drugih aplikacija aplikaciji na iPhone-u. Povežite ovaj iPhone sa Artifloam-om na Mac-u da navedete svaku aplikaciju, obrišete one koje ne trebate i vidite WhatsApp po osobi ili grupi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS visar inte andra appars storlekar för en iPhone-app. Anslut den här iPhonen till Artifloam på din Mac för att lista alla appar, radera de du inte behöver och se WhatsApp per person eller grupp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS, diğer uygulamaların boyutlarını bir iPhone uygulamasına göstermez. Tüm uygulamaları listelemek, ihtiyacınız olmayanları silmek ve WhatsApp’ı kişi veya gruba göre görmek için bu iPhone’u Mac’inizdeki Artifloam’a bağlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 不会向 iPhone App 显示其他 App 的大小。将这台 iPhone 连接到 Mac 上的 Artifloam，即可列出所有 App、删除不需要的 App，并按个人或群组查看 WhatsApp。"
          }
        }
      }
    },
    "iOS may slow down to cool off. Give it a break from charging or heavy apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يبطؤ iOS ليبرد. امنحه استراحة من الشحن أو التطبيقات الثقيلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iOS pot anar més lent per refredar-se. Deixa’l descansar de la càrrega o de les apps pesades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS wird eventuell langsamer, um abzukühlen. Gönne ihm eine Pause vom Laden und von aufwendigen Apps."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS may slow down to cool off. Give it a break from charging or heavy apps."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS may slow down to cool off. Give it a break from charging or heavy apps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS may slow down to cool off. Give it a break from charging or heavy apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS puede ir más lento para enfriarse. Déjalo descansar de la carga o de apps pesadas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS puede ir más lento para enfriarse. Déjalo descansar de la carga o de apps pesadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS peut ralentir pour refroidir. Faites-lui faire une pause de charge ou d’apps gourmandes."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS wird allefalls langsamer, zum abchühle. Gönn em e Pause vom Lade und vo aaspruchsvolle Apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठंडा होने के लिए iOS धीमा हो सकता है। इसे चार्जिंग या भारी ऐप से आराम दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS se može usporiti da se ohladi. Daj mu odmor od punjenja i zahtjevnih aplikacija."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS può rallentare per raffreddarsi. Dagli una pausa dalla ricarica o dalle app pesanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSは冷却のために動作が遅くなることがあります。充電や負荷の高いアプリを休ませてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 열을 식히기 위해 느려질 수 있습니다. 충전이나 무거운 앱 사용을 잠시 멈추세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS var darboties lēnāk, lai atdzistu. Ļauj tam atpūsties no uzlādes vai prasīgām lietotnēm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS może zwolnić, aby ostygnąć. Daj mu odpocząć od ładowania i wymagających aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pode ficar mais lento para arrefecer. Dê-lhe uma pausa do carregamento ou de apps pesadas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mund të ngadalësohet për t'u ftohur. Jepi një pushim nga ngarkimi ose aplikacionet e rënda."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS може да успори да се охлади. Дајте му одмор од пуњења и захтевних апликација."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS može da uspori da se ohladi. Dajte mu odmor od punjenja i zahtevnih aplikacija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kan bli långsammare för att svalna. Ge den en paus från laddning och krävande appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS soğumak için yavaşlayabilir. Şarj etmeye veya ağır uygulamalara ara verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 可能会降低速度来散热。请暂停充电或使用占用资源多的 App。"
          }
        }
      }
    },
