            "value" : "Komprimirana kopija nije odgovarala izvorniku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia compressa non corrispondeva all'originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮したコピーが元のデータと一致しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축한 사본이 원본과 일치하지 않았습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saspiestā kopija neatbilda oriģinālam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skompresowana kopia nie zgadzała się z oryginałem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia comprimida não correspondia ao original."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopja e ngjeshur nuk përputhej me origjinalin."
