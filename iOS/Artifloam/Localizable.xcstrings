            "value" : "توجد نسخة احتياطية من البطاقات الأصلية على هذا الـ iPhone. للتراجع، افتحها وأعد إضافة البطاقات إلى جهات الاتصال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha una còpia de seguretat de les fitxes originals en aquest iPhone. Per desfer-ho, obre-la i torna a afegir les fitxes a Contactes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Backup der ursprünglichen Karten liegt auf diesem iPhone. Zum Widerrufen öffne es und füge die Karten wieder zu Kontakte hinzu."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup of the original cards is on this iPhone. To undo, open it and add the cards back to Contacts."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup of the original cards is on this iPhone. To undo, open it and add the cards back to Contacts."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup of the original cards is on this iPhone. To undo, open it and add the cards back to Contacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una copia de seguridad de las tarjetas originales en este iPhone. Para deshacerlo, ábrela y vuelve a añadir las tarjetas a Contactos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una copia de seguridad de las tarjetas originales en este iPhone. Para deshacerlo, ábrela y vuelve a agregar las tarjetas a Contactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde des fiches d’origine se trouve sur cet iPhone. Pour annuler, ouvrez-la et rajoutez les fiches dans Contacts."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es Backup vo de ursprüngliche Charte isch uf dem iPhone. Zum Rückgängig mache öffne es und füeg d Charte wieder id Kontakt ii."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूल कार्ड का बैकअप इस iPhone पर है। पहले जैसा करने के लिए उसे खोलें और कार्ड वापस संपर्क में जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosna kopija izvornih kartica nalazi se na ovom iPhoneu. Za poništavanje otvori je i vrati kartice u Kontakte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia delle schede originali è su questo iPhone. Per annullare, aprila e aggiungi di nuovo le schede in Contatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のカードのバックアップはこのiPhoneにあります。元に戻すには、バックアップを開いてカードを連絡先に戻してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 카드의 백업이 이 iPhone에 있습니다. 되돌리려면 백업을 열어 카드를 연락처에 다시 추가하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriģinālo kartīšu dublējums ir šajā iPhone. Lai atsauktu, atver to un pievieno kartītes atpakaļ lietotnē Kontakti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zapasowa oryginalnych kart jest na tym iPhonie. Aby cofnąć, otwórz ją i dodaj karty z powrotem do Kontaktów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está guardado neste iPhone um backup dos cartões originais. Para anular, abra-o e volte a adicionar os cartões aos Contactos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një kopje rezervë e kartave origjinale është në këtë iPhone. Për ta zhbërë, hape dhe shtoji kartat përsëri te Kontaktet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервна копија оригиналних картица налази се на овом iPhone-у. Да поништите, отворите је и вратите картице у Контакте."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezervna kopija originalnih kartica nalazi se na ovom iPhone-u. Da poništite, otvorite je i vratite kartice u Kontakte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En säkerhetskopia av de ursprungliga korten finns på den här iPhonen. Öppna den och lägg tillbaka korten i Kontakter för att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal kartların bir yedeği bu iPhone’da. Geri almak için yedeği açın ve kartları Kişiler’e geri ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始名片的备份在这台 iPhone 上。若要撤销，请打开备份，将名片重新添加到通讯录。"
          }
        }
      }
    },
