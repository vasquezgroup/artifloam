    "Check the app's own settings for downloads or a cache. Games often keep downloaded levels you can remove in the game." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع إعدادات التطبيق نفسه بحثًا عن التنزيلات أو الذاكرة المؤقتة. تحتفظ الألعاب غالبًا بمستويات منزّلة يمكنك إزالتها من داخل اللعبة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira a la configuració de l’app si hi ha baixades o una memòria cau. Els jocs sovint guarden nivells baixats que pots esborrar des del joc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh in den Einstellungen der App nach Downloads oder einem Cache. Spiele speichern oft heruntergeladene Level, die du im Spiel entfernen kannst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the app's own settings for downloads or a cache. Games often keep downloaded levels you can remove in the game."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the app's own settings for downloads or a cache. Games often keep downloaded levels you can remove in the game."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the app's own settings for downloads or a cache. Games often keep downloaded levels you can remove in the game."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira los ajustes de la propia app para ver descargas o caché. Los juegos suelen guardar niveles descargados que puedes quitar desde el juego."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la configuración de la propia app para ver descargas o caché. Los juegos suelen guardar niveles descargados que puedes quitar desde el juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez des téléchargements ou un cache dans les réglages de l’app. Les jeux conservent souvent des niveaux téléchargés que vous pouvez supprimer dans le jeu."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lueg i de Iistellige vo de App nach Downloads oder emene Cache. Spiel speicheret oft abeglade Level, wo du im Spiel chasch entferne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड या कैश के लिए ऐप की अपनी सेटिंग देखें। गेम अक्सर डाउनलोड किए हुए लेवल रखते हैं, जिन्हें आप गेम में हटा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjeri postavke same aplikacije za preuzimanja ili predmemoriju. Igre često čuvaju preuzete razine koje možeš ukloniti u igri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla nelle impostazioni dell'app se ci sono download o una cache. I giochi spesso conservano livelli scaricati che puoi eliminare dal gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ自体の設定で、ダウンロードやキャッシュを確認してください。ゲームでは、ダウンロード済みのレベルをゲーム内で削除できることがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 자체 설정에서 다운로드나 캐시를 확인하세요. 게임은 다운로드한 레벨을 게임 안에서 삭제할 수 있는 경우가 많습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbaudi lietotnes iestatījumos lejupielādes vai kešatmiņu. Spēlēs bieži ir lejupielādēti līmeņi, ko var noņemt pašā spēlē."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź ustawienia samej aplikacji pod kątem pobranych plików lub pamięci podręcznej. Gry często przechowują pobrane poziomy, które możesz usunąć w grze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja as definições da própria app para transferências ou cache. Os jogos costumam guardar níveis transferidos que pode remover no jogo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollo cilësimet e vetë aplikacionit për shkarkime ose cache. Lojërat shpesh mbajnë nivele të shkarkuara që mund t'i heqësh brenda lojës."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверите подешавања саме апликације за преузимања или кеш. Игре често чувају преузете нивое које можете уклонити у игри."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proverite podešavanja same aplikacije za preuzimanja ili keš. Igre često čuvaju preuzete nivoe koje možete ukloniti u igri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titta i appens egna inställningar efter nedladdningar eller cache. Spel sparar ofta nedladdade nivåer som du kan ta bort i spelet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilenler veya önbellek için uygulamanın kendi ayarlarına bakın. Oyunlar genellikle oyun içinden kaldırabileceğiniz indirilmiş seviyeleri tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 App 自身的设置中查看下载内容或缓存。游戏通常会保留已下载的关卡，你可以在游戏中删除。"
          }
        }
      }
    },
