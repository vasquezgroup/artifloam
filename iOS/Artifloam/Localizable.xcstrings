    "Sorted on this iPhone, from your newest %lld photos. Categories can be wrong, so look before deleting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الفرز على هذا الـ iPhone، من أحدث %lld صورة لديك. قد تكون الفئات خاطئة، لذا تحقق قبل الحذف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classificades en aquest iPhone, a partir de les teves %lld fotos més recents. Les categories poden ser incorrectes, així que mira-ho abans d’esborrar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem iPhone sortiert, aus deinen neuesten %lld Fotos. Kategorien können falsch sein, schau also vor dem Löschen nach."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorted on this iPhone, from your newest %lld photos. Categories can be wrong, so look before deleting."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorted on this iPhone, from your newest %lld photos. Categories can be wrong, so look before deleting."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorted on this iPhone, from your newest %lld photos. Categories can be wrong, so look before deleting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasificadas en este iPhone, a partir de tus %lld fotos más recientes. Las categorías pueden fallar, así que mira antes de borrar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasificadas en este iPhone, a partir de tus %lld fotos más recientes. Las categorías pueden fallar, así que revisa antes de borrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triées sur cet iPhone, parmi vos %lld photos les plus récentes. Les catégories peuvent être erronées ; vérifiez avant de supprimer."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uf dem iPhone sortiert, us dine neuschte %lld Foti. Kategorie chönd falsch si, lueg also vor em Lösche nach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर आपकी सबसे नई %lld फ़ोटो से छाँटा गया। श्रेणियाँ ग़लत हो सकती हैं, इसलिए डिलीट करने से पहले देख लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razvrstano na ovom iPhoneu, iz tvojih %lld najnovijih fotografija. Kategorije mogu biti pogrešne, pa pogledaj prije brisanja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinate su questo iPhone, tra le tue %lld foto più recenti. Le categorie possono essere sbagliate, quindi controlla prima di eliminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhone上で、最新の%lld枚の写真から分類しています。カテゴリが正しくない場合があるため、削除する前に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 최신 사진 %lld장을 기준으로 분류했습니다. 카테고리가 잘못될 수 있으니 삭제하기 전에 확인하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakārtots šajā iPhone no tavām jaunākajām %lld foto. Kategorijas var būt kļūdainas, tāpēc apskaties pirms dzēšanas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posortowano na tym iPhonie, spośród Twoich %lld najnowszych zdjęć. Kategorie mogą być błędne, więc sprawdź przed usunięciem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizadas neste iPhone, a partir das suas %lld fotos mais recentes. As categorias podem estar erradas, por isso veja antes de eliminar."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorizuar në këtë iPhone, nga %lld fotot e tua më të reja. Kategoritë mund të jenë gabim, ndaj shiko para se të fshish."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разврстано на овом iPhone-у, из ваших %lld најновијих фотографија. Категорије могу бити погрешне, па погледајте пре брисања."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razvrstano na ovom iPhone-u, iz vaših %lld najnovijih fotografija. Kategorije mogu biti pogrešne, pa pogledajte pre brisanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorterat på den här iPhonen, från dina %lld senaste foton. Kategorier kan vara fel, så titta efter innan du raderar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’da, en yeni %lld fotoğrafınızdan sıralandı. Kategoriler yanlış olabilir, bu yüzden silmeden önce bakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台 iPhone 上根据你最新的 %lld 张照片分类。类别可能不准确，删除前请先查看。"
          }
        }
      }
    },
