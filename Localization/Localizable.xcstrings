    "Find exact copies across your home folder by content. Keep one, move the rest to Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعثر على نسخ مطابقة تمامًا في مجلد المنزل حسب المحتوى. أبقِ واحدة، وانقل الباقي إلى سلة المهملات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troba còpies exactes a tota la carpeta d’inici segons el contingut. Conserva’n una i mou la resta a la paperera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde exakte Kopien in deinem Benutzerordner nach Inhalt. Behalte eine, lege den Rest in den Papierkorb."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find exact copies across your home folder by content. Keep one, move the rest to Bin."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
