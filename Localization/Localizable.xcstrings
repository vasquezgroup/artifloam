    "Cache its app rebuilds when needed. Settings, documents and sign-ins are elsewhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذاكرة مؤقتة يعيد تطبيقها بناءها عند الحاجة. الإعدادات والمستندات وعمليات تسجيل الدخول في مكان آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memòria cau que la seva app torna a crear quan cal. Els ajustos, els documents i els inicis de sessió són en un altre lloc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache, den die App bei Bedarf neu aufbaut. Einstellungen, Dokumente und Anmeldungen liegen woanders."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache its app rebuilds when needed. Settings, documents and sign-ins are elsewhere."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache its app rebuilds when needed. Settings, documents and sign-ins are elsewhere."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache its app rebuilds when needed. Settings, documents and sign-ins are elsewhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché que su app reconstruye cuando hace falta. Los ajustes, los documentos y los inicios de sesión están en otro sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché que su app reconstruye cuando hace falta. Los ajustes, los documentos y los inicios de sesión están en otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache que son app recrée en cas de besoin. Les réglages, les documents et les connexions sont ailleurs."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache, wo d App bi Bedarf sälber neu ufbout. Iistellige, Dokument und Aamäldige sind anderscht gspeicheret."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसा कैश जिसे ऐप ज़रूरत पड़ने पर दोबारा बना लेता है। सेटिंग, दस्तावेज़ और साइन-इन कहीं और होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predmemorija koju njezina aplikacija po potrebi ponovno gradi. Postavke, dokumenti i prijave nalaze se drugdje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache che la sua app ricostruisce quando serve. Impostazioni, documenti e accessi sono altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要に応じてアプリが再作成するキャッシュ。設定、書類、サインイン情報は別の場所にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 필요할 때 다시 만드는 캐시입니다. 설정, 문서, 로그인 정보는 다른 곳에 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kešatmiņa, ko lietotne izveido no jauna, kad vajag. Iestatījumi, dokumenti un pieteikšanās atrodas citur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć podręczna, którą jej aplikacja odbudowuje w razie potrzeby. Ustawienia, dokumenty i logowania są gdzie indziej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache que a sua app recria quando necessário. As definições, os documentos e as sessões iniciadas ficam noutro local."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache që aplikacioni i vet e rindërton kur ka nevojë. Cilësimet, dokumentet dhe hyrjet në llogari janë diku tjetër."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кеш који његова апликација поново прави када затреба. Подешавања, документи и пријаве су на другом месту."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keš koji njegova aplikacija ponovo pravi kada zatreba. Podešavanja, dokumenti i prijave su na drugom mestu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache som appen bygger upp igen vid behov. Inställningar, dokument och inloggningar finns på andra ställen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamasının gerektiğinde yeniden oluşturduğu önbellek. Ayarlar, belgeler ve oturum açmalar başka yerdedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其 App 会在需要时重新生成的缓存。设置、文稿和登录信息不在此处。"
          }
        }
      }
    },
