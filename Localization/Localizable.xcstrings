        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće pročitati %@: %@. Ako je potrebno, dozvolite pristup fascikli u macOS Privatnost i bezbednost."
          }
        },
        "sv" : {
          "stringUnit" : {
