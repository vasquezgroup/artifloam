    "Xcode can no longer run it. Removed by Xcode's own simctl." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد Xcode قادرًا على تشغيله. يزيله simctl الخاص بـ Xcode."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode ja no el pot executar. L’elimina el simctl propi de Xcode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode kann ihn nicht mehr ausführen. Wird durch Xcodes eigenes simctl entfernt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode can no longer run it. Removed by Xcode's own simctl."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode can no longer run it. Removed by Xcode's own simctl."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
