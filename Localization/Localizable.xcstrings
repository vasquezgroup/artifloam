        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dine Projekt. Nie für di aagchrüüzlet: es Projekt bruucht die vilicht na. Dateie, wo Git trackt, sind nöd ufgführt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके प्रोजेक्ट के अंदर। आपके लिए कभी नहीं चुने जाते: प्रोजेक्ट को अब भी इनकी ज़रूरत हो सकती है। Git जिन फ़ाइलों को ट्रैक करता है, वे सूचीबद्ध नहीं हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unutar tvojih projekata. Nikad nisu označene umjesto tebe: projekt ih još može trebati. Datoteke koje Git prati nisu navedene."
          }
        },
