    "Updates often fix security problems, so install this when you can." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غالبًا ما تُصلح التحديثات مشكلات أمنية، لذا ثبّته متى استطعت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actualitzacions sovint corregeixen problemes de seguretat, així que instal·la-la quan puguis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates beheben oft Sicherheitsprobleme, installiere es also, sobald du kannst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates often fix security problems, so install this when you can."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates often fix security problems, so install this when you can."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates often fix security problems, so install this when you can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones suelen corregir problemas de seguridad, así que instálala en cuanto puedas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones suelen corregir problemas de seguridad, así que instálala en cuanto puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour corrigent souvent des failles de sécurité ; installez celle-ci dès que possible."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates behebed oft Sicherheitsproblem, drum installier das, sobald du chasch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट अक्सर सुरक्षा समस्याएँ ठीक करते हैं, इसलिए जब हो सके इसे इंस्टॉल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja često ispravljaju sigurnosne probleme, pa ih instaliraj kad možeš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti spesso risolvono problemi di sicurezza, quindi installalo appena puoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートはセキュリティ上の問題を修正することが多いため、可能なときにインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트는 보안 문제를 해결하는 경우가 많으므로 가능할 때 설치하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atjauninājumi bieži labo drošības problēmas, tāpēc uzstādi to, kad vari."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uaktualnienia często naprawiają problemy z bezpieczeństwem, więc zainstaluj je, gdy tylko możesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações costumam corrigir problemas de segurança, por isso instale esta assim que puder."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përditësimet shpesh rregullojnë probleme sigurie, prandaj instaloje këtë kur të mundesh."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ажурирања често исправљају безбедносне проблеме, зато ово инсталирајте када можете."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja često ispravljaju bezbednosne probleme, zato ovo instalirajte kada možete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdateringar åtgärdar ofta säkerhetsproblem, så installera den här när du kan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeler çoğunlukla güvenlik sorunlarını giderir, bu yüzden uygun olduğunda kurun."
