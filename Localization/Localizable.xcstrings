    "Powered by the adapter. macOS may hold charge to protect the battery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل بالطاقة من المحوّل. قد يوقف macOS الشحن عند مستوى معيّن لحماية البطارية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimentat per l’adaptador. macOS pot limitar la càrrega per protegir la bateria."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird vom Netzteil versorgt. macOS hält die Ladung eventuell zurück, um die Batterie zu schonen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powered by the adapter. macOS may hold charge to protect the battery."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powered by the adapter. macOS may hold charge to protect the battery."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powered by the adapter. macOS may hold charge to protect the battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimentado por el adaptador. macOS puede mantener la carga para proteger la batería."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimentado por el adaptador. macOS puede mantener la carga para proteger la batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimenté par l’adaptateur. macOS peut retenir la charge pour protéger la batterie."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird vom Netzteil versorgt. macOS haltet d Ladig evtl. zrugg, zum d Batterie z schütze."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अडैप्टर से चल रहा है। बैटरी की सुरक्षा के लिए macOS चार्ज रोक सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napaja adapter. macOS može zadržati naboj radi zaštite baterije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimentato dall'adattatore. macOS può mantenere la carica per proteggere la batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプタから給電中。macOSは、バッテリーを保護するため充電を保留する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어댑터로 전원을 공급 중입니다. macOS가 배터리를 보호하기 위해 충전을 멈출 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbojas no adaptera. macOS var noturēt uzlādes līmeni, lai aizsargātu akumulatoru."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasilanie z zasilacza. macOS może wstrzymać ładowanie, aby chronić baterię."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimentado pelo adaptador. O macOS pode reter a carga para proteger a bateria."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ushqehet nga përshtatësi. macOS mund ta mbajë ngarkesën për të mbrojtur baterinë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напаја се преко адаптера. macOS може да задржи пуњење да би заштитио батерију."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napaja se preko adaptera. macOS može da zadrži punjenje da bi zaštitio bateriju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drivs av nätadaptern. macOS kan begränsa laddningen för att skydda batteriet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptörden besleniyor. macOS pili korumak için şarjı tutabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由电源适配器供电。macOS 可能会保持电量以保护电池。"
          }
        }
      }
    },
