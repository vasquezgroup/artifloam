          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlatma ajanlarını ve hizmetleri inceleyin. Etkin oturum açma öğelerini macOS Sistem Ayarları’ndan yönetin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
