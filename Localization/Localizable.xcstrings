            "value" : "%@ को Git अनदेखा करता है, इसलिए उसे वापस नहीं लाया जा सकता। उसे हमेशा के लिए डिलीट कर दिया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git zanemaruje: %@. Ne može se vratiti. Bit će trajno izbrisano."
          }
