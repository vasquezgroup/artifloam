    "Other is space on this drive the map could not attribute to a file: macOS system data, snapshots, purgeable space and folders macOS did not let Artifloam read." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«أخرى» هي مساحة على هذا القرص لم تتمكن الخريطة من نسبتها إلى ملف: بيانات نظام macOS واللقطات والمساحة القابلة للتفريغ والمجلدات التي لم يسمح macOS لـ Artifloam بقراءتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Altres» és l’espai d’aquest disc que el mapa no ha pogut atribuir a cap arxiu: dades del sistema macOS, instantànies, espai purgable i carpetes que macOS no ha deixat llegir a Artifloam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Andere“ ist Platz auf diesem Laufwerk, den die Karte keiner Datei zuordnen konnte: macOS-Systemdaten, Schnappschüsse, löschbarer Platz und Ordner, die macOS Artifloam nicht lesen ließ."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other is space on this drive the map could not attribute to a file: macOS system data, snapshots, purgeable space and folders macOS did not let Artifloam read."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other is space on this drive the map could not attribute to a file: macOS system data, snapshots, purgeable space and folders macOS did not let Artifloam read."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other is space on this drive the map could not attribute to a file: macOS system data, snapshots, purgeable space and folders macOS did not let Artifloam read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Otros» es espacio de este disco que el mapa no ha podido atribuir a un archivo: datos del sistema de macOS, instantáneas, espacio purgable y carpetas que macOS no ha dejado leer a Artifloam."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Otros» es espacio de este disco que el mapa no ha podido atribuir a un archivo: datos del sistema de macOS, instantáneas, espacio purgable y carpetas que macOS no ha dejado leer a Artifloam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autre correspond à l’espace de ce disque que la carte n’a pas pu attribuer à un fichier : données système de macOS, snapshots, espace purgeable et dossiers que macOS n’a pas laissé Artifloam lire."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Anderi» isch Platz uf dem Laufwerk, wo d Charte keiner Datei hät chöne zuordne: macOS-Systemdate, Snapshots, freigäbbare Platz und Ordner, wo macOS Artifloam nöd hät laa läse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘अन्य’ इस ड्राइव की वह जगह है जिसे मैप किसी फ़ाइल से नहीं जोड़ सका: macOS सिस्टम डेटा, स्नैपशॉट, purgeable जगह और वे फ़ोल्डर जिन्हें macOS ने Artifloam को पढ़ने नहीं दिया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostalo je prostor na ovom disku koji prikaz nije mogao pripisati datoteci: podaci sustava macOS, snimke, prostor koji se može osloboditi i mape koje macOS nije dopustio Artifloamu da pročita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altro è lo spazio su questo disco che la mappa non ha potuto attribuire a un file: dati di sistema di macOS, snapshot, spazio recuperabile e cartelle che macOS non ha lasciato leggere ad Artifloam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「その他」は、マップがファイルに割り当てられなかった、このドライブ上の容量です。macOSのシステムデータ、スナップショット、パージ可能な容量、macOSがArtifloamに読み取らせなかったフォルダが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘기타’는 맵이 파일에 귀속시키지 못한 이 드라이브의 공간입니다: macOS 시스템 데이터, 스냅샷, 제거 가능 공간, macOS가 Artifloam이 읽도록 허용하지 않은 폴더."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cits ir vieta šajā diskā, ko karte nevarēja piedēvēt failam: macOS sistēmas dati, momentuzņēmumi, atbrīvojamā vieta un mapes, ko macOS neļāva Artifloam nolasīt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne to miejsce na tym dysku, którego mapa nie mogła przypisać do pliku: dane systemowe macOS, migawki, miejsce do zwolnienia oraz foldery, których macOS nie pozwolił odczytać Artifloam."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros é o espaço neste disco que o mapa não conseguiu atribuir a um ficheiro: dados do sistema macOS, snapshots, espaço purgável e pastas que o macOS não permitiu ao Artifloam ler."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të tjera është hapësira në këtë disk që harta nuk mundi t'ia përshkruante një skedari: të dhëna të sistemit macOS, snapshot-e, hapësirë e pastrueshme dhe dosje që macOS nuk e la Artifloam t'i lexonte."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остало је простор на овом диску који мапа није могла да припише фајлу: системски подаци macOS-а, снимци, простор који се може ослободити и фасцикле које macOS није дозволио да Artifloam прочита."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostalo je prostor na ovom disku koji mapa nije mogla da pripiše fajlu: sistemski podaci macOS-a, snimci, prostor koji se može osloboditi i fascikle koje macOS nije dozvolio da Artifloam pročita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Övrigt är utrymme på den här disken som kartan inte kunde koppla till en fil: macOS systemdata, ögonblicksbilder, rensningsbart utrymme och mappar som macOS inte lät Artifloam läsa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer, haritanın bir dosyaya atfedemediği bu sürücüdeki alandır: macOS sistem verileri, anlık görüntüler, boşaltılabilir alan ve macOS’un Artifloam’ın okumasına izin vermediği klasörler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“其他”是这块磁盘上地图无法归属到某个文件的空间：macOS 系统数据、快照、可清除的空间，以及 macOS 未允许 Artifloam 读取的文件夹。"
          }
        }
      }
    },
