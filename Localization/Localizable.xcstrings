    "Rebuilt as you browse. You stay signed in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعاد بناؤها أثناء التصفح. يبقى تسجيل دخولك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es torna a crear mentre navegues. La sessió es manté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim Surfen neu aufgebaut. Du bleibst angemeldet."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebuilt as you browse. You stay signed in."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebuilt as you browse. You stay signed in."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebuilt as you browse. You stay signed in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reconstruye mientras navegas. Tu sesión se mantiene."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reconstruye mientras navegas. Tu sesión se mantiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recréé au fil de votre navigation. Vous restez connecté."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baut sich beim Surfe neu uf. Du blibsch aagmäldet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राउज़ करते समय दोबारा बन जाता है। आप साइन इन रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovno se gradi dok pregledavaš. Prijava ostaje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruite mentre navighi. Gli accessi restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閲覧に合わせて再作成されます。サインインしたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탐색하면서 다시 만들어집니다. 로그인 상태는 유지됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izveidojas no jauna, kamēr pārlūko. Pieteikšanās saglabājas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbudowywane podczas przeglądania. Logowania zostają."
