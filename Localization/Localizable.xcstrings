        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Probablemente puedes prescindir de ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Vous pouvez probablement vous en séparer sans risque."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Cha vermuetlich sicher entfernt werde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। इसे जाने देना शायद सुरक्षित है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Vjerojatno je sigurno ukloniti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Probabilmente puoi farne a meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。手放しても問題ない可能性が高いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 정리해도 안전할 가능성이 높습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Visticamāk, var droši atteikties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Prawdopodobnie można się tego bezpiecznie pozbyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Provavelmente pode ser dispensado com segurança."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ka gjasa që mund të hiqet pa rrezik."
