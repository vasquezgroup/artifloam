    "Showing up to three of %lld reported devices. The list may be incomplete." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض ما يصل إلى ثلاثة من %lld أجهزة مُبلَّغ عنها. قد تكون القائمة غير مكتملة."
          }
        },
