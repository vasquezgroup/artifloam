    "Artifloam works best from your Applications folder. macOS keeps its permissions there, and the daily cleanup and uninstall expect it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Artifloam بأفضل شكل من مجلد التطبيقات. يحتفظ macOS بأذوناته هناك، ويتوقع التنظيف اليومي والإزالة وجوده فيه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam funciona millor des de la carpeta Apps. macOS hi manté els permisos, i la neteja diària i la desinstal·lació ho esperen així."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam funktioniert am besten aus deinem Ordner „Apps“. macOS behält seine Berechtigungen dort, und die tägliche Bereinigung und das Deinstallieren setzen das voraus."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam works best from your Applications folder. macOS keeps its permissions there, and the daily cleanup and uninstall expect it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam works best from your Applications folder. macOS keeps its permissions there, and the daily cleanup and uninstall expect it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam works best from your Applications folder. macOS keeps its permissions there, and the daily cleanup and uninstall expect it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam funciona mejor desde tu carpeta Aplicaciones. Ahí macOS mantiene sus permisos, y la limpieza diaria y la desinstalación lo esperan así."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam funciona mejor desde tu carpeta Apps. Ahí macOS mantiene sus permisos, y la limpieza diaria y la desinstalación lo esperan así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam fonctionne mieux depuis votre dossier Applications. macOS y conserve ses autorisations, et le nettoyage quotidien et la désinstallation en dépendent."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam funktioniert am beschte us em Ordner «Apps». Dört bhaltet macOS sini Berechtigunge, und s tägliche Ufruume und s Deinstalliere erwarted das."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam आपके ऐप्लिकेशन फ़ोल्डर से सबसे अच्छा काम करता है। macOS इसकी अनुमतियाँ वहीं रखता है, और रोज़ की सफ़ाई व अनइंस्टॉल वहीं की अपेक्षा करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam najbolje radi iz mape Aplikacije. macOS ondje čuva njegova dopuštenja, a dnevno čišćenje i deinstalacija to očekuju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam funziona al meglio dalla cartella Applicazioni. Lì macOS mantiene le sue autorizzazioni, e la pulizia giornaliera e la disinstallazione si aspettano che sia lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloamは「アプリケーション」フォルダから使うのが最適です。macOSは権限をそこで保持し、毎日のクリーンアップと削除もそこにあることを前提にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam은 응용 프로그램 폴더에서 가장 잘 작동합니다. macOS가 그곳에 권한을 보관하며, 매일 정리와 제거 기능도 그 위치를 전제로 합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam vislabāk darbojas no mapes Lietotnes. macOS tur glabā tā atļaujas, un ikdienas tīrīšana un noņemšana to sagaida."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam działa najlepiej z folderu Aplikacje. macOS zachowuje tam jego uprawnienia, a codzienne czyszczenie i odinstalowanie tego oczekują."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Artifloam funciona melhor a partir da pasta Aplicações. O macOS guarda aí as suas permissões, e a limpeza diária e a desinstalação contam com isso."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam punon më mirë nga dosja jote Applications. macOS i ruan lejet e tij atje, dhe pastrimi ditor dhe çinstalimi presin që të jetë aty."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam најбоље ради из ваше фасцикле Апликације. macOS тамо чува његове дозволе, а дневно чишћење и деинсталација то очекују."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam najbolje radi iz vaše fascikle Aplikacije. macOS tamo čuva njegove dozvole, a dnevno čišćenje i deinstalacija to očekuju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam fungerar bäst från mappen Appar. macOS behåller dess behörigheter där, och den dagliga rensningen och avinstallationen förväntar sig det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam en iyi Uygulamalar klasöründen çalışır. macOS izinlerini orada tutar; günlük temizlik ve kaldırma da bunu bekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam 从“应用程序”文件夹运行效果最佳。macOS 会在那里保存它的权限，每日清理和卸载也都依赖于此。"
          }
        }
      }
    },
    "Artifloam · Mac dashboard" : {
      "localizations" : {
        "ar" : {
