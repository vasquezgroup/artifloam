        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevar nolasīt %@: %@. Ja vajag, piešķir mapes piekļuvi sadaļā macOS Privātums un drošība."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać %@: %@. W razie potrzeby przyznaj dostęp do folderu w sekcji Prywatność i ochrona w macOS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler %@: %@. Se necessário, conceda acesso à pasta em Privacidade e segurança do macOS."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nuk mund të lexohet: %@. Jep qasje në dosje te Privatësia dhe siguria e macOS nëse është e nevojshme."
