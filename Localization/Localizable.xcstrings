    "can be freed. %@ is ready; you choose the rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابلة للتحرير. %@ جاهزة؛ وأنت تختار الباقي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "es poden alliberar. %@ està a punt; la resta la tries tu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kann freigegeben werden. %@ ist bereit; den Rest wählst du aus."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "can be freed. %@ is ready; you choose the rest."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "can be freed. %@ is ready; you choose the rest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "can be freed. %@ is ready; you choose the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "se pueden liberar. %@ está listo; el resto lo eliges tú."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "se pueden liberar. %@ está listo; el resto lo eliges tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "à libérer. %@ est prêt ; vous choisissez le reste."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cha freigää werde. %@ isch bereit; de Rescht wählsch du uus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाली किया जा सकता है। %@ तैयार है; बाकी आप चुनते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "može se osloboditi. %@ je spremno; ostalo biraš ti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "può essere liberato. %@ è pronto; il resto lo scegli tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解放できます。%@は準備完了で、残りはご自身で選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확보할 수 있습니다. %@ 준비됨. 나머지는 직접 선택합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "var atbrīvot. Gatavs: %@; pārējo izvēlies tu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "można zwolnić. %@ jest gotowe; resztę wybierasz Ty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pode ser libertado. %@ está pronto; o resto é consigo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mund të çlirohen. %@ është gati; pjesën tjetër e zgjedh ti."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "може да се ослободи. %@ је спремно; остало ви бирате."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "može da se oslobodi. %@ je spremno; ostalo vi birate."
          }
        },
        "sv" : {
