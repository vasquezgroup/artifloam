          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका सबसे नया बैकअप एक महीने से पुराना है, या कोई बैकअप नहीं है। %@ पर: सेटिंग, आपका नाम, iCloud, iCloud बैकअप, अभी बैकअप लें।"
