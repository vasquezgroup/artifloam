    "There isn't enough free space to do this safely. It needs about twice the item's size." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مساحة خالية كافية لتنفيذ ذلك بأمان. يلزم ما يقارب ضعف حجم العنصر."
