          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasformazioni di artefatti Gradle inutilizzate, JAR Gradle generati, cache dei moduli Xcode e cache di download di npm. Le cache recenti o attive, le dipendenze scaricate e la configurazione restano protette."
          }
        },
        "ja" : {
