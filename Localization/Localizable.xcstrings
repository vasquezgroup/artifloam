            "state" : "translated",
            "value" : "Una sesión de Claude Code o Codex lo ha usado en las últimas 24 horas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión de Claude Code o Codex lo ha usado en las últimas 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session Claude Code ou Codex l’a utilisé au cours des dernières 24 heures."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E Session vo Claude Code oder Codex hät das i de letschte 24 Stunde bruucht."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले 24 घंटों में किसी Claude Code या Codex सेशन ने इसका उपयोग किया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesija Claude Code ili Codex koristila je ovo u posljednja 24 sata."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sessione di Claude Code o Codex l'ha usato nelle ultime 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude CodeまたはCodexのセッションが、過去24時間以内に使用しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 또는 Codex 세션이 지난 24시간 이내에 사용했습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code vai Codex sesija to izmantoja pēdējo 24 stundu laikā."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja Claude Code lub Codex użyła tego w ciągu ostatnich 24 godzin."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi utilizado por uma sessão do Claude Code ou do Codex nas últimas 24 horas."
          }
        },
        "sq" : {
