          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina egna filer stannar där de är. Bara det som Artifloam har skapat tas bort, och du ser listan först."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi dosyalarınız olduğu yerde kalır. Yalnızca Artifloam’ın oluşturdukları kaldırılır ve önce listeyi görürsünüz."
          }
        },
