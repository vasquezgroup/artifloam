    "Regenerable compiler module cache unused for at least 30 days." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذاكرة وحدات المُصرِّف القابلة لإعادة التوليد وغير المستخدمة منذ 30 يومًا على الأقل."
          }
        },
        "ca" : {
