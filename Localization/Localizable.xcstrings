        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyle zgłasza iOS dla tych aplikacji. Rzeczywista ilość może być mniejsza. Po zakończeniu zobaczysz, co faktycznie się zmieniło."
