    "This can take a long time and use up to %@. It's an unencrypted copy of your %@, so you can remove it once it's been read." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يستغرق هذا وقتًا طويلًا ويستخدم ما يصل إلى %1$@. إنها نسخة غير مشفّرة من الـ %2$@، لذا يمكنك إزالتها بعد قراءتها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pot trigar molt i ocupar fins a %1$@. És una còpia no xifrada de l’%2$@, així que pots eliminar-la un cop llegida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann lange dauern und bis zu %1$@ belegen. Es ist eine unverschlüsselte Kopie deines %2$@, du kannst sie also entfernen, sobald sie gelesen wurde."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can take a long time and use up to %1$@. It's an unencrypted copy of your %2$@, so you can remove it once it's been read."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can take a long time and use up to %1$@. It's an unencrypted copy of your %2$@, so you can remove it once it's been read."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can take a long time and use up to %1$@. It's an unencrypted copy of your %2$@, so you can remove it once it's been read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede tardar mucho y usar hasta %1$@. Es una copia sin cifrar de tu %2$@, así que puedes quitarla cuando se haya leído."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede tardar mucho y usar hasta %1$@. Es una copia sin cifrar de tu %2$@, así que puedes quitarla cuando se haya leído."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut être long et utiliser jusqu’à %1$@. C’est une copie non chiffrée de votre %2$@, vous pouvez donc la supprimer une fois qu’elle a été lue."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das cha lang dure und bis zu %1$@ belege. Es isch e unverschlüsseleti Kopie vo dim %2$@, du chasch si also entferne, sobald si gläse worde isch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसमें बहुत समय लग सकता है और यह %1$@ तक इस्तेमाल कर सकता है। यह आपके %2$@ की एन्क्रिप्ट न की हुई प्रति है, इसलिए पढ़े जाने के बाद आप इसे हटा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo može dugo trajati i zauzeti do %1$@. To je nešifrirana kopija tvog %2$@a, pa je možeš ukloniti kad se pročita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può richiedere molto tempo e occupare fino a %1$@. È una copia non cifrata dell'%2$@, quindi puoi rimuoverla una volta letta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間がかかることがあり、最大%1$@を使用します。これは暗号化されていない%2$@のコピーなので、読み取り後は削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래 걸릴 수 있으며 최대 %1$@을(를) 사용합니다. 암호화되지 않은 %2$@ 사본이므로 읽은 후에는 제거해도 됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas var aizņemt daudz laika un izmantot līdz %1$@. Tā ir nešifrēta tava %2$@ kopija, tāpēc pēc nolasīšanas to vari noņemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To może potrwać długo i zająć do %1$@. To niezaszyfrowana kopia Twojego urządzenia %2$@, więc możesz ją usunąć po odczytaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode demorar muito e usar até %1$@. É uma cópia não encriptada do seu %2$@, por isso pode removê-la depois de lida."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo mund të zgjasë shumë dhe të përdorë deri në %1$@. Është një kopje e pa enkriptuar e %2$@ tënd, ndaj mund ta heqësh pasi të jetë lexuar."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ово може дуго трајати и заузети до %1$@. То је нешифрована копија вашег %2$@-а, па је можете уклонити када се прочита."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo može dugo trajati i zauzeti do %1$@. To je nešifrovana kopija vašeg %2$@-a, pa je možete ukloniti kada se pročita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan ta lång tid och ta upp till %1$@. Det är en okrypterad kopia av din %2$@, så du kan ta bort den när den har lästs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uzun sürebilir ve en fazla %1$@ kullanabilir. %2$@ cihazınızın şifrelenmemiş bir kopyasıdır, bu yüzden okunduktan sonra kaldırabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这可能需要很长时间，并占用最多 %1$@。这是 %2$@ 的未加密副本，读取完成后即可移除。"
          }
        }
      }
    },
