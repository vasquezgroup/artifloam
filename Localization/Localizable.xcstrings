    "Generated Gradle output unused for at least 30 days. Dependencies, wrappers and configuration are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرجات Gradle المولَّدة غير المستخدمة منذ 30 يومًا على الأقل. تبقى التبعيات والـ wrappers والإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortida de Gradle generada i sense usar durant almenys 30 dies. Les dependències, els wrappers i la configuració es conserven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugte Gradle-Ausgabe, die seit mindestens 30 Tagen unbenutzt ist. Abhängigkeiten, Wrapper und Konfiguration bleiben erhalten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generated Gradle output unused for at least 30 days. Dependencies, wrappers and configuration are kept."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generated Gradle output unused for at least 30 days. Dependencies, wrappers and configuration are kept."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generated Gradle output unused for at least 30 days. Dependencies, wrappers and configuration are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultados generados de Gradle sin usar desde hace al menos 30 días. Se conservan las dependencias, los wrappers y la configuración."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultados generados de Gradle sin usar desde hace al menos 30 días. Se conservan las dependencias, los wrappers y la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorties Gradle générées inutilisées depuis au moins 30 jours. Les dépendances, wrappers et configurations sont conservés."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generierti Gradle-Uusgab, wo mindestens 30 Täg nöd bruucht worde isch. Abhängigkeite, Wrapper und Konfiguration blibed erhalte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम 30 दिनों से अनुपयोगी Gradle का जनरेट किया गया आउटपुट। डिपेंडेंसी, रैपर और कॉन्फ़िगरेशन रखे जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generirani Gradle izlaz nekorišten najmanje 30 dana. Ovisnosti, wrapperi i konfiguracija zadržavaju se."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Output Gradle generato e inutilizzato da almeno 30 giorni. Dipendenze, wrapper e configurazione vengono conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少なくとも30日間使われていない、生成されたGradleの出力。依存関係、ラッパー、構成は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 30일 동안 사용하지 않은 생성된 Gradle 출력. 의존성, 래퍼, 구성은 유지됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ģenerēta Gradle izvade, kas nav izmantota vismaz 30 dienas. Atkarības, wrapperi un konfigurācija tiek paturēti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygenerowane pliki Gradle nieużywane od co najmniej 30 dni. Zależności, wrappery i konfiguracja są zachowywane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saída do Gradle gerada e não utilizada há pelo menos 30 dias. As dependências, os wrappers e a configuração são mantidos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalje e gjeneruar e Gradle e papërdorur për të paktën 30 ditë. Varësitë, wrapper-at dhe konfigurimi mbahen."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Генерисани Gradle излаз који се не користи најмање 30 дана. Зависности, wrappers и конфигурација се задржавају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generisani Gradle izlaz koji se ne koristi najmanje 30 dana. Zavisnosti, wrappers i konfiguracija se zadržavaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genererad Gradle-utdata som inte använts på minst 30 dagar. Beroenden, wrappers och konfiguration behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En az 30 gündür kullanılmayan üretilmiş Gradle çıktısı. Bağımlılıklar, wrapper’lar ve yapılandırma korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 30 天未使用的 Gradle 生成输出。依赖项、wrapper 和配置会保留。"
          }
        }
      }
    },
