    "This Mac is missing the Apple software that talks to iPhones. Connecting an iPhone in Finder once usually installs it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتقد هذا الـ Mac برنامج Apple الذي يتواصل مع أجهزة iPhone. عادةً ما يؤدي توصيل iPhone في Finder مرة واحدة إلى تثبيته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest Mac no té el programari d’Apple que es comunica amb els iPhone. Normalment s’instal·la en connectar un iPhone al Finder una vegada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac fehlt die Apple-Software, die mit iPhones kommuniziert. Einmal ein iPhone im Finder zu verbinden, installiert sie meist."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac is missing the Apple software that talks to iPhones. Connecting an iPhone in Finder once usually installs it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac is missing the Apple software that talks to iPhones. Connecting an iPhone in Finder once usually installs it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac is missing the Apple software that talks to iPhones. Connecting an iPhone in Finder once usually installs it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A este Mac le falta el software de Apple que se comunica con los iPhone. Conectar un iPhone en el Finder una vez suele instalarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
