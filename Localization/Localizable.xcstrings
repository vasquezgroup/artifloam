    "%@. Many apps do this to sync or to find nearby devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. تفعل تطبيقات كثيرة ذلك للمزامنة أو للعثور على الأجهزة القريبة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Moltes apps ho fan per sincronitzar o per trobar dispositius propers."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Viele Apps tun das, um zu synchronisieren oder Geräte in der Nähe zu finden."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Many apps do this to sync or to find nearby devices."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Many apps do this to sync or to find nearby devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Many apps do this to sync or to find nearby devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Muchas apps lo hacen para sincronizar o para buscar dispositivos cercanos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Muchas apps lo hacen para sincronizar o para buscar dispositivos cercanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. De nombreuses apps le font pour se synchroniser ou trouver des appareils à proximité."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Vil Apps mached das zum Synchronisiere oder zum Gräte i de Nöchi finde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। कई ऐप सिंक करने या आस-पास के डिवाइस खोजने के लिए ऐसा करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Mnoge aplikacije to rade radi sinkronizacije ili traženja uređaja u blizini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Molte app lo fanno per sincronizzarsi o trovare dispositivi vicini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。多くのアプリが、同期や近くのデバイスの検出のためにこれを行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 많은 앱이 동기화하거나 근처 기기를 찾기 위해 이렇게 합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Daudzas lietotnes to dara, lai sinhronizētu vai atrastu tuvumā esošas ierīces."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Wiele aplikacji robi to w celu synchronizacji lub wyszukiwania pobliskich urządzeń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Muitas apps fazem isto para sincronizar ou encontrar dispositivos próximos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Shumë aplikacione e bëjnë këtë për të sinkronizuar ose për të gjetur pajisje aty pranë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Многе апликације то раде да би се синхронизовале или пронашле уређаје у близини."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Mnoge aplikacije to rade da bi se sinhronizovale ili pronašle uređaje u blizini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Många appar gör detta för att synkronisera eller hitta enheter i närheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Birçok uygulama bunu eşzamanlamak veya yakındaki aygıtları bulmak için yapar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。许多 App 会这样做，以同步或查找附近的设备。"
          }
        }
      }
    },
    "%@. Probably safe to let go." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. على الأرجح يمكن الاستغناء عنه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Probablement es pot deixar anar sense problema."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Kann vermutlich gefahrlos weg."
          }
        },
        "en-AU" : {
