    "Live pressure, swap and app footprints. Release RAM by quitting apps you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضغط وذاكرة التبديل وبصمات التطبيقات مباشرةً. حرّر RAM بإنهاء التطبيقات التي تختارها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressió, intercanvi i petjada de les apps en directe. Allibera RAM tancant les apps que triïs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Druck, Swap und Speicherbedarf der Apps. Gib RAM frei, indem du ausgewählte Apps beendest."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live pressure, swap and app footprints. Release RAM by quitting apps you choose."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live pressure, swap and app footprints. Release RAM by quitting apps you choose."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live pressure, swap and app footprints. Release RAM by quitting apps you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presión, swap y huella de las apps en directo. Libera RAM cerrando las apps que elijas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presión, swap y huella de las apps en directo. Libera RAM cerrando las apps que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pression, swap et empreinte des apps en direct. Libérez de la RAM en quittant les apps que vous choisissez."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Druck, Swap und Speicherbedarf vo Apps. Gib RAM frei, indem du Apps beändisch, wo du uuswählsch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव दबाव, स्वैप और ऐप का मेमोरी उपयोग। आपके चुने ऐप बंद करके RAM खाली करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisak, swap i otisci aplikacija uživo. Oslobodi RAM zatvaranjem aplikacija koje odabereš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione, swap e impronta delle app in tempo reale. Libera RAM chiudendo le app che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリプレッシャー、スワップ、アプリのフットプリントをリアルタイムで確認。選んだアプリを終了してRAMを解放します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 압력, 스왑, 앱 사용량. 선택한 앱을 종료해 RAM을 확보합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiediens, swap un lietotņu atmiņas nospiedums reāllaikā. Atbrīvo RAM, aizverot lietotnes, ko izvēlies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bieżące ciśnienie, swap i zużycie pamięci przez aplikacje. Zwolnij RAM, kończąc wybrane aplikacje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressão, swap e consumo das apps em tempo real. Liberte RAM saindo das apps que escolher."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presion, swap dhe gjurmë aplikacionesh drejtpërdrejt. Çliro RAM duke mbyllur aplikacionet që zgjedh."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Притисак уживо, swap и заузеће апликација. Ослободите RAM затварањем апликација које изаберете."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisak uživo, swap i zauzeće aplikacija. Oslobodite RAM zatvaranjem aplikacija koje izaberete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck, swap och appars minnesavtryck i realtid. Frigör RAM genom att avsluta appar du väljer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı baskı, takas ve uygulama ayak izleri. RAM’i seçtiğiniz uygulamalardan çıkarak serbest bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时的压力、交换空间和 App 占用。通过退出你选择的 App 来释放 RAM。"
          }
        }
      }
    },
