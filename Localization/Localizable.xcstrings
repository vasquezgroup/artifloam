          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ से। ये पहले रद्दी में जाते हैं, इसलिए आप इन्हें वापस रख सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ iz %@. Prvo idu u Smeće, pa ih još možeš vratiti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ da %@. Vanno prima nel Cestino, quindi puoi ancora ripristinarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(%@から)。まずゴミ箱に入るので、あとで戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 %1$@. 먼저 휴지통으로 이동하므로 되돌려 놓을 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no %@. Tie vispirms nonāk Atkritnē, tāpēc tos vēl var ielikt atpakaļ."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ z %@. Trafią najpierw do Kosza, więc nadal możesz je przywrócić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de %@. Vão primeiro para o Lixo, pelo que ainda os pode repor."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nga %@. Shkojnë më parë në Kosh, kështu që mund t'i kthesh mbrapsht."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ из %@. Прво иду у Отпад, па их још увек можете вратити."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ iz %@. Prvo idu u Otpad, pa ih još uvek možete vratiti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ från %@. De flyttas först till papperskorgen, så du kan fortfarande lägga tillbaka dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ içinden %1$@. Önce Çöp Sepeti’ne taşınırlar, böylece yerlerine koyabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 %@ 的 %@。它们会先移到废纸篓，因此你仍可将其放回原处。"
          }
        }
      }
    },
    "%@ has spilled to disk earlier. Quitting idle apps helps it shrink over time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقل جزء من %@ إلى القرص سابقًا. يساعد إنهاء التطبيقات الخاملة على تقلّصه مع الوقت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha passat al disc abans. Si tanques les apps inactives, es reduirà amb el temps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde früher auf die Festplatte ausgelagert. Wenn du inaktive Apps beendest, schrumpft es mit der Zeit."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has spilled to disk earlier. Quitting idle apps helps it shrink over time."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has spilled to disk earlier. Quitting idle apps helps it shrink over time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has spilled to disk earlier. Quitting idle apps helps it shrink over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha volcado antes al disco. Salir de las apps inactivas ayuda a reducirlo con el tiempo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha volcado antes al disco. Salir de las apps inactivas ayuda a reducirlo con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ont débordé sur le disque plus tôt. Quitter les apps inactives aide à les réduire avec le temps."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isch früener uf d Festplatte uusglageret worde. Wenn du ungnutzti Apps beändisch, wird's mit der Ziit weniger."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पहले डिस्क पर स्पिल हो चुका है। निष्क्रिय ऐप बंद करने से यह समय के साथ घटने में मदद मिलती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je ranije preneseno na disk. Zatvaranjem neaktivnih aplikacija s vremenom se smanjuje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In passato %@ ha usato il disco come memoria di scambio. Chiudere le app inattive aiuta a ridurla nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は以前にディスクへ書き出されました。使っていないアプリを終了すると、時間とともに小さくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이전에 디스크로 넘쳐 저장되었습니다. 사용하지 않는 앱을 종료하면 시간이 지나면서 줄어드는 데 도움이 됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ agrāk ir pārcelts uz disku. Neaktīvu lietotņu aizvēršana palīdz to laika gaitā samazināt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wcześniej %@ zostało przeniesione na dysk. Zamykanie nieużywanych aplikacji pomaga z czasem to zmniejszyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi transferido para o disco anteriormente. Sair das apps inativas ajuda a reduzi-lo com o tempo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ është zhvendosur më parë në disk. Mbyllja e aplikacioneve boshe e ndihmon të zvogëlohet me kalimin e kohës."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раније је %@ преливено на диск. Затварање неактивних апликација помаже да се то временом смањи."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranije je %@ preliveno na disk. Zatvaranje neaktivnih aplikacija pomaže da se to vremenom smanji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har tidigare lagrats ut på disken. Om du avslutar inaktiva appar krymper det med tiden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ daha önce diske taşmış. Boştaki uygulamalardan çıkmak zamanla küçülmesine yardımcı olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 之前已写入磁盘。退出闲置的 App 有助于它逐渐缩小。"
          }
        }
      }
    },
    "%@ ignored Quit. Force quit ends it; unsaved changes are lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تجاهل أمر الإنهاء. الإنهاء الإجباري يُغلقه، وتضيع التغييرات غير المحفوظة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha ignorat «Surt». «Força la sortida» el tanca; es perdran els canvis sense desar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat „Beenden“ ignoriert. „Sofort beenden“ beendet die App; nicht gesicherte Änderungen gehen verloren."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignored Quit. Force quit ends it; unsaved changes are lost."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignored Quit. Force quit ends it; unsaved changes are lost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignored Quit. Force quit ends it; unsaved changes are lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha ignorado Salir. Forzar salida lo cierra; se pierden los cambios sin guardar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha ignorado Salir. Forzar salida lo cierra; se pierden los cambios sin guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas réagi à Quitter. Forcer à quitter l’arrête ; les modifications non enregistrées sont perdues."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hät «Beenden» ignoriert. «Sofort beenden» beändet's; nöd gspeicherti Änderige gönd verlore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने बंद करने के अनुरोध को अनदेखा किया। ज़बरदस्ती बंद करने पर यह बंद हो जाता है; बिना सहेजे बदलाव खो जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ je zanemarila Zatvori. Prisilno zatvaranje je prekida; nespremljene promjene gube se."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha ignorato Esci. Uscita forzata lo termina; le modifiche non salvate vanno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は「終了」を無視しました。強制終了すると終了させますが、保存されていない変更は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 종료 요청을 무시했습니다. 강제 종료하면 즉시 종료되며, 저장하지 않은 변경 사항은 사라집니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignorēja komandu Aizvērt. Piespiedu aizvēršana to pārtrauc; nesaglabātās izmaiņas tiek zaudētas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ zignorowała polecenie Zakończ. Wymuszone zakończenie zamyka ją; niezapisane zmiany zostaną utracone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignorou o pedido para sair. Forçar saída encerra a app; as alterações não guardadas são perdidas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e injoroi komandën Mbyll. Mbyllja e detyruar e përfundon; ndryshimet e paruajtura humbasin."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Апликација %@ је игнорисала захтев за затварање. Принудно затварање је окончава; несачуване измене се губе."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ je ignorisala zahtev za zatvaranje. Prinudno zatvaranje je okončava; nesačuvane izmene se gube."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ignorerade Avsluta. Tvinga avslut stänger den; osparade ändringar går förlorade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Çık komutunu yok saydı. Çıkmaya zorlamak uygulamayı kapatır; kaydedilmemiş değişiklikler kaybolur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未响应“退出”。强制退出会将其结束；未存储的更改将会丢失。"
          }
        }
      }
    },
