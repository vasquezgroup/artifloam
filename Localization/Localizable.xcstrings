          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके %2$@ से %1$@ हटाया जा रहा है। उसे अनलॉक और कनेक्ट रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjanje %1$@ s tvog %2$@a. Neka ostane otključan i spojen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
