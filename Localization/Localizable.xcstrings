    "The duplicate search was skipped because no folder has been chosen. Open Tools > Duplicates to choose one. Other checks are complete." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تخطي البحث عن النسخ المكررة لأنه لم يُختر أي مجلد. افتح الأدوات > النسخ المكررة لاختيار مجلد. اكتملت الفحوصات الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha omès la cerca de duplicats perquè no s’ha triat cap carpeta. Obre Eines > Duplicats per triar-ne una. Les altres comprovacions s’han completat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
