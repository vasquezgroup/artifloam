    "App caches are not included in scheduled cleanup. The schedule is a user LaunchAgent; it requests no administrator access and runs without a network service." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تدخل الذاكرات المؤقتة للتطبيقات في التنظيف المجدول. الجدول هو LaunchAgent للمستخدم؛ لا يطلب أي وصول مسؤول ويعمل دون خدمة شبكة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les memòries cau d’apps no s’inclouen a la neteja programada. La programació és un LaunchAgent d’usuari; no demana accés d’administrador i s’executa sense cap servei de xarxa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Caches sind von der geplanten Bereinigung ausgenommen. Der Zeitplan ist ein Benutzer-LaunchAgent; er verlangt keinen Administratorzugriff und läuft ohne Netzwerkdienst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App caches are not included in scheduled cleanup. The schedule is a user LaunchAgent; it requests no administrator access and runs without a network service."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App caches are not included in scheduled cleanup. The schedule is a user LaunchAgent; it requests no administrator access and runs without a network service."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App caches are not included in scheduled cleanup. The schedule is a user LaunchAgent; it requests no administrator access and runs without a network service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cachés de apps no se incluyen en la limpieza programada. La programación es un LaunchAgent de usuario; no solicita acceso de administrador y se ejecuta sin servicio de red."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cachés de apps no se incluyen en la limpieza programada. La programación es un LaunchAgent de usuario; no solicita acceso de administrador y se ejecuta sin servicio de red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les caches d’apps ne sont pas inclus dans le nettoyage programmé. La planification est un LaunchAgent utilisateur ; elle ne demande aucun accès administrateur et s’exécute sans service réseau."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Caches sind nöd im planete Ufruume dbi. De Plan isch en Benutzer-LaunchAgent; er verlangt kei Administrator-Zuegriff und lauft ohni Netzwerkdienscht."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप कैश निर्धारित सफ़ाई में शामिल नहीं हैं। यह शेड्यूल एक उपयोगकर्ता LaunchAgent है; यह कोई एडमिनिस्ट्रेटर ऐक्सेस नहीं माँगता और किसी नेटवर्क सेवा के बिना चलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predmemorije aplikacija nisu uključene u zakazano čišćenje. Raspored je korisnički LaunchAgent; ne traži administratorski pristup i radi bez mrežnog servisa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache delle app non sono incluse nella pulizia programmata. La pianificazione è un LaunchAgent utente; non richiede accesso da amministratore e funziona senza un servizio di rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのキャッシュは、スケジュールされたクリーンアップに含まれません。スケジュールはユーザLaunchAgentで、管理者アクセスを要求せず、ネットワークサービスなしで実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 캐시는 예약된 정리에 포함되지 않습니다. 예약은 사용자 LaunchAgent이며, 관리자 접근 권한을 요청하지 않고 네트워크 서비스 없이 실행됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietotņu kešatmiņas nav iekļautas ieplānotajā tīrīšanā. Grafiks ir lietotāja LaunchAgent; tas nepieprasa administratora piekļuvi un darbojas bez tīkla pakalpojuma."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięci podręczne aplikacji nie są objęte zaplanowanym czyszczeniem. Harmonogram to LaunchAgent użytkownika; nie wymaga dostępu administratora i działa bez usługi sieciowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As caches de apps não estão incluídas na limpeza programada. A programação é um LaunchAgent do utilizador; não pede acesso de administrador e é executada sem um serviço de rede."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache-t e aplikacioneve nuk përfshihen në pastrimin e planifikuar. Planifikimi është një LaunchAgent i përdoruesit; nuk kërkon qasje administratori dhe funksionon pa shërbim rrjeti."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кешеви апликација нису укључени у заказано чишћење. Распоред је кориснички LaunchAgent; не захтева администраторски приступ и ради без мрежног сервиса."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keševi aplikacija nisu uključeni u zakazano čišćenje. Raspored je korisnički LaunchAgent; ne zahteva administratorski pristup i radi bez mrežnog servisa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appcachar ingår inte i schemalagd rensning. Schemat är en LaunchAgent för användaren; den begär ingen administratörsåtkomst och körs utan nätverkstjänst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama önbellekleri zamanlanmış temizliğe dahil değildir. Zamanlama bir kullanıcı LaunchAgent’ıdır; yönetici erişimi istemez ve ağ hizmeti olmadan çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 缓存不包含在定时清理中。该计划是用户 LaunchAgent；它不请求管理员权限，也不使用网络服务运行。"
          }
        }
      }
    },
