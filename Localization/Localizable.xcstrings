          "stringUnit" : {
            "state" : "translated",
            "value" : "एक नज़र में देखें कि आपके Mac में जगह है या नहीं, और चुनें क्या बंद करना है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na prvi pogled vidi ima li tvoj Mac prostora i odaberi što zatvoriti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi a colpo d'occhio se il tuo Mac ha spazio, e scegli cosa chiudere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macに余裕があるかをひと目で確認し、閉じるものを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 여유가 있는지 한눈에 보고, 닫을 항목을 선택하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ātri redzi, vai tavā Mac ir vieta, un izvēlies, ko aizvērt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz od razu, czy Twój Mac ma miejsce, i wybierz, co zamknąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja de relance se o seu Mac tem espaço e escolha o que fechar."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shih me një vështrim nëse Mac-u yt ka vend dhe zgjidh çfarë do të mbyllësh."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одмах видите да ли ваш Mac има простора и изаберите шта да затворите."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmah vidite da li vaš Mac ima prostora i izaberite šta da zatvorite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se med en blick om din Mac har utrymme och välj vad som ska stängas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’inizde yer olup olmadığını bir bakışta görün ve neyi kapatacağınızı seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一眼看出你的 Mac 是否还有空间，并选择要关闭的内容。"
          }
        }
      }
    },
