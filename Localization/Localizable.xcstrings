    "So far your %@ uses %@ less. iOS can take a while to release more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى الآن يستخدم الـ %1$@ مساحة أقل بمقدار %2$@. قد يستغرق iOS بعض الوقت لتحرير المزيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De moment, l’%1$@ fa servir %2$@ menys. L’iOS pot trigar a alliberar-ne més."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher belegt dein %1$@ %2$@ weniger. iOS kann etwas brauchen, um mehr freizugeben."
