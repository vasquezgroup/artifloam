          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à ce Mac le logiciel Apple qui communique avec les iPhone. Connecter un iPhone dans le Finder une fois l’installe généralement."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uf dem Mac fehlt d Apple-Software, wo mit iPhones redet. Wenn mer einisch en iPhone im Finder verbindet, wird si meischtens installiert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Mac में iPhone से बात करने वाला Apple सॉफ़्टवेयर नहीं है। Finder में एक बार iPhone कनेक्ट करने से आमतौर पर वह इंस्टॉल हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovom Macu nedostaje Appleov softver koji komunicira s iPhoneima. Spajanje iPhonea u Finderu jednom obično ga instalira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A questo Mac manca il software Apple che comunica con gli iPhone. Di solito collegare un iPhone nel Finder una volta lo installa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
