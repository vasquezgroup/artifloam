    "Filesystem free space. macOS may also include purgeable storage in its available-space estimate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساحة الحرة في نظام الملفات. قد يضم macOS أيضًا المساحة القابلة للتفريغ في تقديره للمساحة المتاحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espai lliure del sistema d’arxius. macOS també pot incloure l’emmagatzematge purgable en la seva estimació d’espai disponible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freier Platz im Dateisystem. macOS kann in seine Schätzung des verfügbaren Platzes auch löschbaren Speicher einrechnen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filesystem free space. macOS may also include purgeable storage in its available-space estimate."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filesystem free space. macOS may also include purgeable storage in its available-space estimate."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filesystem free space. macOS may also include purgeable storage in its available-space estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio libre del sistema de archivos. macOS también puede incluir almacenamiento purgable en su estimación de espacio disponible."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio libre del sistema de archivos. macOS también puede incluir almacenamiento purgable en su estimación de espacio disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace libre du système de fichiers. macOS peut aussi inclure le stockage purgeable dans son estimation de l’espace disponible."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freie Platz im Dateisystem. macOS chan i siner Schätzig vom verfüegbare Platz au freigäbbare Speicher mitzelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल सिस्टम की खाली जगह। macOS अपने उपलब्ध-जगह अनुमान में पर्ज होने योग्य स्टोरेज भी शामिल कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slobodan prostor datotečnog sustava. macOS u procjenu dostupnog prostora može uključiti i prostor koji se može osloboditi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio libero del filesystem. macOS può includere nella stima dello spazio disponibile anche lo spazio recuperabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルシステムの空き容量。macOSは、利用可能な容量の見積もりにパージ可能なストレージも含める場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 시스템의 여유 공간. macOS는 사용 가능 공간 추정치에 제거 가능 저장 공간도 포함할 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failu sistēmas brīvā vieta. macOS pieejamās vietas aprēķinā var iekļaut arī atbrīvojamo krātuvi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolne miejsce w systemie plików. macOS może też wliczać miejsce możliwe do zwolnienia w swoim szacunku dostępnego miejsca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço livre do sistema de ficheiros. O macOS também pode incluir armazenamento purgável na sua estimativa de espaço disponível."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapësira e lirë e sistemit të skedarëve. macOS mund të përfshijë edhe ruajtjen e pastrueshme në vlerësimin e hapësirës së disponueshme."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слободан простор система фајлова. macOS у процену доступног простора може да укључи и меморију која се може ослободити."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slobodan prostor sistema fajlova. macOS u procenu dostupnog prostora može da uključi i memoriju koja se može osloboditi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledigt utrymme i filsystemet. macOS kan även räkna in rensningsbar lagring i sin uppskattning av tillgängligt utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya sistemi boş alanı. macOS, kullanılabilir alan tahmininde boşaltılabilir depolamayı da sayabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件系统可用空间。macOS 估算的可用空间中也可能包含可清除的储存空间。"
          }
        }
      }
    },
    "Filter by full file size and modification date, with results sorted by space stored on this Mac. Nothing is preselected or removed automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفية حسب حجم الملف الكامل وتاريخ التعديل، مع ترتيب النتائج حسب المساحة المخزّنة على هذا الـ Mac. لا يُحدَّد أو يُزال أي شيء تلقائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra per mida completa de l’arxiu i data de modificació, amb els resultats ordenats per l’espai desat en aquest Mac. No hi ha res preseleccionat ni s’elimina automàticament."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtere nach vollständiger Dateigröße und Änderungsdatum; die Ergebnisse sind nach dem auf diesem Mac belegten Platz sortiert. Nichts wird vorausgewählt oder automatisch entfernt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter by full file size and modification date, with results sorted by space stored on this Mac. Nothing is preselected or removed automatically."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter by full file size and modification date, with results sorted by space stored on this Mac. Nothing is preselected or removed automatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter by full file size and modification date, with results sorted by space stored on this Mac. Nothing is preselected or removed automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra por tamaño completo del archivo y fecha de modificación; los resultados se ordenan por el espacio almacenado en este Mac. Nada se preselecciona ni se elimina automáticamente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra por tamaño completo del archivo y fecha de modificación; los resultados se ordenan por el espacio almacenado en esta Mac. Nada se preselecciona ni se elimina automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrez par taille complète du fichier et date de modification, avec les résultats triés par espace stocké sur ce Mac. Rien n’est présélectionné ni retiré automatiquement."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter nach voller Dateigrössi und Änderigsdatum; d Resultat sind nach em Platz sortiert, wo uf dem Mac gspeicheret isch. Es isch nüt vorusgwählt, und es wird nüt automatisch entfernt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे फ़ाइल आकार और बदलाव की तारीख़ से फ़िल्टर करें; नतीजे इस Mac पर संग्रहीत जगह के क्रम में होते हैं। कुछ भी पहले से चुना या अपने आप हटाया नहीं जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtriraj po punoj veličini datoteke i datumu izmjene, a rezultati se sortiraju po prostoru pohranjenom na ovom Macu. Ništa nije unaprijed odabrano niti se uklanja automatski."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtra per dimensione completa del file e data di modifica, con risultati ordinati per spazio occupato su questo Mac. Nulla è preselezionato né rimosso automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの全サイズと更新日で絞り込み、結果はこのMacに保存されている容量順に並べます。自動で選択されたり削除されたりするものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 파일 크기와 수정 날짜로 필터링하며, 결과는 이 Mac에 저장된 공간 순으로 정렬됩니다. 미리 선택되거나 자동으로 제거되는 항목은 없습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrē pēc pilna faila izmēra un izmaiņu datuma, rezultātus kārtojot pēc šajā Mac datorā glabātās vietas. Nekas netiek iepriekš atlasīts vai automātiski noņemts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtruj według pełnego rozmiaru pliku i daty modyfikacji; wyniki są sortowane według miejsca zajmowanego na tym Macu. Nic nie jest zaznaczone z góry ani usuwane automatycznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre pelo tamanho total do ficheiro e pela data de modificação, com resultados ordenados pelo espaço armazenado neste Mac. Nada é pré-selecionado nem removido automaticamente."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtro sipas madhësisë së plotë të skedarit dhe datës së ndryshimit, me rezultate të renditura sipas hapësirës së ruajtur në këtë Mac. Asgjë nuk zgjidhet paraprakisht dhe asgjë nuk hiqet automatikisht."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Филтрирајте по пуној величини фајла и датуму измене, а резултати су поређани по простору сачуваном на овом Mac-у. Ништа није унапред изабрано нити се аутоматски уклања."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrirajte po punoj veličini fajla i datumu izmene, a rezultati su poređani po prostoru sačuvanom na ovom Mac-u. Ništa nije unapred izabrano niti se automatski uklanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrera efter full filstorlek och ändringsdatum, med resultat sorterade efter utrymme som lagras på den här Macen. Inget förvalt eller borttaget automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam dosya boyutuna ve değiştirilme tarihine göre süzün; sonuçlar bu Mac’te saklanan alana göre sıralanır. Hiçbir şey önceden seçilmez veya kendiliğinden kaldırılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按完整文件大小和修改日期筛选，结果按在这台 Mac 上占用的空间排序。不会预先选择或自动移除任何内容。"
          }
        }
      }
    },
    "Filter finding paths" : {
