    "Encrypted backups aren't supported yet. To check yours, select your %@ in Finder and look at Encrypt local backup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخ الاحتياطية المشفّرة غير مدعومة بعد. للتحقق من نسختك، حدّد الـ %@ في Finder وانظر إلى «تشفير النسخة الاحتياطية المحلية»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les còpies de seguretat xifrades encara no són compatibles. Per comprovar la teva, selecciona l’%@ al Finder i mira Xifra la còpia de seguretat local."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselte Backups werden noch nicht unterstützt. Zum Prüfen wähle dein %@ im Finder aus und sieh bei „Lokales Backup verschlüsseln“ nach."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted backups aren't supported yet. To check yours, select your %@ in Finder and look at Encrypt local backup."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted backups aren't supported yet. To check yours, select your %@ in Finder and look at Encrypt local backup."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted backups aren't supported yet. To check yours, select your %@ in Finder and look at Encrypt local backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad cifradas aún no son compatibles. Para comprobar la tuya, selecciona tu %@ en el Finder y mira Cifrar copia de seguridad local."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad cifradas aún no son compatibles. Para comprobar la tuya, selecciona tu %@ en el Finder y mira Cifrar copia de seguridad local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes chiffrées ne sont pas encore prises en charge. Pour vérifier la vôtre, sélectionnez votre %@ dans le Finder et regardez « Chiffrer la sauvegarde locale »."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsseleti Backups werded no nöd unterstützt. Zum Prüefe wähl din %@ im Finder und lueg bi «Lokales Backup verschlüsseln»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एन्क्रिप्ट किए गए बैकअप अभी समर्थित नहीं हैं। अपना बैकअप जाँचने के लिए, Finder में अपना %@ चुनें और “लोकल बैकअप एन्क्रिप्ट करें” देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrirane sigurnosne kopije još nisu podržane. Da provjeriš svoju, odaberi %@ u Finderu i pogledaj Šifriraj lokalnu sigurnosnu kopiju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup cifrati non sono ancora supportati. Per controllare il tuo, seleziona l'%@ nel Finder e guarda Cripta backup locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されたバックアップにはまだ対応していません。確認するには、Finderで%@を選択し、「ローカルのバックアップを暗号化」を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 백업은 아직 지원되지 않습니다. 확인하려면 Finder에서 %@을(를) 선택하고 ‘로컬 백업 암호화’를 확인하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrēti dublējumi vēl netiek atbalstīti. Lai pārbaudītu savu, Finder atlasi savu %@ un skaties Šifrēt vietējo dublējumu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaszyfrowane kopie zapasowe nie są jeszcze obsługiwane. Aby sprawdzić swoją, wybierz urządzenie %@ w Finderze i sprawdź opcję Szyfruj kopię lokalną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups encriptados ainda não são suportados. Para verificar o seu, selecione o %@ no Finder e veja Encriptar cópia de segurança local."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopjet rezervë të enkriptuara nuk mbështeten ende. Për të kontrolluar tëndet, zgjidh %@ në Finder dhe shiko Enkripto kopjen rezervë lokale."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифроване резервне копије још нису подржане. Да проверите своју, изаберите %@ у Finder-у и погледајте Шифруј локалну резервну копију."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrovane rezervne kopije još nisu podržane. Da proverite svoju, izaberite %@ u Finder-u i pogledajte Šifruj lokalnu rezervnu kopiju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypterade säkerhetskopior stöds inte ännu. Kontrollera din genom att markera din %@ i Finder och titta på Kryptera lokal säkerhetskopia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifrelenmiş yedekler henüz desteklenmiyor. Kendinizinkini denetlemek için Finder’da %@ cihazınızı seçin ve Yerel yedeği şifrele’ye bakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不支持加密备份。若要检查你的备份，请在访达中选择 %@，然后查看“加密本地备份”。"
          }
        }
      }
    },
    "Enter your passcode on the %@. Artifloam continues by itself as soon as it's unlocked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
