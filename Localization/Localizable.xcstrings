    "%@ is ignored by Git, so it can't be restored. It will be deleted permanently." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ يتجاهله Git، لذا لا يمكن استرجاعه. سيُحذف نهائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ignora %@, així que no es pot restaurar. S’esborrarà definitivament."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von Git ignoriert und kann nicht wiederhergestellt werden. Es wird endgültig gelöscht."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is ignored by Git, so it can't be restored. It will be deleted permanently."
