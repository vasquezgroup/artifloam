    "Photos that look out of focus. Calm scenes like a clear sky can appear here, so check them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صور تبدو غير واضحة. قد تظهر هنا مشاهد هادئة مثل السماء الصافية، لذا تحقق منها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos que semblen desenfocades. Aquí poden aparèixer escenes tranquil·les, com un cel serè, així que revisa-les."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, die unscharf wirken. Ruhige Motive wie ein klarer Himmel können hier erscheinen, prüfe sie also."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos that look out of focus. Calm scenes like a clear sky can appear here, so check them."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos that look out of focus. Calm scenes like a clear sky can appear here, so check them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos that look out of focus. Calm scenes like a clear sky can appear here, so check them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos que se ven desenfocadas. Aquí pueden aparecer escenas tranquilas, como un cielo despejado, así que revísalas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos que se ven desenfocadas. Aquí pueden aparecer escenas tranquilas, como un cielo despejado, así que revísalas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos qui semblent floues. Des scènes calmes, comme un ciel dégagé, peuvent apparaître ici ; vérifiez-les."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foti, wo unscharf wirked. Ruhigi Motiv wie en klare Himmel chönd do erschiine, prüef si also."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो जो फ़ोकस से बाहर दिखती हैं। साफ़ आसमान जैसे शांत दृश्य यहाँ आ सकते हैं, इसलिए उन्हें जाँच लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije koje izgledaju nefokusirano. Mirni prizori poput vedrog neba mogu se pojaviti ovdje, pa ih provjeri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto che sembrano sfocate. Qui possono comparire anche scene tranquille, come un cielo sereno, quindi controllale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピントが合っていないように見える写真です。晴れた空のような穏やかなシーンも含まれることがあるので、確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 맞지 않아 보이는 사진입니다. 맑은 하늘처럼 잔잔한 장면도 포함될 수 있으니 확인하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto, kas izskatās nefokusēti. Šeit var parādīties mierīgi kadri, piemēram, skaidras debesis, tāpēc pārbaudi tos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia, które wyglądają na nieostre. Spokojne sceny, np. czyste niebo, mogą się tu pojawić, więc je sprawdź."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos que parecem desfocadas. Cenas calmas, como um céu limpo, podem aparecer aqui, por isso verifique-as."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto që duken jashtë fokusit. Skena të qeta si një qiell i kthjellët mund të shfaqen këtu, ndaj kontrollo ato."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографије које изгледају нефокусирано. Мирни призори као ведро небо могу се појавити овде, па их проверите."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije koje izgledaju nefokusirano. Mirni prizori kao vedro nebo mogu se pojaviti ovde, pa ih proverite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foton som ser oskarpa ut. Lugna motiv som en klar himmel kan dyka upp här, så kontrollera dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odak dışı görünen fotoğraflar. Açık gökyüzü gibi sakin sahneler burada görünebilir, bu yüzden kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来没有对焦的照片。晴朗天空等平静的场景也可能出现在这里，请仔细检查。"
          }
        }
      }
    },
