    "Homebrew's download cache, unused for at least 30 days. Installed formulae stay; Homebrew downloads again when needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذاكرة التنزيل المؤقتة لـ Homebrew، غير المستخدمة منذ 30 يومًا على الأقل. تبقى formulae المثبّتة؛ ينزّل Homebrew مجددًا عند الحاجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memòria cau de baixades de Homebrew, sense usar durant almenys 30 dies. Les fórmules instal·lades es queden; Homebrew les torna a baixar quan cal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download-Cache von Homebrew, seit mindestens 30 Tagen unbenutzt. Installierte Formulae bleiben erhalten; Homebrew lädt bei Bedarf erneut herunter."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew's download cache, unused for at least 30 days. Installed formulae stay; Homebrew downloads again when needed."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew's download cache, unused for at least 30 days. Installed formulae stay; Homebrew downloads again when needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew's download cache, unused for at least 30 days. Installed formulae stay; Homebrew downloads again when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché de descargas de Homebrew, sin usar desde hace al menos 30 días. Las fórmulas instaladas se conservan; Homebrew vuelve a descargar cuando hace falta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché de descargas de Homebrew, sin usar desde hace al menos 30 días. Las fórmulas instaladas se conservan; Homebrew vuelve a descargar cuando hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache de téléchargement de Homebrew, inutilisé depuis au moins 30 jours. Les formules installées restent ; Homebrew les télécharge à nouveau en cas de besoin."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download-Cache vo Homebrew, wo mindestens 30 Täg nöd bruucht worde isch. Installierti Formulae blibed; Homebrew ladt bi Bedarf neu abe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew का डाउनलोड कैश, कम से कम 30 दिनों से अनुपयोगी। इंस्टॉल किए गए फ़ॉर्मूला रहते हैं; ज़रूरत पड़ने पर Homebrew फिर डाउनलोड करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewova predmemorija preuzimanja, nekorištena najmanje 30 dana. Instalirane formule ostaju; Homebrew ponovno preuzima kad zatreba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache dei download di Homebrew, non usata da almeno 30 giorni. Le formule installate restano; Homebrew scarica di nuovo quando serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewのダウンロードキャッシュ。少なくとも30日間使われていません。インストール済みのformulaeは残り、必要なときにHomebrewが再度ダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 30일 동안 사용하지 않은 Homebrew 다운로드 캐시. 설치된 formula는 유지되며, 필요하면 Homebrew가 다시 다운로드합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew lejupielādes kešatmiņa, nelietota vismaz 30 dienas. Uzstādītās formulas paliek; Homebrew lejupielādē vēlreiz, kad vajag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć podręczna pobrań Homebrew, nieużywana od co najmniej 30 dni. Zainstalowane formuły zostają; Homebrew pobiera je ponownie w razie potrzeby."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache de descargas do Homebrew, não usada há pelo menos 30 dias. As fórmulas instaladas ficam; o Homebrew volta a descarregar quando necessário."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache e shkarkimeve të Homebrew, e papërdorur për të paktën 30 ditë. Formulat e instaluara mbeten; Homebrew shkarkon përsëri kur nevojitet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew-ов кеш преузимања, који се не користи најмање 30 дана. Инсталиране formulae остају; Homebrew поново преузима када затреба."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew-ov keš preuzimanja, koji se ne koristi najmanje 30 dana. Instalirane formulae ostaju; Homebrew ponovo preuzima kada zatreba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrews nedladdningscache, oanvänd i minst 30 dagar. Installerade formulae finns kvar; Homebrew hämtar igen vid behov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew’un indirme önbelleği, en az 30 gündür kullanılmamış. Kurulu formüller kalır; Homebrew gerektiğinde yeniden indirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 的下载缓存，至少 30 天未使用。已安装的 formula 会保留；需要时 Homebrew 会重新下载。"
          }
        }
      }
    },
