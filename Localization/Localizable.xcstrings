    "12:15 local time, as your signed-in user. Install in Applications first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 بالتوقيت المحلي، بصفتك المستخدم المسجَّل دخوله. ثبّت التطبيق في التطبيقات أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A les 12:15 hora local, com a l’usuari amb la sessió iniciada. Instal·la-ho primer a Apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 Ortszeit, als dein angemeldeter Benutzer. Installiere die App zuerst in „Apps“."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 local time, as your signed-in user. Install in Applications first."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 local time, as your signed-in user. Install in Applications first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 local time, as your signed-in user. Install in Applications first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15, hora local, como el usuario con la sesión iniciada. Instala primero en Aplicaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15, hora local, como el usuario con la sesión iniciada. Instala primero en Apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15, heure locale, avec votre compte utilisateur connecté. Installez-la d’abord dans Applications."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 Ortsziit, als din aagmäldete Benutzer. Installier zerscht im Ordner «Apps»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 स्थानीय समय पर, आपके साइन-इन उपयोगकर्ता के रूप में। पहले ऐप्लिकेशन में इंस्टॉल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 po lokalnom vremenu, kao prijavljeni korisnik. Prvo instaliraj u Aplikacije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 ora locale, come utente connesso. Installa prima in Applicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル時間の12:15に、ログイン中のユーザとして実行されます。先に「アプリケーション」にインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현지 시간 12:15, 로그인한 사용자로 실행됩니다. 먼저 응용 프로그램 폴더에 설치하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plkst. 12:15 pēc vietējā laika, kā pieteiktais lietotājs. Vispirms uzstādi mapē Lietotnes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 czasu lokalnego, jako zalogowany użytkownik. Najpierw zainstaluj w folderze Aplikacje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15, hora local, como o utilizador com sessão iniciada. Instale primeiro em Aplicações."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 sipas orës lokale, si përdoruesi yt i identifikuar. Instalo më parë te Applications."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 по локалном времену, као ваш пријављени корисник. Прво инсталирајте у Апликације."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 po lokalnom vremenu, kao vaš prijavljeni korisnik. Prvo instalirajte u Aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12:15 lokal tid, som din inloggade användare. Installera först i mappen Appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel saatle 12:15, oturum açmış kullanıcınız olarak. Önce Uygulamalar’a kurun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当地时间 12:15，以当前登录的用户身份运行。请先安装到“应用程序”中。"
          }
        }
      }
    },
