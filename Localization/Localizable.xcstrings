          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la foto con su fecha y lugar, y quita el vídeo corto. Los tamaños muestran lo que ahorrarías."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la foto con su fecha y lugar, y quita el video corto. Los tamaños muestran lo que ahorrarías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve la photo avec sa date et son lieu, et retire la courte vidéo. Les tailles indiquent ce que vous économiseriez."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet s Foto mit Datum und Ort und entfernt s churze Video. D Grössine zeiged, was du chönntsch spare."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो को उसकी तारीख़ और जगह के साथ रखता है, और छोटा वीडियो हटा देता है। आकार दिखाते हैं कि आप कितना बचाएँगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržava fotografiju s datumom i mjestom, a uklanja kratki videozapis. Veličine pokazuju koliko bi uštedio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la foto con data e luogo e rimuove il breve video. Le dimensioni mostrano quanto risparmieresti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付と場所を含む写真は残し、短いビデオを削除します。サイズは節約できる容量を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜와 위치가 있는 사진은 유지하고 짧은 비디오는 제거합니다. 표시된 크기는 절약할 수 있는 용량입니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patur foto ar tā datumu un vietu un noņem īso video. Izmēri rāda, cik ietaupīsi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje zdjęcie z datą i miejscem, a usuwa krótki film. Rozmiary pokazują, ile zaoszczędzisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a foto com a data e o local, e remove o vídeo curto. Os tamanhos mostram o que pouparia."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mban fotografinë me datën dhe vendin e saj dhe heq videon e shkurtër. Madhësitë tregojnë sa do të kursesh."
          }
        },
        "sr-Cyrl" : {
