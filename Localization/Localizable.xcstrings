    "CPU use is measured between samples. Thermal state comes from macOS; no guessed temperature is displayed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقاس استخدام CPU بين العيّنات. تأتي الحالة الحرارية من macOS؛ ولا تُعرض أي درجة حرارة مُخمَّنة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ús de la CPU es mesura entre mostres. L’estat tèrmic ve de macOS; no es mostra cap temperatura suposada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die CPU-Auslastung wird zwischen Stichproben gemessen. Der thermische Zustand kommt von macOS; es wird keine geschätzte Temperatur angezeigt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU use is measured between samples. Thermal state comes from macOS; no guessed temperature is displayed."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU use is measured between samples. Thermal state comes from macOS; no guessed temperature is displayed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU use is measured between samples. Thermal state comes from macOS; no guessed temperature is displayed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uso de la CPU se mide entre muestras. El estado térmico procede de macOS; no se muestra ninguna temperatura estimada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uso de la CPU se mide entre muestras. El estado térmico procede de macOS; no se muestra ninguna temperatura estimada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utilisation du CPU est mesurée entre les échantillons. L’état thermique vient de macOS ; aucune température estimée n’est affichée."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D CPU-Uslastig wird zwüsche Messige gmässe. De thermische Zuestand chunnt vo macOS; es wird kei gschätzti Temperatur azeigt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU उपयोग सैंपल के बीच मापा जाता है। थर्मल स्थिति macOS से आती है; कोई अनुमानित तापमान नहीं दिखाया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korištenje CPU-a mjeri se između uzoraka. Toplinsko stanje dolazi iz macOS-a; ne prikazuje se pogođena temperatura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'uso della CPU è misurato tra un campione e l'altro. Lo stato termico viene da macOS; non viene mostrata nessuna temperatura stimata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU使用率はサンプル間で計測されます。熱の状態はmacOSから取得したもので、推測した温度は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 사용량은 샘플 간격으로 측정합니다. 열 상태는 macOS에서 가져오며, 추측한 온도는 표시하지 않습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU izmantojums tiek mērīts starp paraugiem. Termiskais stāvoklis nāk no macOS; uzminēta temperatūra netiek rādīta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użycie CPU jest mierzone między próbkami. Stan termiczny pochodzi z macOS; nie jest wyświetlana żadna zgadywana temperatura."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A utilização do CPU é medida entre amostras. O estado térmico vem do macOS; não é apresentada nenhuma temperatura estimada."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përdorimi i CPU matet midis mostrave. Gjendja termike vjen nga macOS; nuk shfaqet asnjë temperaturë e hamendësuar."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коришћење CPU-а се мери између узорака. Термичко стање долази из macOS-а; не приказује се нагађана температура."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korišćenje CPU-a se meri između uzoraka. Termičko stanje dolazi iz macOS-a; ne prikazuje se nagađana temperatura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU-användning mäts mellan stickprov. Termiskt tillstånd kommer från macOS; ingen gissad temperatur visas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU kullanımı örnekler arasında ölçülür. Isıl durum macOS’tan gelir; tahmini sıcaklık gösterilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 使用率在两次采样之间测量。热状态来自 macOS；不会显示猜测的温度。"
          }
        }
      }
    },
