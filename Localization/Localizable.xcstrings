    "Open browsers are skipped; quit a browser first to clean it. Caches are rebuilt automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخطي المتصفحات المفتوحة؛ أنهِ المتصفح أولًا لتنظيفه. تُعاد بناء الذاكرات المؤقتة تلقائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els navegadors oberts s’ometen; tanca un navegador primer per netejar-lo. Les memòries cau es tornen a crear automàticament."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geöffnete Browser werden übersprungen; beende einen Browser zuerst, um ihn zu bereinigen. Caches werden automatisch neu aufgebaut."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open browsers are skipped; quit a browser first to clean it. Caches are rebuilt automatically."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open browsers are skipped; quit a browser first to clean it. Caches are rebuilt automatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open browsers are skipped; quit a browser first to clean it. Caches are rebuilt automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los navegadores abiertos se omiten; cierra un navegador antes de limpiarlo. Las cachés se reconstruyen automáticamente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los navegadores abiertos se omiten; cierra un navegador antes de limpiarlo. Las cachés se reconstruyen automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les navigateurs ouverts sont ignorés ; quittez d’abord un navigateur pour le nettoyer. Les caches sont recréés automatiquement."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offeni Browser werded übersprunge; beände en Browser zerscht, zum ne ufzruume. Caches werded automatisch neu ufbaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुले ब्राउज़र छोड़ दिए जाते हैं; किसी ब्राउज़र को साफ़ करने के लिए पहले उसे बंद करें। कैश अपने आप दोबारा बन जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoreni preglednici se preskaču; prvo zatvori preglednik da ga očistiš. Predmemorije se automatski ponovno grade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I browser aperti vengono saltati; chiudi prima un browser per pulirlo. Le cache vengono ricostruite automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いているブラウザはスキップされます。クリーンアップするには、先にブラウザを終了してください。キャッシュは自動で再作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열려 있는 브라우저는 건너뜁니다. 정리하려면 먼저 브라우저를 종료하세요. 캐시는 자동으로 다시 만들어집니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atvērtie pārlūki tiek izlaisti; lai pārlūku notīrītu, vispirms aizver to. Kešatmiņas tiek izveidotas automātiski no jauna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwarte przeglądarki są pomijane; aby ją wyczyścić, najpierw zakończ przeglądarkę. Pamięci podręczne są odbudowywane automatycznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os navegadores abertos são ignorados; saia de um navegador primeiro para o limpar. As caches são recriadas automaticamente."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shfletuesit e hapur anashkalohen; mbyll një shfletues së pari për ta pastruar. Cache-t rindërtohen automatikisht."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворени прегледачи се прескачу; прво затворите прегледач да бисте га очистили. Кешеви се аутоматски поново праве."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoreni pregledači se preskaču; prvo zatvorite pregledač da biste ga očistili. Keševi se automatski ponovo prave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna webbläsare hoppas över; avsluta en webbläsare först för att rensa den. Cachar byggs upp igen automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık tarayıcılar atlanır; temizlemek için önce tarayıcıdan çıkın. Önbellekler kendiliğinden yeniden oluşturulur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已打开的浏览器会被跳过；请先退出浏览器再清理它。缓存会自动重新生成。"
          }
        }
      }
    },
    "Open in %@. They keep running, but lose this folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
