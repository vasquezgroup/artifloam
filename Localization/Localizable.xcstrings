    "Git is unavailable. Git-dependent caches remain protected and worktree checks are skipped; install Git or Command Line Tools to enable verification." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git غير متاح. تبقى الذاكرات المؤقتة المعتمدة على Git محمية ويتم تخطي فحوصات worktree؛ ثبّت Git أو Command Line Tools لتفعيل التحقق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git no està disponible. Les memòries cau que depenen de Git continuen protegides i s’ometen les comprovacions de worktrees; instal·la Git o les Eines de línia d’ordres per activar la verificació."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ist nicht verfügbar. Von Git abhängige Caches bleiben geschützt, und Worktree-Prüfungen werden übersprungen; installiere Git oder die Command Line Tools, um die Prüfung zu ermöglichen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
