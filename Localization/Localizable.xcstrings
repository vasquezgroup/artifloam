    "What starts with your Mac. Removing a login item keeps the app, and an agent you switch off can be switched on again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يبدأ مع الـ Mac. إزالة عنصر تسجيل الدخول تُبقي التطبيق، ويمكن إعادة تشغيل وكيل أوقفته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Què s’inicia amb el Mac. Eliminar un ítem d’inici de sessió conserva l’app, i un agent que desactivis es pot tornar a activar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was mit deinem Mac startet. Wenn du ein Anmeldeobjekt entfernst, bleibt die App erhalten, und einen Agenten, den du ausschaltest, kannst du wieder einschalten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What starts with your Mac. Removing a login item keeps the app, and an agent you switch off can be switched on again."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What starts with your Mac. Removing a login item keeps the app, and an agent you switch off can be switched on again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What starts with your Mac. Removing a login item keeps the app, and an agent you switch off can be switched on again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que se inicia con tu Mac. Quitar un ítem de inicio conserva la app, y un agente que desactives se puede volver a activar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que se inicia con tu Mac. Quitar un elemento de inicio conserva la app, y un agente que desactives se puede volver a activar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui démarre avec votre Mac. Retirer un élément d’ouverture conserve l’app, et un agent que vous désactivez peut être réactivé."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was mit dim Mac startet. Wenn du es Anmeldeobjekt entfernsch, blibt d App erhalte, und en Agent, wo du uusschaltisch, cha wieder iigschaltet werde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके Mac के साथ क्या शुरू होता है। लॉगइन आइटम हटाने पर ऐप बना रहता है, और बंद किया गया एजेंट फिर चालू किया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Što se pokreće s tvojim Macom. Uklanjanjem stavke za prijavu aplikacija ostaje, a agent koji isključiš može se ponovno uključiti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa si avvia con il Mac. Rimuovere un elemento login non rimuove l'app, e un agente che disattivi si può riattivare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macとともに起動するもの。ログイン項目を削除してもアプリは残り、オフにしたエージェントは再びオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac과 함께 시작되는 항목. 로그인 항목을 제거해도 앱은 유지되며, 꺼 둔 에이전트는 다시 켤 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas startē kopā ar Mac. Noņemot pieteikšanās vienumu, lietotne paliek, un izslēgtu aģentu var ieslēgt atkal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co uruchamia się z Macem. Usunięcie elementu logowania nie usuwa aplikacji, a wyłączonego agenta można włączyć ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que inicia com o Mac. Remover um item de início de sessão mantém a app, e um agente que desative pode ser ativado novamente."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çfarë nis bashkë me Mac-un tënd. Heqja e një elementi të hyrjes e mban aplikacionin, dhe një agjent që e çaktivizon mund të aktivizohet përsëri."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шта се покреће са вашим Mac-ом. Уклањање ставке за пријављивање задржава апликацију, а агент који искључите може се поново укључити."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šta se pokreće sa vašim Mac-om. Uklanjanje stavke za prijavljivanje zadržava aplikaciju, a agent koji isključite može se ponovo uključiti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som startar med din Mac. Om du tar bort ett startobjekt finns appen kvar, och en agent som du stänger av kan slås på igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’inizle nelerin başladığı. Oturum açma öğesini kaldırsanız da uygulama yerinde kalır ve kapattığınız bir ajan yeniden açılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随 Mac 启动的内容。移除登录项会保留该 App，而你关闭的代理可以再次打开。"
