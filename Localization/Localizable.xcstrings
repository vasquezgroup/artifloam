    "%lld folders are not included in this total, because macOS keeps folder sizes private. With Full Disk Access, Artifloam can measure them." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld مجلدات غير مشمول في هذا الإجمالي لأن macOS يُبقي أحجام المجلدات خاصة. مع الوصول الكامل إلى القرص، يستطيع Artifloam قياسها."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld مجلدًا غير مشمول في هذا الإجمالي لأن macOS يُبقي أحجام المجلدات خاصة. مع الوصول الكامل إلى القرص، يستطيع Artifloam قياسها."
                }
              },
              "one" : {
