    "The app and everything stored in it on this %@: downloads, settings and anything not synced. This can't be undone from Artifloam." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق وكل ما هو مخزّن فيه على هذا الـ %@: التنزيلات والإعدادات وكل ما لم تتم مزامنته. لا يمكن التراجع عن هذا من Artifloam."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app i tot el que hi ha desat en aquest %@: baixades, ajustos i tot el que no està sincronitzat. Això no es pot desfer des d’Artifloam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App und alles, was auf diesem %@ darin gespeichert ist: Downloads, Einstellungen und alles Nicht-Synchronisierte. Das lässt sich in Artifloam nicht widerrufen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
