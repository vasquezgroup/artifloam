        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njegova najnovija sigurnosna kopija stara je više od mjesec dana ili je nema. Na %@u: Postavke, tvoje ime, iCloud, iCloud sigurnosna kopija, Izradi sigurnosnu kopiju sada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup più recente ha più di un mese, oppure non ce n'è. Su %@: Impostazioni, il tuo nome, iCloud, Backup iCloud, Esegui backup adesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のバックアップが1か月以上前か、バックアップがありません。%@で、設定、ご自分の名前、iCloud、iCloudバックアップ、今すぐバックアップを作成の順に選択してください。"
