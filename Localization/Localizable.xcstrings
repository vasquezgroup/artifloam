    "Unlock your %@ and tap Trust. If nothing appears, select it in Finder once, then press Read again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح قفل الـ %@ واضغط على «ثقة». إذا لم يظهر شيء، فحدّده في Finder مرة واحدة، ثم اضغط «قراءة» مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueja l’%@ i toca Confia. Si no apareix res, selecciona’l una vegada al Finder i torna a fer clic a Llegeix."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre dein %@ und tippe auf „Vertrauen“. Erscheint nichts, wähle es einmal im Finder aus und drücke dann erneut auf „Lesen“."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock your %@ and tap Trust. If nothing appears, select it in Finder once, then press Read again."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock your %@ and tap Trust. If nothing appears, select it in Finder once, then press Read again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock your %@ and tap Trust. If nothing appears, select it in Finder once, then press Read again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea tu %@ y toca Confiar. Si no aparece nada, selecciónalo una vez en el Finder y vuelve a pulsar Leer."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea tu %@ y toca Confiar. Si no aparece nada, selecciónalo una vez en el Finder y vuelve a presionar Leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez votre %@ et touchez Se fier. Si rien n’apparaît, sélectionnez-le une fois dans le Finder, puis cliquez de nouveau sur Lire."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperr din %@ und tipp uf «Vertraue». Erschiint nüt, wähl en einisch im Finder uus und drück denn nomal uf «Läse»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना %@ अनलॉक करें और “भरोसा करें” पर टैप करें। अगर कुछ न दिखे, तो Finder में उसे एक बार चुनें, फिर “पढ़ें” फिर दबाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otključaj %@ i dodirni Vjeruj. Ako se ništa ne pojavi, jednom ga odaberi u Finderu, zatim ponovno pritisni Čitaj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca l'%@ e tocca Autorizza. Se non appare nulla, selezionalo una volta nel Finder, poi premi di nuovo Leggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のロックを解除して、「信頼」をタップしてください。何も表示されない場合は、Finderで一度%1$@を選択してから、もう一度「読み取り」を押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 잠금을 해제하고 ‘신뢰’를 탭하세요. 아무것도 나타나지 않으면 Finder에서 %1$@을(를) 한 번 선택한 다음 ‘읽기’를 다시 누르세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atbloķē %@ un pieskaries Uzticēties. Ja nekas neparādās, vienreiz atlasi to Finder, pēc tam vēlreiz nospied Lasīt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuj urządzenie %@ i stuknij Ufaj. Jeśli nic się nie pojawi, wybierz je raz w Finderze, a potem ponownie naciśnij Odczytaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie o %@ e toque em Confiar. Se não aparecer nada, selecione-o uma vez no Finder e prima Ler novamente."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çele %@ dhe trokit Beso. Nëse nuk shfaqet asgjë, zgjidhe një herë në Finder, pastaj shtyp Lexo përsëri."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откључајте %@ и додирните Веруј. Ако се ништа не појави, једном га изаберите у Finder-у, па поново притисните Читај."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otključajte %@ i dodirnite Veruj. Ako se ništa ne pojavi, jednom ga izaberite u Finder-u, pa ponovo pritisnite Čitaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås upp din %@ och tryck på Lita på. Om inget visas, markera den en gång i Finder och tryck sedan på Läs igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cihazınızın kilidini açın ve Güven’e dokunun. Hiçbir şey görünmezse Finder’da bir kez seçin, ardından yeniden Oku’ya basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁 %@ 并轻点“信任”。如果没有出现提示，请在访达中选择它一次，然后再次点按“读取”。"
          }
        }
      }
    },
