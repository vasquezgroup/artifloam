    "Largest first. Videos in iCloud may free less on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأكبر أولًا. قد تحرّر مقاطع الفيديو في iCloud مساحة أقل على هذا الجهاز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer els més grans. Els vídeos de l’iCloud poden alliberar menys espai en aquest dispositiu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die größten zuerst. Videos in iCloud geben auf diesem Gerät eventuell weniger Platz frei."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largest first. Videos in iCloud may free less on this device."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largest first. Videos in iCloud may free less on this device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largest first. Videos in iCloud may free less on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero los más grandes. Los vídeos de iCloud pueden liberar menos espacio en este dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero los más grandes. Los videos de iCloud pueden liberar menos espacio en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plus volumineuses d’abord. Les vidéos dans iCloud peuvent libérer moins d’espace sur cet appareil."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di gröschte zersch. Videos i iCloud gäbed uf dem Gerät eventuell weniger Platz frei."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे बड़े पहले। iCloud में मौजूद वीडियो इस डिवाइस पर कम जगह खाली कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najveće prvo. Videozapisi na iCloudu mogu osloboditi manje prostora na ovom uređaju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima i più grandi. I video in iCloud potrebbero liberare meno spazio su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きい順。iCloud上のビデオは、このデバイスで解放できる容量が少ない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 항목 순. iCloud에 있는 비디오는 이 기기에서 확보되는 공간이 더 적을 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vispirms lielākie. Video iCloud var atbrīvot mazāk vietas šajā ierīcē."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw największe. Filmy w iCloud mogą zwolnić mniej miejsca na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os maiores primeiro. Os vídeos no iCloud podem libertar menos espaço neste dispositivo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fillimisht më të mëdhatë. Videot në iCloud mund të çlirojnë më pak hapësirë në këtë pajisje."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Највеће прво. Видео записи на iCloudу могу ослободити мање простора на овом уређају."
          }
        },
        "sr-Latn" : {
