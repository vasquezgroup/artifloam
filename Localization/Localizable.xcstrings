    "System Integrity Protection is off. This is usually done on purpose by developers; it can only be turned on again from Recovery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection متوقفة. يفعل المطوّرون ذلك عادةً عن قصد؛ ولا يمكن تشغيلها مجددًا إلا من وضع الاسترداد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protecció de la integritat del sistema està desactivada. Normalment els desenvolupadors ho fan a propòsit; només es pot tornar a activar des de la Recuperació."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Systemintegritätsschutz ist aus. Entwickler tun das meist absichtlich; er lässt sich nur über den Wiederherstellungsmodus wieder einschalten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection is off. This is usually done on purpose by developers; it can only be turned on again from Recovery."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection is off. This is usually done on purpose by developers; it can only be turned on again from Recovery."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection is off. This is usually done on purpose by developers; it can only be turned on again from Recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protección de integridad del sistema está desactivada. Los desarrolladores suelen hacerlo a propósito; solo se puede volver a activar desde Recuperación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protección de integridad del sistema está desactivada. Los desarrolladores suelen hacerlo a propósito; solo se puede volver a activar desde Recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protection de l’intégrité du système est désactivée. Les développeurs le font souvent exprès ; elle ne peut être réactivée que depuis la Récupération."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection isch uusgschaltet. Das mached Entwickler meistens mit Absicht; es cha nume über Recovery wieder iigschaltet werde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection बंद है। यह आमतौर पर डेवलपर जान-बूझकर करते हैं; इसे केवल Recovery से दोबारा चालू किया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection je isključen. To developeri obično rade namjerno; ponovno se može uključiti samo iz Recoveryja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection è disattivata. Di solito la disattivano di proposito gli sviluppatori; si può riattivare solo da Recovery."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム整合性保護がオフです。これは通常、開発者が意図的に行います。リカバリからのみ、再びオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 무결성 보호가 꺼져 있습니다. 보통 개발자가 의도적으로 끈 것이며, 복구 모드에서만 다시 켤 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection ir izslēgta. To parasti apzināti dara izstrādātāji; to var ieslēgt atkal tikai no Recovery."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ochrona integralności systemu jest wyłączona. Zwykle robią to celowo deweloperzy; można ją włączyć ponownie tylko z poziomu Odzyskiwania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Proteção da Integridade do Sistema está desativada. Normalmente isto é feito de propósito por programadores; só pode voltar a ser ativada a partir do modo de Recuperação."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbrojtja e integritetit të sistemit është çaktivizuar. Zakonisht kjo bëhet me qëllim nga zhvilluesit; mund të aktivizohet përsëri vetëm nga Recovery."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection је искључен. Програмери то обично раде намерно; може се поново укључити само из Recovery режима."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection je isključen. Programeri to obično rade namerno; može se ponovo uključiti samo iz Recovery režima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Integrity Protection är av. Utvecklare gör ofta detta med avsikt; det kan bara slås på igen från Recovery."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Bütünlüğü Koruması kapalı. Bu genellikle geliştiriciler tarafından bilerek yapılır; yalnızca Kurtarma’dan yeniden açılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统完整性保护已关闭。开发者通常是有意这样做的；只能在恢复模式下重新打开。"
          }
        }
      }
    },
