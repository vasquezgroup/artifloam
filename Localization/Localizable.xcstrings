          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई फ़ोल्डर नहीं चुना गया, इसलिए डुप्लिकेट खोज छोड़ दी गई। चुनने के लिए टूल > डुप्लिकेट खोलें। बाकी जाँचें पूरी हैं।"
