          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld개를 휴지통으로 이동함 · %2$lld개 건너뜀. Finder에서 ‘되돌려 놓기’로 항목을 복원하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
