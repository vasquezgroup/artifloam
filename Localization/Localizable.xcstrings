          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a %@ una petición normal de Salir. Puede pedirte que guardes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a %@ una petición normal de Salir. Puede pedirte que guardes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie à %@ une demande de quitter normale. L’app peut vous demander d’enregistrer."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt %@ es normals «Beenden». Es fraagt di evtl., ob du speichere wotsch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को सामान्य बंद करने का अनुरोध भेजता है। यह आपसे सहेजने को कह सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šalje %@ uobičajeno zatvaranje. Možda će tražiti da spremiš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia a %@ un normale Esci. Potrebbe chiederti di salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に通常の「終了」を送ります。保存を求められる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 일반 종료를 보냅니다. 저장하라는 메시지가 표시될 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosūta %@ parastu komandu Aizvērt. Tā var palūgt saglabāt darbu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła do %@ zwykłe polecenie Zakończ. Może zapytać o zapisanie zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia a %@ um pedido normal para sair. Pode pedir-lhe para guardar."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dërgon %@ një Mbyll normal. Mund të të kërkojë të ruash."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаље %@ уобичајен захтев за затварање. Може тражити да сачувате."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šalje %@ uobičajen zahtev za zatvaranje. Može tražiti da sačuvate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickar ett vanligt Avsluta till %@. Den kan be dig spara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal bir Çık isteği gönderir: %@. Kaydetmenizi isteyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 %@ 发送正常的“退出”请求。它可能会要求你存储。"
          }
        }
      }
    },
