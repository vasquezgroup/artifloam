    "Deleted items stay in Recently Deleted for about 30 days. With iCloud Photos they leave all your devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى العناصر المحذوفة في «المحذوفة مؤخرًا» لمدة 30 يومًا تقريبًا. وعند استخدام صور iCloud تُحذف من كل أجهزتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els elements esborrats es queden a Eliminats recentment uns 30 dies. Amb Fotos de l’iCloud desapareixen de tots els teus dispositius."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Objekte bleiben etwa 30 Tage in „Zuletzt gelöscht“. Mit iCloud-Fotos verschwinden sie von allen deinen Geräten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted items stay in Recently Deleted for about 30 days. With iCloud Photos they leave all your devices."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted items stay in Recently Deleted for about 30 days. With iCloud Photos they leave all your devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted items stay in Recently Deleted for about 30 days. With iCloud Photos they leave all your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos borrados permanecen en Eliminados recientemente unos 30 días. Con Fotos de iCloud, desaparecen de todos tus dispositivos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos borrados permanecen en Eliminados recientemente unos 30 días. Con Fotos de iCloud, desaparecen de todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments supprimés restent dans Supprimés récemment pendant environ 30 jours. Avec Photos iCloud, ils disparaissent de tous vos appareils."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glöschti Elemente blibed öppe 30 Täg i «Zuletzt gelöscht». Mit iCloud-Foti verschwindeds vo allne dine Gräte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिलीट की गई चीज़ें लगभग 30 दिन तक “हाल ही में डिलीट किए गए” में रहती हैं। iCloud फ़ोटो के साथ वे आपके सभी डिवाइस से हट जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrisane stavke ostaju u Nedavno izbrisano oko 30 dana. S iCloud fotografijama nestaju sa svih tvojih uređaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi eliminati restano in Eliminati di recente per circa 30 giorni. Con Foto di iCloud spariscono da tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した項目は、約30日間「最近削除した項目」に残ります。iCloud写真を使っている場合は、すべてのデバイスから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 항목은 약 30일 동안 최근 삭제된 항목에 보관됩니다. iCloud 사진을 사용하면 모든 기기에서 삭제됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzēstie vienumi apmēram 30 dienas paliek sadaļā Nesen dzēstie. Izmantojot iCloud Foto, tie pazūd no visām tavām ierīcēm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięte elementy zostają w Ostatnio usunięte przez około 30 dni. Przy Zdjęciach iCloud znikają ze wszystkich Twoich urządzeń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens eliminados ficam em Eliminados Recentemente durante cerca de 30 dias. Com as Fotografias do iCloud, desaparecem de todos os seus dispositivos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementët e fshirë qëndrojnë te Fshirë së fundi për rreth 30 ditë. Me Fotot e iCloud, ata largohen nga të gjitha pajisjet e tua."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрисане ставке остају у Недавно обрисано око 30 дана. Са iCloud фотографијама нестају са свих ваших уређаја."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrisane stavke ostaju u Nedavno obrisano oko 30 dana. Sa iCloud fotografijama nestaju sa svih vaših uređaja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderade objekt ligger kvar i Nyligen raderade i cirka 30 dagar. Med iCloud-foton försvinner de från alla dina enheter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinen öğeler yaklaşık 30 gün boyunca Yakınlarda Silinenler’de kalır. iCloud Fotoğrafları ile tüm aygıtlarınızdan kaldırılırlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除的项目会在“最近删除”中保留约 30 天。如果使用“iCloud 照片”，它们会从你的所有设备中移除。"
          }
        }
      }
    },
