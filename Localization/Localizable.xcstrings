    "Recognised CoreSimulator, Adobe NGL and Office diagnostic .log files older than 30 days. Settings, credentials, other logs and conversation histories stay protected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات .log التشخيصية المعروفة لـ CoreSimulator وAdobe NGL وOffice الأقدم من 30 يومًا. تبقى الإعدادات وبيانات الاعتماد والسجلات الأخرى وسجلات المحادثات محمية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arxius .log de diagnòstic reconeguts de CoreSimulator, Adobe NGL i Office amb més de 30 dies. Els ajustos, les credencials, els altres registres i els historials de converses queden protegits."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannte .log-Diagnosedateien von CoreSimulator, Adobe NGL und Office, die älter als 30 Tage sind. Einstellungen, Zugangsdaten, andere Protokolle und Gesprächsverläufe bleiben geschützt."
          }
        },
