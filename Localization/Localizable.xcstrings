    "Health starts at 100. Memory pressure lowers it most, then a large swap, then many apps opening at login." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ الصحة من 100. يخفضها ضغط الذاكرة أكثر من غيره، ثم ذاكرة التبديل الكبيرة، ثم كثرة التطبيقات التي تُفتح عند الدخول."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salut comença a 100. La pressió de memòria és el que més la rebaixa, després un intercanvi gran, i després moltes apps que s’obren en iniciar la sessió."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zustand beginnt bei 100. Am stärksten senkt ihn der Speicherdruck, dann ein großer Swap, dann viele Apps, die sich bei der Anmeldung öffnen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health starts at 100. Memory pressure lowers it most, then a large swap, then many apps opening at login."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health starts at 100. Memory pressure lowers it most, then a large swap, then many apps opening at login."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health starts at 100. Memory pressure lowers it most, then a large swap, then many apps opening at login."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salud empieza en 100. La presión de memoria es lo que más la baja, después un swap grande y luego muchas apps que se abren al iniciar sesión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salud empieza en 100. La presión de memoria es lo que más la baja, después un swap grande y luego muchas apps que se abren al iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La santé démarre à 100. La pression mémoire l’abaisse le plus, puis un swap important, puis de nombreuses apps qui s’ouvrent avec la session."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D Gsundheit fangt bi 100 aa. Am meiste senkt sie dr Arbeitsspeicher-Druck, dänn en grosse Swap, dänn vili Apps, wo bi de Aamäldig öffned."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हेल्थ 100 से शुरू होती है। मेमोरी दबाव इसे सबसे ज़्यादा घटाता है, फिर बड़ा स्वैप, फिर लॉगइन पर खुलने वाले कई ऐप।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravlje počinje sa 100. Najviše ga snižava pritisak na RAM, zatim veliki swap, pa mnogo aplikacija koje se otvaraju kod prijave."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salute parte da 100. La pressione della memoria la abbassa di più, poi un grande swap, poi molte app che si aprono al login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康度は100から始まります。最も下がるのはメモリプレッシャー、次に大きなスワップ、そしてログイン時に開くアプリが多い場合です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태는 100에서 시작합니다. 메모리 압력이 가장 크게 낮추고, 그다음 큰 스왑, 그다음 로그인 시 열리는 많은 앱 순입니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veselība sākas ar 100. Visvairāk to pazemina atmiņas spiediens, tad liels swap, tad daudzas lietotnes, kas atveras pieteikšanās brīdī."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kondycja zaczyna się od 100. Najbardziej obniża ją ciśnienie pamięci, potem duży swap, a następnie wiele aplikacji otwieranych podczas logowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saúde começa em 100. A pressão da memória é o que mais a reduz, depois um swap grande e depois muitas apps a abrir ao iniciar sessão."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shëndeti fillon në 100. Presioni i memories e ul më shumë, pastaj një swap i madh, pastaj shumë aplikacione që hapen gjatë hyrjes."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравље почиње од 100. Притисак меморије га највише смањује, затим велики swap, па много апликација које се отварају при пријављивању."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravlje počinje od 100. Pritisak memorije ga najviše smanjuje, zatim veliki swap, pa mnogo aplikacija koje se otvaraju pri prijavljivanju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälsan börjar på 100. Minnestrycket sänker den mest, därefter en stor swap och sedan många appar som öppnas vid inloggning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlık 100’den başlar. En çok bellek baskısı, sonra büyük bir takas, sonra oturum açıldığında açılan çok sayıda uygulama düşürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康度从 100 开始。内存压力扣分最多，其次是较大的交换空间，再其次是登录时打开的 App 过多。"
          }
        }
      }
    },
