          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas seleccionadas incluyen todo lo que contienen, también los archivos que no aparecen en un mapa parcial."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas seleccionadas incluyen todo lo que contienen, también los archivos que no aparecen en un mapa parcial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers sélectionnés incluent tout ce qu’ils contiennent, y compris les fichiers non affichés dans une carte partielle."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusgwählti Ordner schliesset alles drin ii, au Dateie, wo i ere unvollständige Charte nöd azeigt werded."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने गए फ़ोल्डर में उनके अंदर का सब कुछ शामिल है, उन फ़ाइलों सहित जो आंशिक मैप में नहीं दिखतीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabrane mape uključuju sve unutar sebe, uključujući datoteke koje nisu prikazane u djelomičnom prikazu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle selezionate includono tutto ciò che contengono, compresi i file non mostrati in una mappa parziale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダには、部分的なマップに表示されていないファイルを含め、その中のすべてが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더에는 일부만 표시된 맵에 나타나지 않는 파일을 포함해 안에 있는 모든 것이 포함됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlasītās mapes ietver visu, kas tajās ir, arī failus, kas nav redzami daļējā kartē."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznaczone foldery obejmują wszystko, co jest w nich, także pliki niepokazane na mapie częściowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pastas selecionadas incluem tudo o que têm dentro, incluindo ficheiros não mostrados num mapa parcial."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosjet e zgjedhura përfshijnë gjithçka brenda tyre, përfshirë skedarët që nuk shfaqen në një hartë të pjesshme."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изабране фасцикле укључују све унутар њих, укључујући фајлове који се не виде на делимичној мапи."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izabrane fascikle uključuju sve unutar njih, uključujući fajlove koji se ne vide na delimičnoj mapi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valda mappar omfattar allt inuti dem, inklusive filer som inte visas i en delvis karta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili klasörler, kısmi bir haritada gösterilmeyen dosyalar dahil, içlerindeki her şeyi kapsar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选文件夹包含其中的所有内容，包括未在不完整地图中显示的文件。"
          }
        }
      }
    },
