          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu generierbare Compiler-Modul-Cache, wo mindestens 30 Täg nöd bruucht worde isch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम 30 दिनों से अनुपयोगी, दोबारा बन सकने वाला कंपाइलर मॉड्यूल कैश।"
