    "What protects it, who can reach it and what runs on it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يحميه ومن يستطيع الوصول إليه وما يعمل عليه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Què el protegeix, qui hi pot accedir i què s’hi executa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ihn schützt, wer ihn erreichen kann und was darauf läuft."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What protects it, who can reach it and what runs on it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What protects it, who can reach it and what runs on it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What protects it, who can reach it and what runs on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué lo protege, quién puede acceder a él y qué se ejecuta en él."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué la protege, quién puede acceder a ella y qué se ejecuta en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui le protège, qui peut y accéder et ce qui s’y exécute."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ihn schützt, wer ihn cha erreiche und was druf lauft."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे क्या सुरक्षित रखता है, कौन इस तक पहुँच सकता है और इस पर क्या चलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Što ga štiti, tko mu može pristupiti i što se na njemu pokreće."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa lo protegge, chi può raggiungerlo e cosa vi gira."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何が守っているか、誰がアクセスできるか、何が動いているか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇이 보호하는지, 누가 접근할 수 있는지, 무엇이 실행되는지."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas to aizsargā, kam tas ir pieejams un kas tajā darbojas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co go chroni, kto może się z nim połączyć i co na nim działa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o protege, quem lhe pode aceder e o que nele é executado."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çfarë e mbron, kush e arrin dhe çfarë punon në të."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шта га штити, ко може да му приступи и шта на њему ради."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šta ga štiti, ko može da mu pristupi i šta na njemu radi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad som skyddar den, vem som kan nå den och vad som körs på den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neyin koruduğu, kimin ulaşabildiği ve üzerinde nelerin çalıştığı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
