    "Moves files to the macOS Trash. Restore them in Finder with Put Back. Space is reclaimed when Trash is emptied." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل الملفات إلى سلة مهملات macOS. أرجعها في فايندر عبر إرجاع. تُستعاد المساحة عند إفراغ سلة المهملات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mou els arxius a la paperera de macOS. Recupera’ls al Finder amb «Recupera». L’espai s’allibera quan es buida la paperera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt Dateien in den macOS-Papierkorb. Stelle sie im Finder mit „Zurücklegen“ wieder her. Der Platz wird frei, wenn der Papierkorb geleert wird."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves files to the macOS Bin. Restore them in Finder with Put Back. Space is reclaimed when Bin is emptied."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves files to the macOS Trash. Restore them in Finder with Put Back. Space is reclaimed when Trash is emptied."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves files to the macOS Bin. Restore them in Finder with Put Back. Space is reclaimed when Bin is emptied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve los archivos a la Papelera de macOS. Restáuralos en el Finder con Sacar de la papelera. El espacio se recupera cuando se vacía la Papelera."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve los archivos al Basurero de macOS. Restáuralos en el Finder con Sacar del basurero. El espacio se recupera cuando se vacía el Basurero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place les fichiers dans la Corbeille de macOS. Restaurez-les dans le Finder avec Remettre. L’espace est récupéré quand la Corbeille est vidée."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt Dateie id macOS-Papierkorb. Im Finder chasch si mit «Zurücklegen» wiederhärstelle. De Platz wird frei, wenn de Papierkorb gleert wird."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें macOS की रद्दी में भेजता है। Finder में “वापस रखें” से उन्हें बहाल करें। रद्दी खाली करने पर जगह वापस मिलती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premješta datoteke u macOS Smeće. Vrati ih u Finderu naredbom Vrati. Prostor se oslobađa kad se Smeće isprazni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta i file nel Cestino di macOS. Ripristinali nel Finder con Ripristina. Lo spazio viene recuperato quando il Cestino viene svuotato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをmacOSのゴミ箱に移動します。Finderで「戻す」を使って復元できます。ゴミ箱を空にすると、容量が回収されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 macOS 휴지통으로 이동합니다. Finder에서 ‘되돌려 놓기’로 복원하세요. 휴지통을 비우면 공간이 확보됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārvieto failus uz macOS Atkritni. Atjauno tos Finder ar Ielikt atpakaļ. Vieta tiek atgūta, kad Atkritne tiek iztukšota."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi pliki do Kosza macOS. Przywróć je w Finderze poleceniem Przywróć z Kosza. Miejsce zostaje odzyskane po opróżnieniu Kosza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move ficheiros para o Lixo do macOS. Reponha-os no Finder com Repor. O espaço só é recuperado quando o Lixo é esvaziado."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhvendos skedarët në Koshin e macOS. Rikthe në Finder me Kthe mbrapsht. Hapësira çlirohet kur boshatiset Koshi."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премешта фајлове у macOS Отпад. Вратите их у Finder-у помоћу Врати назад. Простор се враћа када се Отпад испразни."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premešta fajlove u macOS Otpad. Vratite ih u Finder-u pomoću Vrati nazad. Prostor se vraća kada se Otpad isprazni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar filer till macOS papperskorg. Återställ dem i Finder med Lägg tillbaka. Utrymmet frigörs när papperskorgen töms."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları macOS Çöp Sepeti’ne taşır. Finder’da Yerine Koy ile geri yükleyin. Çöp Sepeti boşaltıldığında alan geri kazanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件移到 macOS 废纸篓。可在访达中使用“放回原处”恢复。清倒废纸篓后才会回收空间。"
          }
        }
      }
    },
