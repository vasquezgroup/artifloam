        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps podem abrandar. Saia de uma app que não utilize; guarde primeiro o seu trabalho."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacionet mund të ngadalësohen. Mbyll një aplikacion që nuk po e përdor; ruaj më parë punën tënde."
