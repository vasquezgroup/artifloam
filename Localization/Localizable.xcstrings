    "%@ will be asked to quit. Save your work if they ask." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُطلب من %@ الإنهاء. احفظ عملك إذا طُلب منك ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es demanarà a %@ que es tanquin. Desa la feina si t’ho demanen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ werden zum Beenden aufgefordert. Sichere deine Arbeit, wenn du gefragt wirst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be asked to quit. Save your work if they ask."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be asked to quit. Save your work if they ask."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be asked to quit. Save your work if they ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pedirá a %@ que se cierren. Guarda tu trabajo si te lo piden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se le pedirá a %@ que se cierren. Guarda tu trabajo si te lo piden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recevront une demande de fermeture. Enregistrez votre travail si elles vous le demandent."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wärded bäte, sich z beände. Spychere dini Arbet, wänn si dich dra frööged."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को बंद होने के लिए कहा जाएगा। पूछे जाने पर अपना काम सहेज लें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dobit će zahtjev za zatvaranje. Spremite svoj rad ako vas pitaju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ verrà chiesto di chiudersi. Salva il lavoro se te lo chiedono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に終了を要求します。確認された場合は作業内容を保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 종료를 요청합니다. 저장하라는 메시지가 나타나면 작업을 저장하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiks lūgtas aizvērties. Ja tās jautā, saglabājiet savu darbu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ otrzymają prośbę o zamknięcie. Zapisz swoją pracę, jeśli o to zapytają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ receberão um pedido para encerrar. Guarda o teu trabalho se te for pedido."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ do të kërkohet të mbyllen. Ruaje punën nëse të pyesin."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ће добити захтев за затварање. Сачувајте свој рад ако вас питају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ će dobiti zahtev za zatvaranje. Sačuvajte svoj rad ako vas pitaju."
          }
        },
        "sv" : {
