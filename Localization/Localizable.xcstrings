          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups enthalted persönlichi Date. Im Finder prüefe; kei automatischs Lösche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप में निजी डेटा होता है। Finder में समीक्षा करें; अपने आप डिलीट नहीं किया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosne kopije sadrže osobne podatke. Pregledaj u Finderu; bez automatskog brisanja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup contengono dati personali. Rivedi nel Finder; nessuna eliminazione automatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップには個人データが含まれます。Finderで確認してください。自動削除は行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업에는 개인 데이터가 들어 있습니다. Finder에서 검토하세요. 자동 삭제는 하지 않습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
