    "Move apps you no longer use to the Trash. Your documents and support data stay in place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل التطبيقات التي لم تعد تستخدمها إلى سلة المهملات. تبقى مستنداتك وبيانات الدعم في مكانها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mou a la paperera les apps que ja no fas servir. Els teus documents i les dades de suport es queden al seu lloc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Apps, die du nicht mehr nutzt, in den Papierkorb. Deine Dokumente und Support-Daten bleiben an ihrem Platz."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move apps you no longer use to the Bin. Your documents and support data stay in place."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move apps you no longer use to the Trash. Your documents and support data stay in place."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move apps you no longer use to the Bin. Your documents and support data stay in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve a la Papelera las apps que ya no usas. Tus documentos y los datos de soporte se quedan donde están."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve al Basurero las apps que ya no usas. Tus documentos y los datos de soporte se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez dans la Corbeille les apps que vous n’utilisez plus. Vos documents et données de support restent en place."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschieb Apps, wo du nüme bruuchsch, id Papierkorb. Dini Dokument und Support-Date blibed am Platz."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो ऐप आप अब उपयोग नहीं करते, उन्हें रद्दी में भेजें। आपके दस्तावेज़ और सपोर्ट डेटा अपनी जगह रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premjesti aplikacije koje više ne koristiš u Smeće. Tvoji dokumenti i podaci podrške ostaju na mjestu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
