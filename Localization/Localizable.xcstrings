    "Still low on space. Larger items need your choice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال المساحة منخفضة. العناصر الأكبر تحتاج إلى اختيارك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara va just d’espai. Els elements més grans requereixen que triïs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Platz ist immer noch knapp. Größere Objekte brauchen deine Entscheidung."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still low on space. Larger items need your choice."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still low on space. Larger items need your choice."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still low on space. Larger items need your choice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún queda poco espacio. Los elementos más grandes requieren que elijas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún queda poco espacio. Los elementos más grandes requieren que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore peu d’espace. Les éléments plus volumineux demandent votre choix."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na immer wenig Platz. Grösseri Elemente bruched dini Uuswahl."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब भी जगह कम है। बड़े आइटम के लिए आपका चुनाव चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još je malo prostora. Veće stavke traže tvoj odabir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio è ancora poco. Gli elementi più grandi richiedono la tua scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ空き容量が不足しています。大きな項目は、ご自身での選択が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 공간이 부족합니다. 더 큰 항목은 직접 선택해야 합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēl joprojām maz vietas. Lielāki vienumi prasa tavu izvēli."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal mało miejsca. Większe elementy wymagają Twojego wyboru."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda com pouco espaço. Os itens maiores precisam da sua escolha."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende pak hapësirë. Elementët më të mëdhenj kërkojnë zgjedhjen tënde."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простора је и даље мало. Веће ставке захтевају ваш избор."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostora je i dalje malo. Veće stavke zahtevaju vaš izbor."
          }
        },
