    "Older copies of Claude Code and Cursor agent (the newest stays), and regenerable Xcode output inside Claude's temporary sessions. Conversation history and original images stay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ أقدم من Claude Code ووكيل Cursor (تبقى الأحدث)، ومخرجات Xcode القابلة لإعادة التوليد داخل الجلسات المؤقتة لـ Claude. يبقى سجل المحادثات والصور الأصلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còpies antigues de Claude Code i de l’agent de Cursor (la més nova es queda), i sortida de Xcode regenerable dins de les sessions temporals de Claude. L’historial de converses i les imatges originals es queden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Kopien von Claude Code und des Cursor-Agents (die neueste bleibt) sowie neu erzeugbare Xcode-Ausgabe in den temporären Sitzungen von Claude. Der Gesprächsverlauf und die Originalbilder bleiben erhalten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Older copies of Claude Code and Cursor agent (the newest stays), and regenerable Xcode output inside Claude's temporary sessions. Conversation history and original images stay."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Older copies of Claude Code and Cursor agent (the newest stays), and regenerable Xcode output inside Claude's temporary sessions. Conversation history and original images stay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Older copies of Claude Code and Cursor agent (the newest stays), and regenerable Xcode output inside Claude's temporary sessions. Conversation history and original images stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias antiguas de Claude Code y del agente de Cursor (se conserva la más reciente) y resultados regenerables de Xcode dentro de las sesiones temporales de Claude. El historial de conversaciones y las imágenes originales se conservan."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias antiguas de Claude Code y del agente de Cursor (se conserva la más reciente) y resultados regenerables de Xcode dentro de las sesiones temporales de Claude. El historial de conversaciones y las imágenes originales se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anciennes copies de Claude Code et de l’agent Cursor (la plus récente reste), et sortie Xcode régénérable dans les sessions temporaires de Claude. L’historique des conversations et les images d’origine restent."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Kopie vo Claude Code und Cursor Agent (di neuschti blibt), und neu generierbari Xcode-Uusgab i de temporäre Sessions vo Claude. Gsprächsverlauf und Originalbilder blibed."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code और Cursor agent की पुरानी प्रतियाँ (सबसे नई रखी जाती है), और Claude के अस्थायी सेशन के अंदर दोबारा बन सकने वाला Xcode आउटपुट। बातचीत का इतिहास और मूल इमेज रखी जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starije kopije Claude Codea i Cursor agenta (najnovija ostaje) te ponovno stvorivi Xcode izlaz unutar Claudeovih privremenih sesija. Povijest razgovora i izvorne slike ostaju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie più vecchie di Claude Code e dell'agente Cursor (la più recente resta) e output Xcode rigenerabile nelle sessioni temporanee di Claude. La cronologia delle conversazioni e le immagini originali restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude CodeとCursor agentの古いコピー(最新のものは残ります)と、Claudeの一時セッション内の再生成可能なXcode出力。会話履歴と元の画像は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code와 Cursor agent의 이전 사본(최신 버전은 유지)과 Claude 임시 세션 안에서 다시 만들 수 있는 Xcode 출력. 대화 기록과 원본 이미지는 유지됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vecākas Claude Code un Cursor aģenta kopijas (jaunākā paliek) un atjaunojama Xcode izvade Claude pagaidu sesijās. Sarunu vēsture un oriģinālie attēli paliek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starsze kopie Claude Code i agenta Cursor (najnowsza zostaje) oraz odtwarzalne wyniki Xcode w tymczasowych sesjach Claude. Historia rozmów i oryginalne obrazy zostają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópias mais antigas do Claude Code e do agente do Cursor (a mais recente fica) e saída regenerável do Xcode dentro das sessões temporárias do Claude. O histórico de conversas e as imagens originais ficam."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopje më të vjetra të Claude Code dhe agjentit Cursor (më e reja mbetet), dhe dalje e rigjenerueshme e Xcode brenda sesioneve të përkohshme të Claude. Historiku i bisedave dhe imazhet origjinale mbeten."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старије копије алата Claude Code и Cursor agent (најновија остаје) и Xcode излаз који се може поново направити унутар привремених сесија алата Claude. Историја разговора и оригиналне слике остају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starije kopije alata Claude Code i Cursor agent (najnovija ostaje) i Xcode izlaz koji se može ponovo napraviti unutar privremenih sesija alata Claude. Istorija razgovora i originalne slike ostaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äldre kopior av Claude Code och Cursor-agenten (den nyaste behålls) samt Xcode-utdata som kan återskapas i Claudes temporära sessioner. Konversationshistorik och originalbilder behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ve Cursor agent’ın eski kopyaları (en yenisi kalır) ve Claude’un geçici oturumları içindeki yeniden üretilebilir Xcode çıktısı. Konuşma geçmişi ve özgün görüntüler kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 和 Cursor agent 的旧副本（最新的会保留），以及 Claude 临时会话中可重新生成的 Xcode 输出。对话历史和原始图像会保留。"
          }
        }
      }
    },
