        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Означава највеће апликације које нисте користили последњих десет минута. Ништа се не затвара док не потврдите испод."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označava najveće aplikacije koje niste koristili poslednjih deset minuta. Ništa se ne zatvara dok ne potvrdite ispod."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerar de största apparna som du inte har använt de senaste tio minuterna. Inget avslutas förrän du bekräftar nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son on dakikada kullanmadığınız en büyük uygulamaları işaretler. Aşağıda onaylamadan hiçbir uygulamadan çıkılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选你在过去十分钟内未使用的最大的 App。在你于下方确认之前，不会退出任何 App。"
          }
        }
      }
    },
