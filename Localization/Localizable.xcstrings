    "Offloading frees nearly all of it. Some apps keep their data online, so check you don't use them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلغاء التحميل يحرّر معظمها تقريبًا. تحتفظ بعض التطبيقات ببياناتها على الإنترنت، لذا تأكد من أنك لا تستخدمها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarregar l’app n’allibera gairebé tot. Algunes apps guarden les dades en línia, així que comprova que no les facis servir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auslagern schafft fast den ganzen Platz. Manche Apps speichern ihre Daten online, prüfe also, dass du sie nicht brauchst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offloading frees nearly all of it. Some apps keep their data online, so check you don't use them."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offloading frees nearly all of it. Some apps keep their data online, so check you don't use them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offloading frees nearly all of it. Some apps keep their data online, so check you don't use them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargarla libera casi todo. Algunas apps guardan sus datos en línea, así que comprueba que no las uses."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargarla libera casi todo. Algunas apps guardan sus datos en línea, así que comprueba que no las uses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désinstaller l’app en libère presque tout. Certaines apps gardent leurs données en ligne ; vérifiez que vous ne les utilisez pas."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uslagere schafft fast de ganz Platz. Es paar Apps speicheret ihri Date online, prüef also, dass du si nöd bruuchsch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़लोड करने से लगभग सब खाली हो जाता है। कुछ ऐप अपना डेटा ऑनलाइन रखते हैं, इसलिए जाँच लें कि आप उनका इस्तेमाल नहीं करते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasterećenje oslobađa gotovo sve. Neke aplikacije čuvaju podatke na mreži, pa provjeri da ih ne koristiš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere l'app ne libera quasi tutto. Alcune app conservano i dati online, quindi controlla di non usarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り除くと、ほぼすべての容量が空きます。データをオンラインに保存するアプリもあるため、該当しないか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프로드하면 거의 전부 확보됩니다. 일부 앱은 데이터를 온라인에 보관하므로 해당하는지 확인하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izlāde atbrīvo gandrīz visu. Dažas lietotnes glabā datus tiešsaistē, tāpēc pārbaudi, vai tu tās neizmanto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odciążenie zwalnia prawie wszystko. Niektóre aplikacje trzymają dane online, więc sprawdź, czy z nich nie korzystasz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarregar liberta quase tudo. Algumas apps guardam os dados online, por isso verifique que não as usa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çngarkimi çliron pothuajse të gjithën. Disa aplikacione i mbajnë të dhënat online, ndaj kontrollo që të mos i përdorësh."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растерећење ослобађа скоро све. Неке апликације чувају податке на мрежи, па проверите да их не користите."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasterećenje oslobađa skoro sve. Neke aplikacije čuvaju podatke na mreži, pa proverite da ih ne koristite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avlastning frigör nästan allt. Vissa appar sparar sina data online, så kontrollera att du inte använder dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşaltmak neredeyse hepsini açar. Bazı uygulamalar verilerini çevrimiçi tutar, bu yüzden bunları kullanmadığınızdan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载几乎可以释放全部空间。有些 App 将数据保存在线上，请确认你没有使用这类 App。"
          }
        }
      }
    },
