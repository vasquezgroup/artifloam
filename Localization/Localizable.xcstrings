    "Device support for one iOS version. Xcode rebuilds it the next time you connect a device with it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعم الجهاز لإصدار واحد من iOS. يعيد Xcode بناءه في المرة التالية التي توصّل فيها جهازًا به."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suport de dispositiu per a una versió d’iOS. Xcode el torna a crear la propera vegada que hi connectis un dispositiu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerätesupport für eine iOS-Version. Xcode baut ihn neu auf, wenn du das nächste Mal ein Gerät damit verbindest."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device support for one iOS version. Xcode rebuilds it the next time you connect a device with it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device support for one iOS version. Xcode rebuilds it the next time you connect a device with it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device support for one iOS version. Xcode rebuilds it the next time you connect a device with it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soporte de dispositivo para una versión de iOS. Xcode lo reconstruye la próxima vez que conectes un dispositivo con ella."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soporte de dispositivo para una versión de iOS. Xcode lo reconstruye la próxima vez que conectes un dispositivo con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prise en charge d’appareils pour une version d’iOS. Xcode la recrée la prochaine fois que vous connectez un appareil avec cette version."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gräteunterstützig für e iOS-Version. Xcode baut si neu uf, wenn du s nächscht Mal es Grät mit dere Version aaschliessisch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक iOS संस्करण के लिए डिवाइस सपोर्ट। अगली बार उस संस्करण वाला डिवाइस कनेक्ट करने पर Xcode इसे दोबारा बनाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrška uređaja za jednu verziju iOS-a. Xcode je ponovno gradi sljedeći put kad spojiš uređaj s njom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supporto dispositivo per una versione di iOS. Xcode lo ricostruisce la prossima volta che colleghi un dispositivo con quella versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの1つのバージョン用のデバイスサポート。そのバージョンのデバイスを次に接続したとき、Xcodeが再作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 한 버전용 기기 지원 파일. 해당 기기를 다음에 연결하면 Xcode가 다시 만듭니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ierīces atbalsts vienai iOS versijai. Xcode to izveido no jauna nākamreiz, kad pievieno ierīci ar to."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługa urządzenia dla jednej wersji iOS. Xcode odbudowuje ją przy następnym podłączeniu urządzenia z tą wersją."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suporte de dispositivo para uma versão do iOS. O Xcode recria-o da próxima vez que ligar um dispositivo com essa versão."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbështetje pajisjeje për një version iOS. Xcode e rindërton herën tjetër që lidh një pajisje me të."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подршка за уређај за једну iOS верзију. Xcode је поново прави следећи пут када повежете уређај са њом."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrška za uređaj za jednu iOS verziju. Xcode je ponovo pravi sledeći put kada povežete uređaj sa njom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhetsstöd för en iOS-version. Xcode bygger upp det igen nästa gång du ansluter en enhet med den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir iOS sürümü için aygıt desteği. Onunla bir aygıtı bir sonraki bağlayışınızda Xcode bunu yeniden oluşturur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个 iOS 版本的设备支持文件。下次你连接使用它的设备时，Xcode 会重新生成。"
          }
        }
      }
    },
