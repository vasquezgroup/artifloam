    "Keep space free cleaned caches that rebuild themselves. Your files were not touched." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظّف «إبقاء المساحة متاحة» ذاكرات مؤقتة تعيد بناء نفسها. لم تُمَسّ ملفاتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Mantén espai lliure» ha netejat memòries cau que es tornen a crear soles. Els teus arxius no s’han tocat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platz freihalten hat Caches bereinigt, die sich selbst neu aufbauen. Deine Dateien wurden nicht angetastet."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep space free cleaned caches that rebuild themselves. Your files were not touched."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep space free cleaned caches that rebuild themselves. Your files were not touched."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep space free cleaned caches that rebuild themselves. Your files were not touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener espacio libre ha limpiado cachés que se reconstruyen solas. Tus archivos no se han tocado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener espacio libre ha limpiado cachés que se reconstruyen solas. Tus archivos no se han tocado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenir de l’espace libre a nettoyé des caches qui se recréent d’eux-mêmes. Vos fichiers n’ont pas été touchés."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Platz frei haa» hät Caches ufgruumt, wo sich vo sälber neu ufbaued. Dini Dateie sind nöd aagrüehrt worde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘जगह खाली रखें’ ने वे कैश साफ़ किए जो अपने आप दोबारा बन जाते हैं। आपकी फ़ाइलों को छुआ नहीं गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držanje prostora slobodnim očistilo je predmemorije koje se same ponovno grade. Tvoje datoteke nisu dirane."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni spazio libero ha pulito le cache che si ricostruiscono da sole. I tuoi file non sono stati toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「空き容量を維持」が、自動で再作成されるキャッシュをクリーンアップしました。ファイルには触れていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여유 공간 유지가 스스로 다시 만들어지는 캐시를 정리했습니다. 파일은 건드리지 않았습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcija Uzturēt brīvu vietu notīrīja kešatmiņas, ko lietotnes izveido pašas no jauna. Tavi faili netika skarti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymywanie wolnego miejsca wyczyściło pamięci podręczne, które odbudowują się same. Twoje pliki nie zostały ruszone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter espaço livre limpou caches que se recriam sozinhas. Os seus ficheiros não foram tocados."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbajtja e hapësirës së lirë pastroi cache që rindërtohen vetë. Skedarët e tu nuk u prekën."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Одржавај слободан простор“ је очистио кешеве који се сами поново праве. Ваши фајлови нису дирани."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Održavaj slobodan prostor“ je očistio keševe koji se sami ponovo prave. Vaši fajlovi nisu dirani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll utrymme ledigt rensade cachar som byggs upp av sig själva. Dina filer berördes inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Alanı boş tut”, kendiliğinden yeniden oluşan önbellekleri temizledi. Dosyalarınıza dokunulmadı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“保持空间可用”清理了会自行重新生成的缓存。你的文件未被触碰。"
          }
        }
      }
    },
