    "Unused Gradle artifact transforms, generated Gradle JARs, Xcode module caches and npm's download cache. Recent or active caches, downloaded dependencies and configuration stay protected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradle artifact transforms غير المستخدمة وملفات Gradle JAR المولَّدة وذاكرات وحدات Xcode المؤقتة وذاكرة التنزيل المؤقتة لـ npm. تبقى الذاكرات المؤقتة الحديثة أو النشطة والتبعيات المنزَّلة والإعدادات محمية."
          }
        },
        "ca" : {
