    "Each item is checked again right before removal. Anything in use is skipped. Removed caches are rebuilt by their apps when needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُفحص كل عنصر مرة أخرى قبل الإزالة مباشرة. يتم تخطي أي شيء قيد الاستخدام. تعيد التطبيقات بناء الذاكرات المؤقتة المُزالة عند الحاجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada element es torna a comprovar just abans d’eliminar-lo. Tot el que està en ús s’omet. Les apps tornen a crear les memòries cau eliminades quan cal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Objekt wird direkt vor dem Entfernen noch einmal geprüft. Was in Gebrauch ist, wird übersprungen. Entfernte Caches werden von ihren Apps bei Bedarf neu aufgebaut."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each item is checked again right before removal. Anything in use is skipped. Removed caches are rebuilt by their apps when needed."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each item is checked again right before removal. Anything in use is skipped. Removed caches are rebuilt by their apps when needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each item is checked again right before removal. Anything in use is skipped. Removed caches are rebuilt by their apps when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada elemento se vuelve a comprobar justo antes de eliminarlo. Se omite todo lo que esté en uso. Las cachés eliminadas las reconstruyen sus apps cuando hace falta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada elemento se vuelve a comprobar justo antes de eliminarlo. Se omite todo lo que esté en uso. Las cachés eliminadas las reconstruyen sus apps cuando hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément est revérifié juste avant son retrait. Tout ce qui est en cours d’utilisation est ignoré. Les caches retirés sont recréés par leurs apps en cas de besoin."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Element wird churz vor em Entferne nomal gcheckt. Was im Bruuch isch, wird übersprunge. Entfernti Caches baued d Apps bi Bedarf neu uf."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर आइटम हटाने से ठीक पहले फिर जाँचा जाता है। उपयोग में कोई भी चीज़ छोड़ दी जाती है। हटाए गए कैश ज़रूरत पड़ने पर उनके ऐप दोबारा बना लेते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka se stavka ponovno provjerava neposredno prije uklanjanja. Sve što se koristi preskače se. Uklonjene predmemorije aplikacije ponovno grade kad zatreba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento viene ricontrollato subito prima della rimozione. Tutto ciò che è in uso viene saltato. Le cache rimosse vengono ricostruite dalle loro app quando serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目は、削除の直前にもう一度チェックされます。使用中のものはスキップされます。削除されたキャッシュは、必要なときにアプリが再作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목은 제거 직전에 다시 확인합니다. 사용 중인 항목은 건너뜁니다. 제거된 캐시는 필요할 때 해당 앱이 다시 만듭니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katrs vienums tiek pārbaudīts vēlreiz tieši pirms noņemšanas. Viss, kas tiek lietots, tiek izlaists. Noņemtās kešatmiņas lietotnes izveido no jauna, kad vajag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy element jest sprawdzany ponownie tuż przed usunięciem. Wszystko, co jest w użyciu, jest pomijane. Usunięte pamięci podręczne są odbudowywane przez ich aplikacje w razie potrzeby."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada item é verificado novamente mesmo antes de ser removido. Tudo o que estiver em uso é ignorado. As caches removidas são recriadas pelas suas apps quando necessário."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çdo element kontrollohet përsëri pak para heqjes. Çdo gjë në përdorim anashkalohet. Cache-t e hequra rindërtohen nga aplikacionet e tyre kur nevojitet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свака ставка се проверава поново непосредно пре уклањања. Све што је у употреби се прескаче. Уклоњене кешеве њихове апликације поново праве када затреба."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka stavka se proverava ponovo neposredno pre uklanjanja. Sve što je u upotrebi se preskače. Uklonjene keševe njihove aplikacije ponovo prave kada zatreba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje objekt kontrolleras igen precis innan det tas bort. Allt som används hoppas över. Borttagna cachar byggs upp igen av sina appar vid behov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her öğe, kaldırılmadan hemen önce yeniden denetlenir. Kullanımda olan her şey atlanır. Kaldırılan önbellekleri, gerektiğinde uygulamaları yeniden oluşturur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个项目在移除前都会再次检查。任何正在使用的项目都会跳过。已移除的缓存会在需要时由其 App 重新生成。"
          }
        }
      }
    },
    "Each tool below scans only its own area. The button above runs the cleanup, worktree, duplicate and system checks together. Scanning never deletes files or quits apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفحص كل أداة أدناه منطقتها فقط. يشغّل الزر أعلاه فحوصات التنظيف وworktrees والنسخ المكررة والنظام معًا. الفحص لا يحذف ملفات ولا ينهي تطبيقات أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada eina de sota analitza només la seva àrea. El botó de dalt executa junts la neteja, els worktrees, els duplicats i les comprovacions del sistema. Analitzar mai esborra arxius ni tanca apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Werkzeug unten scannt nur seinen eigenen Bereich. Die Schaltfläche oben führt die Prüfungen für Bereinigung, Worktrees, Duplikate und System gemeinsam aus. Ein Scan löscht nie Dateien und beendet keine Apps."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each tool below scans only its own area. The button above runs the cleanup, worktree, duplicate and system checks together. Scanning never deletes files or quits apps."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each tool below scans only its own area. The button above runs the cleanup, worktree, duplicate and system checks together. Scanning never deletes files or quits apps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each tool below scans only its own area. The button above runs the cleanup, worktree, duplicate and system checks together. Scanning never deletes files or quits apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada herramienta de abajo analiza solo su propia zona. El botón de arriba ejecuta juntas las comprobaciones de limpieza, worktrees, duplicados y sistema. Analizar nunca borra archivos ni cierra apps."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada herramienta de abajo analiza solo su propia zona. El botón de arriba ejecuta juntas las comprobaciones de limpieza, worktrees, duplicados y sistema. Analizar nunca borra archivos ni cierra apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque outil ci-dessous n’analyse que son propre domaine. Le bouton ci-dessus lance ensemble les vérifications du nettoyage, des worktrees, des doublons et du système. L’analyse ne supprime jamais de fichiers et ne quitte jamais d’apps."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Tool unte scannt nume sin eigene Bereich. De Button obe füehrt d Checks für Ufruume, Worktrees, Duplikate und System zäme uus. Scanne löscht nie Dateie und beändet nie Apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे का हर टूल सिर्फ़ अपना क्षेत्र स्कैन करता है। ऊपर का बटन सफ़ाई, worktree, डुप्लिकेट और सिस्टम जाँच एक साथ चलाता है। स्कैन कभी फ़ाइलें डिलीट नहीं करता और ऐप बंद नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki alat u nastavku skenira samo svoje područje. Gumb iznad zajedno pokreće provjere čišćenja, worktreeova, duplikata i sustava. Skeniranje nikad ne briše datoteke niti zatvara aplikacije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni strumento qui sotto scansiona solo la propria area. Il pulsante in alto esegue insieme i controlli di pulizia, worktree, duplicati e sistema. La scansione non elimina mai file né chiude app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の各ツールは、それぞれの対象範囲だけをスキャンします。上のボタンは、クリーンアップ、worktree、重複、システムのチェックをまとめて実行します。スキャンでファイルが削除されたり、アプリが終了されたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 각 도구는 자신의 영역만 검사합니다. 위의 버튼은 정리, 워크트리, 중복, 시스템 점검을 함께 실행합니다. 검사는 파일을 삭제하거나 앱을 종료하지 않습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katrs tālāk redzamais rīks skenē tikai savu jomu. Augstāk esošā poga kopā veic tīrīšanas, worktree, dublikātu un sistēmas pārbaudes. Skenēšana nekad nedzēš failus un neaizver lietotnes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde narzędzie poniżej skanuje tylko własny obszar. Przycisk powyżej uruchamia razem kontrole czyszczenia, worktree, duplikatów i systemu. Skanowanie nigdy nie usuwa plików ani nie kończy aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ferramenta abaixo analisa apenas a sua própria área. O botão acima executa em conjunto as verificações de limpeza, worktrees, duplicados e sistema. A análise nunca elimina ficheiros nem faz sair apps."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çdo mjet më poshtë skanon vetëm zonën e vet. Butoni lart i kryen së bashku kontrollet e pastrimit, worktree-ve, dublikatave dhe sistemit. Skanimi nuk fshin kurrë skedarë dhe nuk mbyll aplikacione."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сваки алат испод скенира само своје подручје. Дугме изнад заједно покреће провере чишћења, worktrees, дупликата и система. Скенирање никада не брише фајлове нити затвара апликације."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki alat ispod skenira samo svoje područje. Dugme iznad zajedno pokreće provere čišćenja, worktrees, duplikata i sistema. Skeniranje nikada ne briše fajlove niti zatvara aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje verktyg nedan skannar bara sitt eget område. Knappen ovan kör rensnings-, worktree-, dubblett- och systemkontrollerna tillsammans. Skanning raderar aldrig filer eller avslutar appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağıdaki her araç yalnızca kendi alanını tarar. Yukarıdaki düğme temizlik, worktree, kopya ve sistem denetimlerini birlikte çalıştırır. Tarama asla dosya silmez veya uygulamalardan çıkmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下面的每个工具只扫描各自的区域。上方的按钮会一并运行清理、worktree、重复项和系统检查。扫描绝不会删除文件或退出 App。"
          }
        }
      }
    },
