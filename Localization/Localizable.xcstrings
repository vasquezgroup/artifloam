        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su copia más reciente tiene más de un mes, o no hay ninguna. En el %@: Configuración, tu nombre, iCloud, Copia de iCloud, Realizar copia de seguridad ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa sauvegarde la plus récente date de plus d’un mois, ou il n’y en a pas. Sur l’%@ : Réglages, votre nom, iCloud, Sauvegarde iCloud, Sauvegarder maintenant."
          }
