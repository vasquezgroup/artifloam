    "Used recently. You can still clean it; its app will likely rebuild it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استُخدمت مؤخرًا. لا يزال بإمكانك تنظيفها؛ على الأرجح سيعيد تطبيقها بناءها."
          }
        },
        "ca" : {
          "stringUnit" : {
