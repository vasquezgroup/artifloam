        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode ya no puede ejecutarlo. Se elimina con el propio simctl de Xcode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode ne peut plus l’exécuter. Retiré par la commande simctl de Xcode."
