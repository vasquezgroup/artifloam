    "Files in the Trash use space until it's emptied." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملفات في سلة المهملات تشغل مساحة إلى أن تُفرغ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els arxius de la paperera ocupen espai fins que es buida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien im Papierkorb belegen Platz, bis er geleert wird."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files in the Bin use space until it's emptied."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files in the Trash use space until it's emptied."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files in the Bin use space until it's emptied."
          }
        },
        "es" : {
