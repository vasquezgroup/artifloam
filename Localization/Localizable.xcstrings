    "A Claude Code or Codex session used it in the last 24 hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدمته جلسة Claude Code أو Codex خلال آخر 24 ساعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sessió de Claude Code o Codex l’ha usat en les últimes 24 hores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sitzung von Claude Code oder Codex hat es in den letzten 24 Stunden verwendet."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
