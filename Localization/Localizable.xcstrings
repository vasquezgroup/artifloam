          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asked %@ to quit. Save any changes if it asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha pedido a %@ que salga. Guarda los cambios si te lo pide."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha pedido a %@ que salga. Guarda los cambios si te lo pide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande de quitter envoyée à %@. Enregistrez les modifications s’il vous le demande."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isch zum Beände ufgforderet worde. Speicher Änderige, falls es dich fraagt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से बंद होने को कहा गया। अगर वह कहे, तो बदलाव सहेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatraženo zatvaranje: %@. Spremi promjene ako to zatraži."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiusura richiesta a %@. Salva le modifiche se te lo chiede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に終了を求めました。求められたら、変更を保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 종료를 요청했습니다. 요청하면 변경 사항을 저장하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lūgta aizvērties. Ja tā prasa, saglabā izmaiņas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproszono %@ o zakończenie. Zapisz zmiany, jeśli o to zapyta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedido a %@ para sair. Guarde as alterações, se lhe for pedido."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I kërkova %@ të mbyllet. Ruaj çdo ndryshim nëse të kërkon."
