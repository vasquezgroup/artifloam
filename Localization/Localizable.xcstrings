    "Full Disk Access is optional. It lets Artifloam measure the Trash, Safari, Chrome and other protected folders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول الكامل إلى القرص اختياري. يتيح لـ Artifloam قياس سلة المهملات وSafari وChrome وغيرها من المجلدات المحمية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
