        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行状況は完了したチェックの数を表しており、残り時間の見積もりではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행률은 남은 시간의 추정치가 아니라 완료된 점검 수를 나타냅니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress skaita pabeigtās pārbaudes, nevis atlikušā laika aprēķinu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postęp liczy ukończone kontrole, a nie szacowany pozostały czas."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso conta as verificações concluídas, não é uma estimativa do tempo restante."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përparimi numëron kontrollet e përfunduara, jo një vlerësim të kohës së mbetur."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напредак броји завршене провере, а не процену преосталог времена."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napredak broji završene provere, a ne procenu preostalog vremena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förloppet räknar slutförda kontroller, inte en uppskattning av återstående tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerleme, kalan sürenin tahminini değil, tamamlanan denetimleri sayar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度统计的是已完成的检查，而不是对剩余时间的估计。"
          }
        }
      }
    },
