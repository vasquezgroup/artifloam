          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre cópias exatas na sua pasta pessoal pelo conteúdo. Mantenha uma e mova as restantes para o Lixo."
          }
        },
        "sq" : {
          "stringUnit" : {
