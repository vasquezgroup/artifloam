    "System-managed data. This version does not request administrator access or remove these files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات يديرها النظام. لا يطلب هذا الإصدار وصول المسؤول ولا يزيل هذه الملفات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
