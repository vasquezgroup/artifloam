        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de tus proyectos. Nunca se marcan por ti: puede que un proyecto aún los necesite. Los archivos con seguimiento de Git no aparecen en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans vos projets. Jamais coché pour vous : un projet peut encore en avoir besoin. Les fichiers suivis par Git ne sont pas listés."
