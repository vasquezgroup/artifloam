          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie Twoje urządzenie %1$@ zajmuje o %2$@ mniej. iOS może potrzebować czasu, aby zwolnić więcej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até agora o seu %1$@ usa menos %2$@. O iOS pode demorar a libertar mais."
