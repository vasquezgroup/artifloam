            "value" : "Removing %1$@ from your %2$@. Keep it unlocked and connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitando %1$@ de tu %2$@. Mantenlo desbloqueado y conectado."
