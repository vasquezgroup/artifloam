        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This may hold your login codes. Without them or a recovery option, you can get locked out of your accounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede contener tus códigos de inicio de sesión. Sin ellos ni una opción de recuperación, puedes quedarte sin acceso a tus cuentas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede contener tus códigos de inicio de sesión. Sin ellos ni una opción de recuperación, puedes quedarte sin acceso a tus cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut contenir vos codes de connexion. Sans eux ni option de récupération, vous pouvez perdre l’accès à vos comptes."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do chönd dini Login-Code drin si. Ohni si oder e Wiederherstelligsoption chasch us dine Konte usgsperrt werde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसमें आपके लॉगइन कोड हो सकते हैं। उनके या रिकवरी विकल्प के बिना, आप अपने खातों से बाहर हो सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo može sadržavati tvoje kodove za prijavu. Bez njih ili opcije oporavka možeš ostati zaključan iz svojih računa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe contenere i tuoi codici di accesso. Senza di essi o un'opzione di recupero, potresti restare bloccato fuori dai tuoi account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインコードが含まれている可能性があります。コードや復旧手段がないと、アカウントにアクセスできなくなることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 코드가 들어 있을 수 있습니다. 코드나 복구 수단이 없으면 계정에 접근하지 못할 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajā var būt tavi pieteikšanās kodi. Bez tiem vai atkopšanas iespējas tu vari zaudēt piekļuvi saviem kontiem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może zawierać Twoje kody logowania. Bez nich lub bez opcji odzyskiwania możesz zostać zablokowany na swoich kontach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode conter os seus códigos de início de sessão. Sem eles ou uma opção de recuperação, pode ficar sem acesso às suas contas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo mund të mbajë kodet e tua të hyrjes. Pa to ose pa një opsion rikuperimi, mund të mbyllesh jashtë llogarive të tua."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ово може садржати ваше кодове за пријаву. Без њих или опције опоравка можете остати закључани из својих налога."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
