    "Review installed apps and move selected app bundles to Trash. Running and system apps stay protected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع التطبيقات المثبّتة وانقل حزم التطبيقات المحدّدة إلى سلة المهملات. التطبيقات قيد التشغيل وتطبيقات النظام تبقى محمية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa les apps instal·lades i mou els paquets d’app seleccionats a la paperera. Les apps en execució i les del sistema queden protegides."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh installierte Apps durch und lege ausgewählte App-Pakete in den Papierkorb. Laufende Apps und Systemapps bleiben geschützt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review installed apps and move selected app bundles to Bin. Running and system apps stay protected."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review installed apps and move selected app bundles to Trash. Running and system apps stay protected."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review installed apps and move selected app bundles to Bin. Running and system apps stay protected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa las apps instaladas y mueve a la Papelera los paquetes de app seleccionados. Las apps en ejecución y las del sistema permanecen protegidas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa las apps instaladas y mueve al Basurero los paquetes de app seleccionados. Las apps en ejecución y las del sistema permanecen protegidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinez les apps installées et placez les bundles d’apps sélectionnés dans la Corbeille. Les apps en cours d’exécution et celles du système restent protégées."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüef installierti Apps und verschieb uusgwählti App-Bundles id Papierkorb. Laufendi Apps und System-Apps blibed gschützt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंस्टॉल किए गए ऐप की समीक्षा करें और चुने गए ऐप बंडल रद्दी में भेजें। चल रहे और सिस्टम ऐप संरक्षित रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledaj instalirane aplikacije i premjesti odabrane pakete aplikacija u Smeće. Pokrenute i sistemske aplikacije ostaju zaštićene."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedi le app installate e sposta i pacchetti selezionati nel Cestino. Le app in esecuzione e di sistema restano protette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのアプリを確認し、選択したアプリバンドルをゴミ箱に移動します。実行中のアプリとシステムのアプリは保護されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 앱을 검토하고 선택한 앱 번들을 휴지통으로 이동합니다. 실행 중인 앱과 시스템 앱은 보호됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārskati uzstādītās lietotnes un pārvieto atlasītās lietotņu pakotnes uz Atkritni. Darbojošās un sistēmas lietotnes paliek aizsargātas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzyj zainstalowane aplikacje i przenieś zaznaczone pakiety aplikacji do Kosza. Uruchomione i systemowe aplikacje pozostają chronione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja as apps instaladas e mova os pacotes de apps selecionados para o Lixo. As apps em execução e do sistema ficam protegidas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rishiko aplikacionet e instaluara dhe zhvendos paketat e zgjedhura në Kosh. Aplikacionet në punë dhe ato të sistemit mbeten të mbrojtura."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прегледајте инсталиране апликације и преместите изабране пакете апликација у Отпад. Покренуте и системске апликације остају заштићене."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte instalirane aplikacije i premestite izabrane pakete aplikacija u Otpad. Pokrenute i sistemske aplikacije ostaju zaštićene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska installerade appar och flytta valda appbuntar till papperskorgen. Appar som körs och systemappar förblir skyddade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulu uygulamaları inceleyin ve seçili uygulama paketlerini Çöp Sepeti’ne taşıyın. Çalışan ve sistem uygulamaları korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审阅已安装的 App，并将所选的 App 包移到废纸篓。正在运行的 App 和系统 App 保持受保护。"
          }
        }
      }
