            "value" : "Registro de aplicación reconocido con más de 30 días de antigüedad; se conservan los ajustes y el historial de conversaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registro de aplicación reconocido con más de 30 días de antigüedad; se conservan los ajustes y el historial de conversaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journal d’application reconnu de plus de 30 jours ; les réglages et l’historique des conversations sont conservés."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannts App-Log, wo älter isch als 30 Täg; Iistellige und Gsprächsverlauf blibed erhalte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 दिन से पुराना पहचाना गया ऐप्लिकेशन लॉग; सेटिंग और बातचीत का इतिहास रखे जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepoznat zapis aplikacije stariji od 30 dana; postavke i povijest razgovora zadržavaju se."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log applicativo riconosciuto più vecchio di 30 giorni; impostazioni e cronologia delle conversazioni vengono conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30日より古い、認識されたアプリケーションのログ。設定と会話履歴は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30일보다 오래된, 인식된 앱 로그. 설정과 대화 기록은 유지됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atpazīts lietotnes žurnāls, vecāks par 30 dienām; iestatījumi un sarunu vēsture tiek paturēti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznany dziennik aplikacji starszy niż 30 dni; ustawienia i historia rozmów są zachowywane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log de app reconhecido com mais de 30 dias; as definições e o histórico de conversas são mantidos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regjistër i njohur aplikacioni më i vjetër se 30 ditë; cilësimet dhe historiku i bisedave mbahen."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Препознат лог апликације старији од 30 дана; подешавања и историја разговора се задржавају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepoznat log aplikacije stariji od 30 dana; podešavanja i istorija razgovora se zadržavaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känd programlogg äldre än 30 dagar; inställningar och konversationshistorik behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 günden eski, tanınan uygulama günlüğü; ayarlar ve konuşma geçmişi korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已识别的、超过 30 天的 App 日志；设置和对话历史会保留。"
          }
        }
      }
    },
