    "Asked %@ to quit. Save any changes if it asks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طُلب من %@ أن ينتهي. احفظ أي تغييرات إذا طلب ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha demanat a %@ que es tanqui. Desa els canvis si t’ho demana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde zum Beenden aufgefordert. Sichere Änderungen, falls es nachfragt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asked %@ to quit. Save any changes if it asks."
          }
