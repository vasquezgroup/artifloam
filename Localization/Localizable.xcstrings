        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git no está disponible. Las cachés que dependen de Git siguen protegidas y se omiten las comprobaciones de worktrees; instala Git o las Command Line Tools para activar la verificación."
          }
