    "Project idle for 30+ days. Reinstall with the project's package manager when you need it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المشروع خامل منذ أكثر من 30 يومًا. أعد التثبيت بمدير حزم المشروع عندما تحتاج إليه مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projecte inactiu fa més de 30 dies. Reinstal·la’l amb el gestor de paquets del projecte quan el tornis a necessitar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt seit mehr als 30 Tagen inaktiv. Installiere es mit dem Paketmanager des Projekts neu, wenn du es wieder brauchst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project idle for 30+ days. Reinstall with the project's package manager when you need it again."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project idle for 30+ days. Reinstall with the project's package manager when you need it again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project idle for 30+ days. Reinstall with the project's package manager when you need it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyecto inactivo desde hace más de 30 días. Reinstala con el gestor de paquetes del proyecto cuando lo necesites de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyecto inactivo desde hace más de 30 días. Reinstala con el gestor de paquetes del proyecto cuando lo necesites de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projet inactif depuis 30 jours ou plus. Réinstallez avec le gestionnaire de paquets du projet quand vous en avez de nouveau besoin."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt sit über 30 Täg inaktiv. Installier es mit em Package-Manager vom Projekt neu, wenn du's wieder bruuchsch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोजेक्ट 30+ दिनों से निष्क्रिय है। जब दोबारा ज़रूरत हो, प्रोजेक्ट के पैकेज मैनेजर से फिर इंस्टॉल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt neaktivan 30+ dana. Ponovno instaliraj upraviteljem paketa projekta kad ti opet zatreba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progetto inattivo da 30 giorni o più. Reinstalla con il gestore di pacchetti del progetto quando ti serve di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトは30日以上アイドル状態です。また必要になったら、プロジェクトのパッケージマネージャで再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30일 이상 유휴 상태인 프로젝트입니다. 다시 필요하면 프로젝트의 패키지 관리자로 다시 설치하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekts neaktīvs 30+ dienas. Kad tas atkal vajadzīgs, uzstādi vēlreiz ar projekta pakotņu pārvaldnieku."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt nieużywany od co najmniej 30 dni. Zainstaluj ponownie menedżerem pakietów projektu, gdy znów będzie potrzebny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projeto inativo há mais de 30 dias. Reinstale com o gestor de pacotes do projeto quando voltar a precisar dele."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt joaktiv për 30+ ditë. Riinstalo me menaxherin e paketave të projektit kur ta duash përsëri."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пројекат неактиван 30+ дана. Поново инсталирајте помоћу менаџера пакета пројекта када вам поново затреба."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekat neaktivan 30+ dana. Ponovo instalirajte pomoću menadžera paketa projekta kada vam ponovo zatreba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektet har varit inaktivt i 30+ dagar. Installera om med projektets pakethanterare när du behöver det igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proje 30+ gündür boşta. Tekrar gerektiğinde projenin paket yöneticisiyle yeniden kurun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目已闲置 30 天以上。需要再次使用时，请用该项目的包管理器重新安装。"
          }
        }
      }
    },
