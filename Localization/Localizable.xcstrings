    "Emptying is permanent. To keep something, open the Trash in Finder and use Put Back first. File names stay on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإفراغ نهائي. للإبقاء على شيء، افتح سلة المهملات في فايندر واستخدم إرجاع أولًا. تبقى أسماء الملفات على هذا الـ Mac."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buidar-la és definitiu. Per conservar alguna cosa, obre la paperera al Finder i fes servir «Recupera» abans. Els noms dels arxius es queden en aquest Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Leeren ist endgültig. Um etwas zu behalten, öffne den Papierkorb im Finder und wähle zuerst „Zurücklegen“. Dateinamen bleiben auf diesem Mac."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emptying is permanent. To keep something, open the Bin in Finder and use Put Back first. File names stay on this Mac."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emptying is permanent. To keep something, open the Trash in Finder and use Put Back first. File names stay on this Mac."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emptying is permanent. To keep something, open the Bin in Finder and use Put Back first. File names stay on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaciar es permanente. Para conservar algo, abre la Papelera en el Finder y usa antes Sacar de la papelera. Los nombres de los archivos se quedan en este Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaciar es permanente. Para conservar algo, abre el Basurero en el Finder y usa antes Sacar del basurero. Los nombres de los archivos se quedan en esta Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vidage est définitif. Pour conserver quelque chose, ouvrez la Corbeille dans le Finder et utilisez d’abord Remettre. Les noms de fichiers restent sur ce Mac."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S Leere isch endgültig. Wenn du öppis wotsch behalte, öffne zerscht de Papierkorb im Finder und bruuch «Zurücklegen». D Dateiname blibed uf dem Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाली करना स्थायी है। कुछ रखना हो, तो पहले Finder में रद्दी खोलें और “वापस रखें” का उपयोग करें। फ़ाइल नाम इसी Mac पर रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pražnjenje je trajno. Da bi nešto zadržao, prvo otvori Smeće u Finderu i upotrijebi Vrati. Nazivi datoteka ostaju na ovom Macu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo svuotamento è definitivo. Per conservare qualcosa, apri il Cestino nel Finder e usa prima Ripristina. I nomi dei file restano su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空にすると元に戻せません。残したいものがある場合は、先にFinderでゴミ箱を開き、「戻す」を使ってください。ファイル名はこのMacにとどまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비우면 영구적으로 삭제됩니다. 남기려면 먼저 Finder에서 휴지통을 열고 ‘되돌려 놓기’를 사용하세요. 파일 이름은 이 Mac에 남습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iztukšošana ir neatgriezeniska. Lai kaut ko paturētu, vispirms atver Atkritni Finder un izmanto Ielikt atpakaļ. Failu nosaukumi paliek šajā Mac datorā."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opróżnienie jest nieodwracalne. Aby coś zachować, najpierw otwórz Kosz w Finderze i użyj polecenia Przywróć z Kosza. Nazwy plików zostają na tym Macu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esvaziar é permanente. Para manter algo, abra o Lixo no Finder e use Repor primeiro. Os nomes dos ficheiros ficam neste Mac."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boshatisja është e përhershme. Për të mbajtur diçka, hap Koshin në Finder dhe përdor më parë Kthe mbrapsht. Emrat e skedarëve mbeten në këtë Mac."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пражњење је трајно. Да бисте нешто задржали, прво отворите Отпад у Finder-у и користите Врати назад. Имена фајлова остају на овом Mac-у."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pražnjenje je trajno. Da biste nešto zadržali, prvo otvorite Otpad u Finder-u i koristite Vrati nazad. Imena fajlova ostaju na ovom Mac-u."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tömningen är permanent. Om du vill behålla något, öppna papperskorgen i Finder och använd Lägg tillbaka först. Filnamnen finns kvar på den här Macen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşaltma kalıcıdır. Bir şeyi korumak için önce Finder’da Çöp Sepeti’ni açıp Yerine Koy’u kullanın. Dosya adları bu Mac’te kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清倒是永久性的。若要保留某项内容，请先在访达中打开废纸篓并使用“放回原处”。文件名会留在这台 Mac 上。"
          }
        }
      }
    },
