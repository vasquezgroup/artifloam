          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの動作が遅くなる可能性があります。使っていないアプリを終了してください。先に作業内容を保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 속도가 느려질 수 있습니다. 사용하지 않는 앱을 종료하세요. 먼저 작업 내용을 저장하세요."
          }
        },
        "lv" : {
