    "Your own files stay exactly where they are. This removes only what Artifloam created, and the Trash keeps it until you empty the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى ملفاتك الخاصة تمامًا حيث هي. هذا يزيل فقط ما أنشأه Artifloam، وتحتفظ به سلة المهملات إلى أن تُفرغها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els teus propis arxius es queden exactament on són. Això només elimina el que ha creat Artifloam, i la paperera ho conserva fins que la buidis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine eigenen Dateien bleiben genau dort, wo sie sind. Entfernt wird nur, was Artifloam erstellt hat, und der Papierkorb behält es, bis du ihn leerst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your own files stay exactly where they are. This removes only what Artifloam created, and the Bin keeps it until you empty the Bin."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your own files stay exactly where they are. This removes only what Artifloam created, and the Trash keeps it until you empty the Trash."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your own files stay exactly where they are. This removes only what Artifloam created, and the Bin keeps it until you empty the Bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus propios archivos se quedan exactamente donde están. Esto elimina solo lo que creó Artifloam, y la Papelera lo conserva hasta que la vacíes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus propios archivos se quedan exactamente donde están. Esto elimina solo lo que creó Artifloam, y el Basurero lo conserva hasta que lo vacíes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos propres fichiers restent exactement où ils sont. Cela ne retire que ce qu’Artifloam a créé, et la Corbeille le conserve jusqu’à ce que vous la vidiez."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dini eigene Dateie blibed genau det, wo si sind. Das entfernt nume, was Artifloam erstellt hät, und de Papierkorb behaltet es, bis du de Papierkorb leerisch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी अपनी फ़ाइलें ठीक वहीं रहती हैं जहाँ हैं। यह केवल वही हटाता है जो Artifloam ने बनाया, और रद्दी उसे तब तक रखती है जब तक आप रद्दी खाली नहीं करते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje vlastite datoteke ostaju točno gdje jesu. Ovo uklanja samo ono što je Artifloam stvorio, a Smeće to drži dok ga ne isprazniš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi file restano esattamente dove sono. Questo rimuove solo ciò che ha creato Artifloam, e il Cestino lo conserva finché non lo svuoti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身のファイルは、そのままの場所に残ります。削除されるのはArtifloamが作成したものだけで、ゴミ箱を空にするまでゴミ箱に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 파일은 있던 그대로 남습니다. Artifloam이 만든 것만 제거하며, 휴지통을 비우기 전까지는 휴지통에 보관됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavi paša faili paliek tieši tur, kur ir. Tiek noņemts tikai tas, ko izveidoja Artifloam, un Atkritne to glabā, līdz iztukšo Atkritni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje własne pliki zostają dokładnie tam, gdzie są. To usuwa tylko to, co utworzył Artifloam, a Kosz zachowuje to, dopóki go nie opróżnisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus próprios ficheiros ficam exatamente onde estão. Isto remove apenas o que o Artifloam criou, e o Lixo guarda-o até esvaziar o Lixo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skedarët e tu mbeten saktësisht aty ku janë. Kjo heq vetëm çfarë ka krijuar Artifloam, dhe Koshi e mban derisa ta boshatisësh Koshin."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши лични фајлови остају тачно тамо где су. Ово уклања само оно што је Artifloam направио, а Отпад то задржава док не испразните Отпад."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši lični fajlovi ostaju tačno tamo gde su. Ovo uklanja samo ono što je Artifloam napravio, a Otpad to zadržava dok ne ispraznite Otpad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina egna filer stannar exakt där de är. Detta tar bara bort det som Artifloam har skapat, och papperskorgen behåller det tills du tömmer papperskorgen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi dosyalarınız olduğu yerde kalır. Bu yalnızca Artifloam’ın oluşturduklarını kaldırır ve Çöp Sepeti’ni siz boşaltana dek Çöp Sepeti bunları tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你自己的文件会原封不动留在原处。这只会移除 Artifloam 创建的内容，并且在你清倒废纸篓之前，废纸篓会一直保留它。"
          }
        }
      }
    },
