    "System Events did not answer. Allow Artifloam to control System Events in System Settings → Privacy & Security → Automation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب System Events. اسمح لـ Artifloam بالتحكم في System Events من إعدادات النظام ← الخصوصية والأمن ← التحكم التلقائي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events no ha respost. Permet que Artifloam controli System Events a Configuració del Sistema → Privacitat i seguretat → Automatització."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events hat nicht geantwortet. Erlaube Artifloam in Systemeinstellungen → Datenschutz & Sicherheit → Automation, System Events zu steuern."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events did not answer. Allow Artifloam to control System Events in System Settings → Privacy & Security → Automation."
          }
        },
        "en-CA" : {
          "stringUnit" : {
