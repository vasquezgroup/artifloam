          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib de Code uf em %@ ii. Artifloam macht vo sich uus wiiter, sobald är entsperrt isch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर अपना पासकोड डालें। अनलॉक होते ही Artifloam अपने आप आगे बढ़ जाता है।"
          }
        },
        "hr" : {
