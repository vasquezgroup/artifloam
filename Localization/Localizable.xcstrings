    "Matched by content (SHA-256), not by file name. One copy always stays, and the Trash lets you put files back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم المطابقة حسب المحتوى (SHA-256) لا حسب اسم الملف. تبقى نسخة واحدة دائمًا، وتتيح لك سلة المهملات إرجاع الملفات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincidència pel contingut (SHA-256), no pel nom de l’arxiu. Sempre es conserva una còpia, i la paperera et permet recuperar els arxius."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgeglichen nach Inhalt (SHA-256), nicht nach Dateiname. Eine Kopie bleibt immer erhalten, und über den Papierkorb kannst du Dateien zurücklegen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matched by content (SHA-256), not by file name. One copy always stays, and the Bin lets you put files back."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matched by content (SHA-256), not by file name. One copy always stays, and the Trash lets you put files back."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matched by content (SHA-256), not by file name. One copy always stays, and the Bin lets you put files back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comparan por contenido (SHA-256), no por nombre de archivo. Siempre se conserva una copia, y la Papelera te permite devolver los archivos a su sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comparan por contenido (SHA-256), no por nombre de archivo. Siempre se conserva una copia, y el Basurero te permite devolver los archivos a su sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparés par contenu (SHA-256), pas par nom de fichier. Une copie reste toujours, et la Corbeille permet de remettre les fichiers."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuegordnet nach Inhalt (SHA-256), nöd nach Dateiname. Eini Kopie blibt immer erhalte, und us em Papierkorb chasch du Dateie zrugglegge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री (SHA-256) से मिलान, फ़ाइल नाम से नहीं। एक प्रति हमेशा रहती है, और रद्दी से आप फ़ाइलें वापस रख सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podudaranje po sadržaju (SHA-256), a ne po nazivu datoteke. Jedna kopija uvijek ostaje, a Smeće ti omogućuje vraćanje datoteka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confrontati per contenuto (SHA-256), non per nome file. Una copia resta sempre, e il Cestino ti permette di ripristinare i file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容(SHA-256)で一致を判定し、ファイル名では判定しません。1つのコピーは必ず残り、ゴミ箱からファイルを戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름이 아닌 내용(SHA-256)으로 일치시킵니다. 사본 하나는 항상 남으며, 휴지통에서 파일을 되돌려 놓을 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atbilstība pēc satura (SHA-256), nevis pēc faila nosaukuma. Viena kopija vienmēr paliek, un no Atkritnes failus var ielikt atpakaļ."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowane według zawartości (SHA-256), nie według nazwy pliku. Jedna kopia zawsze zostaje, a z Kosza możesz przywrócić pliki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correspondência por conteúdo (SHA-256), não por nome de ficheiro. Uma cópia fica sempre e o Lixo permite repor os ficheiros."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përputhja bëhet sipas përmbajtjes (SHA-256), jo sipas emrit të skedarit. Një kopje mbetet gjithmonë, dhe Koshi të lejon t'i kthesh skedarët mbrapsht."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поклапање по садржају (SHA-256), а не по имену фајла. Једна копија увек остаје, а Отпад вам омогућава да вратите фајлове."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poklapanje po sadržaju (SHA-256), a ne po imenu fajla. Jedna kopija uvek ostaje, a Otpad vam omogućava da vratite fajlove."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchade efter innehåll (SHA-256), inte efter filnamn. En kopia finns alltid kvar, och med papperskorgen kan du lägga tillbaka filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya adına göre değil, içeriğe (SHA-256) göre eşleşti. Bir kopya her zaman kalır ve Çöp Sepeti dosyaları geri koymanıza izin verir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按内容 (SHA-256) 匹配，而不是按文件名。始终会保留一个副本，且可通过废纸篓放回文件。"
          }
        }
      }
    },
