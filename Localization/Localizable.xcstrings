    "Artifloam can't write to its own folder. Move it to Applications, or download the update from vasquezgroup.ch/artifloam." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Artifloam الكتابة في مجلده. انقله إلى التطبيقات، أو نزّل التحديث من vasquezgroup.ch/artifloam."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam no pot escriure a la seva pròpia carpeta. Mou-lo a Apps o baixa l’actualització de vasquezgroup.ch/artifloam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
