    "You have version %@. Artifloam downloads the update, checks that it's genuine, and reopens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك الإصدار %@. ينزّل Artifloam التحديث ويتحقق من أصالته ثم يعيد الفتح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens la versió %@. Artifloam baixa l’actualització, comprova que és autèntica i es torna a obrir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Version %@. Artifloam lädt das Update herunter, prüft, dass es echt ist, und öffnet sich erneut."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have version %@. Artifloam downloads the update, checks that it's genuine, and reopens."
          }
        },
        "en-CA" : {
          "stringUnit" : {
