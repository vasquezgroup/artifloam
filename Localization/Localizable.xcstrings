    "Only your own launch agents can be switched here. Use System Settings for items shared by all users." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تبديل غير وكلاء الإطلاق الخاصة بك هنا. استخدم إعدادات النظام للعناصر المشتركة بين كل المستخدمين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí només es poden canviar els teus propis agents d’inici. Fes servir Configuració del Sistema per als ítems compartits per tots els usuaris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier lassen sich nur deine eigenen Launch-Agents schalten. Nutze die Systemeinstellungen für Objekte, die alle Benutzer teilen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your own launch agents can be switched here. Use System Settings for items shared by all users."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your own launch agents can be switched here. Use System Settings for items shared by all users."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your own launch agents can be switched here. Use System Settings for items shared by all users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí solo se pueden activar o desactivar tus propios launch agents. Usa Ajustes del Sistema para los elementos compartidos por todos los usuarios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí solo se pueden activar o desactivar tus propios launch agents. Usa Configuración del Sistema para los elementos compartidos por todos los usuarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls vos propres agents de lancement peuvent être activés ou désactivés ici. Utilisez Réglages Système pour les éléments partagés par tous les utilisateurs."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do chönd nume dini eigene Launch Agents gschaltet werde. Bruuch d Systemeinstellungen für Elemente, wo für alli Benutzer gelted."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ केवल आपके अपने लॉन्च एजेंट बदले जा सकते हैं। सभी उपयोगकर्ताओं के साझा आइटम के लिए सिस्टम सेटिंग का उपयोग करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovdje se mogu prebacivati samo tvoji vlastiti launch agenti. Za stavke koje dijele svi korisnici koristi Postavke sustava."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui si possono attivare o disattivare solo i tuoi agenti di avvio. Usa Impostazioni di Sistema per gli elementi condivisi da tutti gli utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで切り替えられるのは、ご自身の起動エージェントのみです。全ユーザで共有される項目は、システム設定を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서는 본인의 launch agent만 전환할 수 있습니다. 모든 사용자가 공유하는 항목은 시스템 설정을 사용하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šeit var pārslēgt tikai tavus palaišanas aģentus. Visiem lietotājiem kopīgiem vienumiem izmanto Sistēmas iestatījumus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj można przełączać tylko własne agenty uruchamiania. Elementy współdzielone przez wszystkich użytkowników zmieniaj w Ustawieniach systemowych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui só é possível ativar ou desativar os seus próprios agentes de arranque. Use as Definições para itens partilhados por todos os utilizadores."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Këtu mund të ndërrohen vetëm agjentët e tu të nisjes. Përdor Cilësimet e sistemit për elementët e përbashkët për të gjithë përdoruesit."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овде можете да пребацујете само своје launch agents. За ставке које деле сви корисници користите Системска подешавања."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovde možete da prebacujete samo svoje launch agents. Za stavke koje dele svi korisnici koristite Sistemska podešavanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara dina egna launch agents kan slås av och på här. Använd Systeminställningar för objekt som delas av alla användare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada yalnızca kendi başlatma ajanlarınız açılıp kapatılabilir. Tüm kullanıcılarla paylaşılan öğeler için Sistem Ayarları’nı kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里只能切换你自己的启动代理。对于所有用户共享的项目，请使用“系统设置”。"
          }
        }
      }
    },
