    "Backing up your %@. Keep it unlocked and connected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ إنشاء نسخة احتياطية من الـ %@. أبقِه مفتوح القفل ومتصلًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fent la còpia de l’%@. Mantén-lo desbloquejat i connectat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@ wird gesichert. Lass es entsperrt und verbunden."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backing up your %@. Keep it unlocked and connected."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backing up your %@. Keep it unlocked and connected."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
