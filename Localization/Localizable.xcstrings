    "Totals count since this Mac started. Rates show current traffic, not your connection's top speed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب الإجماليات منذ بدء تشغيل هذا الـ Mac. تُظهر المعدلات حركة البيانات الحالية، لا أقصى سرعة لاتصالك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els totals compten des que el Mac es va iniciar. Les velocitats mostren el trànsit actual, no la velocitat màxima de la teva connexió."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summen zählen seit dem Start dieses Mac. Raten zeigen den aktuellen Datenverkehr, nicht die Höchstgeschwindigkeit deiner Verbindung."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totals count since this Mac started. Rates show current traffic, not your connection's top speed."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totals count since this Mac started. Rates show current traffic, not your connection's top speed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totals count since this Mac started. Rates show current traffic, not your connection's top speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los totales cuentan desde que se inició este Mac. Las velocidades muestran el tráfico actual, no la velocidad máxima de tu conexión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los totales cuentan desde que se inició esta Mac. Las velocidades muestran el tráfico actual, no la velocidad máxima de tu conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les totaux comptent depuis le démarrage de ce Mac. Les débits montrent le trafic actuel, pas la vitesse maximale de votre connexion."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D Totalwärt zelled sit em Start vo dem Mac. D Rate zeiged dr aktuelle Datenverkehr, nöd d Maximalgschwindigkeit vo diner Verbindig."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुल संख्या इस Mac के शुरू होने से गिनी जाती है। दरें मौजूदा ट्रैफ़िक दिखाती हैं, आपके कनेक्शन की अधिकतम गति नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbrojevi broje od pokretanja ovog Maca. Brzine prikazuju trenutni promet, a ne maksimalnu brzinu tvoje veze."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I totali contano dall'avvio di questo Mac. Le velocità mostrano il traffico attuale, non la massima velocità della tua connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計は、このMacの起動後から数えたものです。速度は現在のトラフィックを示すもので、回線の最高速度ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "합계는 이 Mac을 시작한 이후의 값입니다. 속도는 현재 트래픽이며, 연결의 최고 속도가 아닙니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopsummas skaita kopš šī Mac startēšanas. Ātrumi rāda pašreizējo satiksmi, nevis tava savienojuma maksimālo ātrumu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumy liczone są od uruchomienia tego Maca. Przepływności pokazują bieżący ruch, a nie maksymalną prędkość Twojego połączenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os totais contam desde que este Mac iniciou. As taxas mostram o tráfego atual, não a velocidade máxima da sua ligação."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalet numërojnë nga nisja e këtij Mac-u. Shpejtësitë tregojnë trafikun aktual, jo shpejtësinë maksimale të lidhjes tënde."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укупне вредности броје од покретања овог Mac-а. Брзине показују тренутни саобраћај, а не највећу брзину ваше везе."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukupne vrednosti broje od pokretanja ovog Mac-a. Brzine pokazuju trenutni saobraćaj, a ne najveću brzinu vaše veze."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalerna räknas sedan den här Macen startade. Hastigheterna visar aktuell trafik, inte din anslutnings topphastighet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplamlar bu Mac başladığından beri sayılır. Hızlar, bağlantınızın en yüksek hızını değil, anlık trafiği gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总量从这台 Mac 启动时开始计算。速率显示的是当前流量，而不是你网络连接的最高速度。"
          }
        }
      }
    },
