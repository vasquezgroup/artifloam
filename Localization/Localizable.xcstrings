        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état Git, les commits préservés, l’activité des sessions et les processus en cours déterminent si un checkout doit être examiné. Les worktrees ne sont jamais retirés automatiquement."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git-Status, bhaltini Commits, Session-Aktivität und laufendi Prozesse entscheided, ob en Checkout Prüefig bruucht. Worktrees werded nie automatisch entfernt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git स्थिति, सुरक्षित रखे गए कमिट, सेशन गतिविधि और चल रही प्रोसेस तय करती हैं कि किसी चेकआउट की समीक्षा चाहिए या नहीं। worktree कभी अपने आप नहीं हटाए जाते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git status, sačuvani commiti, aktivnost sesija i pokrenuti procesi odlučuju treba li checkout pregled. Worktreeovi se nikad ne uklanjaju automatski."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stato Git, commit preservati, attività di sessione e processi in esecuzione decidono se un checkout richiede revisione. I worktree non vengono mai rimossi automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitの状態、保存されたコミット、セッションのアクティビティ、実行中のプロセスによって、チェックアウトに確認が必要かどうかが決まります。worktreeが自動で削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 상태, 보존된 커밋, 세션 활동, 실행 중인 프로세스에 따라 체크아웃의 검토 필요 여부가 결정됩니다. 워크트리는 자동으로 제거되지 않습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git statuss, saglabātie commit, sesiju aktivitāte un darbojošies procesi nosaka, vai checkout jāpārskata. Worktree nekad netiek noņemti automātiski."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status Git, zachowane commity, aktywność sesji i działające procesy decydują, czy checkout wymaga przeglądu. Worktree nigdy nie są usuwane automatycznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estado do Git, os commits preservados, a atividade das sessões e os processos em execução decidem se um checkout precisa de revisão. Os worktrees nunca são removidos automaticamente."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjendja e Git, commit-et e ruajtura, aktiviteti i sesioneve dhe proceset në punë vendosin nëse një checkout ka nevojë për rishikim. Worktree-t nuk hiqen kurrë automatikisht."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git статус, сачувани commits, активност сесије и покренути процеси одлучују да ли checkout треба преглед. Worktrees се никада не уклањају аутоматски."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git status, sačuvani commits, aktivnost sesije i pokrenuti procesi odlučuju da li checkout treba pregled. Worktrees se nikada ne uklanjaju automatski."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git-status, bevarade commits, sessionsaktivitet och processer som körs avgör om en checkout behöver granskas. Worktrees tas aldrig bort automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git durumu, korunan commit’ler, oturum etkinliği ve çalışan işlemler bir checkout’un incelenmesi gerekip gerekmediğine karar verir. Worktree’ler asla kendiliğinden kaldırılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 状态、保留的提交、会话活动和正在运行的进程，共同决定某个检出是否需要审阅。worktree 绝不会被自动移除。"
          }
        }
      }
    },
