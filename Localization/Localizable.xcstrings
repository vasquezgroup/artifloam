            "state" : "translated",
            "value" : "Solo son aptas las cachés reconocidas. Los archivos de código fuente, las credenciales y el trabajo sin terminar se conservan siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les caches reconnus sont éligibles. Les fichiers source, identifiants et travaux inachevés restent toujours."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nume erkannti Caches kämed i Frag. Quelldateie, Zuegangsdate und unfertigi Arbeit blibed immer erhalte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल पहचाने गए कैश पात्र हैं। सोर्स फ़ाइलें, क्रेडेंशियल और अधूरा काम हमेशा रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispunjavaju uvjete samo prepoznate predmemorije. Izvorne datoteke, vjerodajnice i nedovršen rad uvijek ostaju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono idonee solo le cache riconosciute. File sorgente, credenziali e lavoro non finito restano sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認識されたキャッシュのみが対象です。ソースファイル、認証情報、未完成の作業は常に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인식된 캐시만 대상이 됩니다. 소스 파일, 자격 증명, 끝나지 않은 작업은 항상 유지됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piemērotas ir tikai atpazītas kešatmiņas. Pirmkoda faili, akreditācijas dati un nepabeigts darbs vienmēr paliek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwalifikują się tylko rozpoznane pamięci podręczne. Pliki źródłowe, dane uwierzytelniające i niedokończona praca zawsze zostają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só as caches reconhecidas se qualificam. Os ficheiros de código-fonte, as credenciais e o trabalho por terminar ficam sempre."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualifikohen vetëm cache të njohura. Skedarët burimorë, kredencialet dhe puna e papërfunduar mbeten gjithmonë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само препознати кешеви испуњавају услове. Изворни фајлови, акредитиви и недовршен рад увек остају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo prepoznati keševi ispunjavaju uslove. Izvorni fajlovi, akreditivi i nedovršen rad uvek ostaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara kända cachar kan komma i fråga. Källfiler, inloggningsuppgifter och ofärdigt arbete behålls alltid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca tanınan önbellekler uygundur. Kaynak dosyalar, kimlik bilgileri ve bitmemiş işler her zaman kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有已识别的缓存才符合条件。源文件、凭据和未完成的工作始终保留。"
          }
        }
      }
    },
