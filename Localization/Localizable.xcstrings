        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données gérées par le système. Cette version ne demande pas d’accès administrateur et ne retire pas ces fichiers."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom System verwaltete Date. Die Version verlangt kei Administrator-Zuegriff und entfernt die Dateie nöd."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम-प्रबंधित डेटा। यह संस्करण एडमिनिस्ट्रेटर ऐक्सेस नहीं माँगता और इन फ़ाइलों को नहीं हटाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci kojima upravlja sustav. Ova verzija ne traži administratorski pristup niti uklanja ove datoteke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati gestiti dal sistema. Questa versione non richiede l'accesso da amministratore né rimuove questi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムが管理するデータです。このバージョンでは、管理者アクセスを要求せず、これらのファイルも削除しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템이 관리하는 데이터입니다. 이 버전은 관리자 접근 권한을 요청하거나 이 파일을 제거하지 않습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistēmas pārvaldīti dati. Šī versija nepieprasa administratora piekļuvi un nenoņem šos failus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane zarządzane przez system. Ta wersja nie żąda dostępu administratora ani nie usuwa tych plików."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados geridos pelo sistema. Esta versão não pede acesso de administrador nem remove estes ficheiros."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të dhëna të menaxhuara nga sistemi. Ky version nuk kërkon qasje administratori dhe nuk i heq këta skedarë."
