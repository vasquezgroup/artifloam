        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürüm %@ sizde yüklü. Artifloam güncellemeyi indirir, gerçek olduğunu denetler ve yeniden açılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的版本是 %@。Artifloam 会下载更新，检查其是否真实可信，然后重新打开。"
          }
        }
      }
    },
    "You stay signed in everywhere. Open browsers are skipped; quit one first to clean it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى تسجيل دخولك في كل مكان. يتم تخطي المتصفحات المفتوحة؛ أنهِ أحدها أولًا لتنظيفه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessió es manté a tot arreu. Els navegadors oberts s’ometen; tanca’n un primer per netejar-lo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bleibst überall angemeldet. Geöffnete Browser werden übersprungen; beende einen zuerst, um ihn zu bereinigen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stay signed in everywhere. Open browsers are skipped; quit one first to clean it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stay signed in everywhere. Open browsers are skipped; quit one first to clean it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stay signed in everywhere. Open browsers are skipped; quit one first to clean it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienes la sesión iniciada en todas partes. Los navegadores abiertos se omiten; cierra uno antes para limpiarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienes la sesión iniciada en todas partes. Los navegadores abiertos se omiten; cierra uno antes para limpiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous restez connecté partout. Les navigateurs ouverts sont ignorés ; quittez-en un d’abord pour le nettoyer."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blibsch überall aagmäldet. Offeni Browser werded übersprunge; beände en zerscht, zum ne ufzruume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप हर जगह साइन इन रहते हैं। खुले ब्राउज़र छोड़ दिए जाते हैं; साफ़ करने के लिए पहले उसे बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava ostaje posvuda. Otvoreni preglednici se preskaču; prvo zatvori preglednik da ga očistiš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resti connesso ovunque. I browser aperti vengono saltati; chiudine uno prima per pulirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこでもサインインしたままです。開いているブラウザはスキップされます。クリーンアップするには、先に終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 곳에서 로그인 상태가 유지됩니다. 열려 있는 브라우저는 건너뜁니다. 정리하려면 먼저 종료하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieteikšanās visur saglabājas. Atvērtie pārlūki tiek izlaisti; lai pārlūku notīrītu, vispirms aizver to."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logowania wszędzie zostają. Otwarte przeglądarki są pomijane; aby ją wyczyścić, najpierw ją zakończ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a sessão iniciada em todo o lado. Os navegadores abertos são ignorados; saia de um primeiro para o limpar."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbetesh i identifikuar kudo. Shfletuesit e hapur anashkalohen; mbyll një së pari për ta pastruar."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остајете пријављени свуда. Отворени прегледачи се прескачу; прво затворите један да бисте га очистили."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostajete prijavljeni svuda. Otvoreni pregledači se preskaču; prvo zatvorite jedan da biste ga očistili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du förblir inloggad överallt. Öppna webbläsare hoppas över; avsluta en först för att rensa den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yerde oturumunuz açık kalır. Açık tarayıcılar atlanır; temizlemek için önce birinden çıkın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在所有地方都保持登录。已打开的浏览器会被跳过；请先退出浏览器再清理它。"
          }
        }
      }
    },
    "You still have another app from these makers, and it might use these files. Choose them only if you're sure." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال لديك تطبيق آخر من هذه الجهات المطوِّرة، وقد يستخدم هذه الملفات. اخترها فقط إذا كنت متأكدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara tens una altra app d’aquests fabricants, i potser fa servir aquests arxius. Tria’ls només si n’estàs segur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch eine andere App dieser Hersteller, und sie nutzt diese Dateien möglicherweise. Wähle sie nur aus, wenn du sicher bist."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You still have another app from these makers, and it might use these files. Choose them only if you're sure."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You still have another app from these makers, and it might use these files. Choose them only if you're sure."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You still have another app from these makers, and it might use these files. Choose them only if you're sure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún tienes otra app de estos desarrolladores y podría usar estos archivos. Elígelos solo si estás seguro."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún tienes otra app de estos desarrolladores y podría usar estos archivos. Elígelos solo si estás seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez encore une autre app de ces développeurs, et elle pourrait utiliser ces fichiers. Ne les choisissez qu’en toute certitude."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du häsch na e anderi App vo dene Hersteller, und si bruucht die Dateie vilicht. Wähl si nume uus, wenn du sicher bisch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन निर्माताओं का एक और ऐप आपके पास है, और वह इन फ़ाइलों का उपयोग कर सकता है। इन्हें तभी चुनें जब आप निश्चित हों।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još imaš drugu aplikaciju ovih proizvođača i ona bi mogla koristiti ove datoteke. Odaberi ih samo ako to sigurno znaš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai ancora un'altra app di questi produttori, e potrebbe usare questi file. Selezionali solo se sei sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのメーカーのアプリがまだほかにあり、これらのファイルを使っている可能性があります。確実な場合のみ選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 제작사의 다른 앱을 아직 가지고 있으며, 그 앱이 이 파일을 사용할 수 있습니다. 확실할 때만 선택하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev vēl ir cita lietotne no šiem izstrādātājiem, un tā var izmantot šos failus. Izvēlies tos tikai tad, ja esi pārliecināts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal masz inną aplikację od tych producentów i może ona używać tych plików. Wybieraj je tylko wtedy, gdy masz pewność."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda tem outra app destes criadores, que pode usar estes ficheiros. Escolha-os apenas se tiver a certeza."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke ende një aplikacion tjetër nga këta prodhues dhe mund t'i përdorë këta skedarë. Zgjidhi vetëm nëse je i sigurt."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Још имате другу апликацију ових произвођача и она можда користи ове фајлове. Бирајте их само ако сте сигурни."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još imate drugu aplikaciju ovih proizvođača i ona možda koristi ove fajlove. Birajte ih samo ako ste sigurni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har fortfarande en annan app från dessa tillverkare, och den kan använda dessa filer. Välj dem bara om du är säker."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yapımcıların başka bir uygulaması hâlâ sizde ve bu dosyaları kullanıyor olabilir. Yalnızca eminseniz seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你仍有这些开发者的另一款 App，它可能会使用这些文件。只有在确定时才选择它们。"
          }
        }
      }
    },
    "Your %@ couldn't list its apps (error %d). Unlock it and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على الـ %1$@ عرض تطبيقاته (الخطأ %2$d). افتح قفله وحاول مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’%1$@ no ha pogut llistar les apps (error %2$d). Desbloqueja’l i torna-ho a provar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %1$@ konnte seine Apps nicht listen (Fehler %2$d). Entsperre es und versuche es erneut."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %1$@ couldn't list its apps (error %2$d). Unlock it and try again."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %1$@ couldn't list its apps (error %2$d). Unlock it and try again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %1$@ couldn't list its apps (error %2$d). Unlock it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %1$@ no ha podido enumerar sus apps (error %2$d). Desbloquéalo y vuelve a intentarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %1$@ no pudo enumerar sus apps (error %2$d). Desbloquéalo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre %1$@ n’a pas pu lister ses apps (erreur %2$d). Déverrouillez-le et réessayez."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %1$@ het sini Apps nöd chöne uflischte (Fehler %2$d). Entsperr en und versuech es nomal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका %1$@ अपने ऐप नहीं बता सका (त्रुटि %2$d)। उसे अनलॉक करके फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj %1$@ nije mogao navesti svoje aplikacije (pogreška %2$d). Otključaj ga i pokušaj ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'%1$@ non è riuscito a elencare le app (errore %2$d). Sbloccalo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がアプリを一覧できませんでした(エラー%2$d)。ロックを解除して、もう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 앱 목록을 가져오지 못했습니다(오류 %2$d). 잠금을 해제하고 다시 시도하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavs %1$@ nevarēja uzskaitīt savas lietotnes (kļūda %2$d). Atbloķē to un mēģini vēlreiz."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje urządzenie %1$@ nie mogło wyświetlić listy aplikacji (błąd %2$d). Odblokuj je i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu %1$@ não conseguiu listar as apps (erro %2$d). Desbloqueie-o e tente novamente."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ yt nuk i listoi aplikacionet (gabim %2$d). Çele dhe provo përsëri."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш %1$@ није могао да наведе своје апликације (грешка %2$d). Откључајте га и покушајте поново."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš %1$@ nije mogao da navede svoje aplikacije (greška %2$d). Otključajte ga i pokušajte ponovo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %1$@ kunde inte lista sina appar (fel %2$d). Lås upp den och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cihazınız uygulamalarını listeleyemedi (hata %2$d). Kilidini açıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 无法列出其 App（错误 %2$d）。请解锁后重试。"
          }
        }
      }
    },
    "Your %@ didn't answer. Unlock it, check the cable and press Read again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب الـ %@. افتح قفله، وتحقق من الكابل، واضغط «قراءة» مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’%@ no ha respost. Desbloqueja’l, comprova el cable i torna a fer clic a Llegeix."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@ hat nicht geantwortet. Entsperre es, prüfe das Kabel und drücke erneut auf „Lesen“."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ didn't answer. Unlock it, check the cable and press Read again."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ didn't answer. Unlock it, check the cable and press Read again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ didn't answer. Unlock it, check the cable and press Read again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %@ no ha respondido. Desbloquéalo, revisa el cable y vuelve a pulsar Leer."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %@ no respondió. Desbloquéalo, revisa el cable y vuelve a presionar Leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre %@ n’a pas répondu. Déverrouillez-le, vérifiez le câble et cliquez de nouveau sur Lire."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %@ het nöd gantwortet. Entsperr en, prüef s Kabel und drück nomal uf «Läse»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके %@ ने जवाब नहीं दिया। उसे अनलॉक करें, केबल जाँचें और फिर “पढ़ें” दबाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj %@ nije odgovorio. Otključaj ga, provjeri kabel i ponovno pritisni Čitaj."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'%@ non ha risposto. Sbloccalo, controlla il cavo e premi di nuovo Leggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が応答しませんでした。ロックを解除し、ケーブルを確認して、もう一度「読み取り」を押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 응답하지 않았습니다. 잠금을 해제하고 케이블을 확인한 다음 ‘읽기’를 다시 누르세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavs %@ neatbildēja. Atbloķē to, pārbaudi kabeli un vēlreiz nospied Lasīt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje urządzenie %@ nie odpowiedziało. Odblokuj je, sprawdź kabel i ponownie naciśnij Odczytaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu %@ não respondeu. Desbloqueie-o, verifique o cabo e prima Ler novamente."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yt nuk u përgjigj. Çele, kontrollo kabllon dhe shtyp Lexo përsëri."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш %@ није одговорио. Откључајте га, проверите кабл и поново притисните Читај."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš %@ nije odgovorio. Otključajte ga, proverite kabl i ponovo pritisnite Čitaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %@ svarade inte. Lås upp den, kontrollera kabeln och tryck på Läs igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cihazınız yanıt vermedi. Kilidini açın, kabloyu kontrol edin ve yeniden Oku’ya basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。请解锁，检查数据线，然后再次点按“读取”。"
