    "Selected folders include everything inside them, including files not shown in a partial map." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشمل المجلدات المحدّدة كل ما بداخلها، بما في ذلك الملفات غير المعروضة في خريطة جزئية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les carpetes seleccionades inclouen tot el que contenen, també els arxius que no es mostren en un mapa parcial."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Ordner umfassen alles darin, auch Dateien, die in einer Teilkarte nicht angezeigt werden."
          }
        },
        "en-AU" : {
