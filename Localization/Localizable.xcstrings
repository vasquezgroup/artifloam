    "%@ will quit first. It may ask you to save. If an app doesn't quit, its cache is kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إنهاء %@ أولًا. قد يطلب منك الحفظ. إذا لم ينتهِ التطبيق، تبقى ذاكرته المؤقتة كما هي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es tancarà primer. Pot demanar-te que desis. Si una app no es tanca, se’n conserva la memòria cau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird zuerst beendet. Es kann nachfragen, ob du sichern möchtest. Wenn sich eine App nicht beenden lässt, bleibt ihr Cache erhalten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will quit first. It may ask you to save. If an app doesn't quit, its cache is kept."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will quit first. It may ask you to save. If an app doesn't quit, its cache is kept."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will quit first. It may ask you to save. If an app doesn't quit, its cache is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se cerrará antes. Puede pedirte que guardes. Si una app no se cierra, se conserva su caché."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se cerrará antes. Puede pedirte que guardes. Si una app no se cierra, se conserva su caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quittera d’abord. L’app peut vous demander d’enregistrer. Si une app ne quitte pas, son cache est conservé."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird zerscht beändet. Es fraagt di evtl., ob du speichere wotsch. Wenn e App nöd beändet, blibt ihre Cache erhalte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पहले बंद होगा। यह आपसे सहेजने को कह सकता है। अगर कोई ऐप बंद नहीं होता, तो उसका कैश रखा जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ će se prvo zatvoriti. Možda će tražiti spremanje. Ako se aplikacija ne zatvori, njezina predmemorija ostaje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verrà chiusa prima. Potrebbe chiederti di salvare. Se un'app non si chiude, la sua cache viene conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が先に終了します。保存を求められる場合があります。アプリが終了しない場合、そのキャッシュは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 먼저 종료됩니다. 저장하라는 메시지가 표시될 수 있습니다. 앱이 종료되지 않으면 해당 캐시는 유지됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vispirms tiks aizvērta. Tā var palūgt saglabāt darbu. Ja lietotne neaizveras, tās kešatmiņa tiek paturēta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ zostanie najpierw zakończona. Może zapytać o zapisanie zmian. Jeśli aplikacja się nie zakończy, jej pamięć podręczna zostanie zachowana."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será encerrado primeiro. Pode pedir-lhe para guardar. Se uma app não encerrar, a sua cache é mantida."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ do të mbyllet së pari. Mund të të kërkojë të ruash. Nëse një aplikacion nuk mbyllet, cache-ja e tij mbahet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ће се прво затворити. Може тражити да сачувате. Ако се апликација не затвори, њен кеш се задржава."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ će se prvo zatvoriti. Može tražiti da sačuvate. Ako se aplikacija ne zatvori, njen keš se zadržava."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avslutas först. Den kan be dig spara. Om en app inte avslutas behålls dess cache."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce çıkılacak uygulama: %@. Kaydetmenizi isteyebilir. Bir uygulamadan çıkılamazsa önbelleği korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将先退出。它可能会要求你存储。如果某个 App 未能退出，其缓存会保留。"
          }
        }
      }
    },
