    "Possibly shared files stay unticked" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملفات التي قد تكون مشتركة تبقى غير محدّدة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els arxius possiblement compartits queden sense marcar"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise geteilte Dateien bleiben nicht angehakt"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possibly shared files stay unticked"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possibly shared files stay unticked"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possibly shared files stay unticked"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos posiblemente compartidos se quedan sin marcar"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos posiblemente compartidos se quedan sin marcar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers éventuellement partagés restent non cochés"
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateie, wo vilicht gteilt werded, blibed nöd aagchrüüzlet"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संभवतः साझा फ़ाइलें बिना चुनी रहती हैं"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke koje se možda dijele ostaju neoznačene"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file potenzialmente condivisi restano non selezionati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有されている可能性のあるファイルは、選択されません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유되었을 수 있는 파일은 선택되지 않은 채로 남습니다"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iespējams koplietotie faili paliek neatzīmēti"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki, które mogą być współdzielone, pozostają niezaznaczone"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros possivelmente partilhados ficam por assinalar"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skedarët që mund të ndahen mbeten të pazgjedhur"
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фајлови који су можда дељени остају неозначени"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fajlovi koji su možda deljeni ostaju neoznačeni"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som kan vara delade förblir omarkerade"
          }
        },
        "tr" : {
