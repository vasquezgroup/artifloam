    "Running apps, Apple apps and Artifloam are protected. Removing an app does not cancel subscriptions. Some related files may stay behind." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيقات قيد التشغيل وتطبيقات Apple وArtifloam محمية. إزالة تطبيق لا تلغي الاشتراكات. قد تبقى بعض الملفات المرتبطة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps en execució, les d’Apple i Artifloam estan protegides. Eliminar una app no cancel·la les subscripcions. Alguns arxius relacionats poden quedar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende Apps, Apple-Apps und Artifloam sind geschützt. Das Entfernen einer App kündigt keine Abos. Einige zugehörige Dateien bleiben möglicherweise zurück."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running apps, Apple apps and Artifloam are protected. Removing an app does not cancel subscriptions. Some related files may stay behind."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running apps, Apple apps and Artifloam are protected. Removing an app does not cancel subscriptions. Some related files may stay behind."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running apps, Apple apps and Artifloam are protected. Removing an app does not cancel subscriptions. Some related files may stay behind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps en ejecución, las de Apple y Artifloam están protegidas. Eliminar una app no cancela las suscripciones. Es posible que algunos archivos relacionados se queden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps en ejecución, las de Apple y Artifloam están protegidas. Eliminar una app no cancela las suscripciones. Es posible que algunos archivos relacionados se queden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps en cours d’exécution, les apps d’Apple et Artifloam sont protégées. Retirer une app n’annule pas les abonnements. Certains fichiers associés peuvent rester."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufendi Apps, Apple-Apps und Artifloam sind gschützt. S Entferne vonere App kündigt kei Abos. Es chönd zuegehörigi Dateie zrugg blibe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चल रहे ऐप, Apple के ऐप और Artifloam संरक्षित हैं। ऐप हटाने से सब्सक्रिप्शन रद्द नहीं होते। कुछ संबंधित फ़ाइलें पीछे रह सकती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrenute aplikacije, Appleove aplikacije i Artifloam su zaštićeni. Uklanjanje aplikacije ne otkazuje pretplate. Neke povezane datoteke mogu ostati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app in esecuzione, le app Apple e Artifloam sono protette. Rimuovere un'app non annulla gli abbonamenti. Alcuni file correlati potrebbero restare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のアプリ、Appleのアプリ、Artifloamは保護されます。アプリを削除しても、サブスクリプションは解約されません。関連ファイルの一部が残る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 앱, Apple 앱, Artifloam은 보호됩니다. 앱을 제거해도 구독은 취소되지 않습니다. 일부 관련 파일이 남을 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbojošās lietotnes, Apple lietotnes un Artifloam ir aizsargātas. Lietotnes noņemšana neatceļ abonementus. Daži saistītie faili var palikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchomione aplikacje, aplikacje Apple i Artifloam są chronione. Usunięcie aplikacji nie anuluje subskrypcji. Niektóre powiązane pliki mogą pozostać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps em execução, as apps da Apple e o Artifloam estão protegidas. Remover uma app não cancela subscrições. Alguns ficheiros relacionados podem ficar para trás."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacionet në punë, aplikacionet e Apple dhe Artifloam janë të mbrojtura. Heqja e një aplikacioni nuk anulon abonimet. Disa skedarë të lidhur mund të mbeten."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покренуте апликације, Apple апликације и Artifloam су заштићени. Уклањање апликације не отказује претплате. Неки повезани фајлови могу остати."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrenute aplikacije, Apple aplikacije i Artifloam su zaštićeni. Uklanjanje aplikacije ne otkazuje pretplate. Neki povezani fajlovi mogu ostati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appar som körs, Apples appar och Artifloam är skyddade. Att ta bort en app avbryter inte prenumerationer. Vissa relaterade filer kan bli kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışan uygulamalar, Apple uygulamaları ve Artifloam korunur. Bir uygulamayı kaldırmak abonelikleri iptal etmez. İlgili bazı dosyalar geride kalabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的 App、Apple 的 App 和 Artifloam 受保护。移除 App 不会取消订阅。一些相关文件可能会留下。"
          }
        }
      }
    },
