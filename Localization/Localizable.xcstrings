    "Fewer login items means more free memory every time your Mac starts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد أقل من عناصر تسجيل الدخول يعني ذاكرة حرة أكثر في كل مرة يبدأ فيها الـ Mac."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menys ítems d’inici de sessió vol dir més memòria lliure cada vegada que s’inicia el Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
