        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’instant, votre %1$@ utilise %2$@ de moins. iOS peut mettre du temps à en libérer davantage."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis jetzt bruucht din %1$@ %2$@ weniger. iOS cha e Wiili bruuche, zum meh freizgää."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब तक आपका %1$@ %2$@ कम इस्तेमाल करता है। iOS को और जगह छोड़ने में थोड़ा समय लग सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do sada tvoj %1$@ koristi %2$@ manje. iOS može trebati neko vrijeme da oslobodi više."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finora il tuo %1$@ usa %2$@ in meno. iOS può impiegare un po' a liberarne altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまでに%1$@の使用量は%2$@減りました。iOSがさらに解放するまで、しばらくかかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지 %1$@ 사용량이 %2$@ 줄었습니다. iOS가 더 확보하려면 시간이 걸릴 수 있습니다."
