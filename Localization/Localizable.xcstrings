    "Backups contain personal data. Review in Finder; no automatic deletion." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي النسخ الاحتياطية على بيانات شخصية. راجعها في فايندر؛ لا حذف تلقائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les còpies de seguretat contenen dades personals. Revisa-les al Finder; no hi ha cap supressió automàtica."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups enthalten persönliche Daten. Im Finder durchsehen; keine automatische Löschung."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
