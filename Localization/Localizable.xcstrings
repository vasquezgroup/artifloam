        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo iOS prijavljuje za ove aplikacije. Stvarna količina može biti manja. Poslije ćeš vidjeti što se zapravo promijenilo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è ciò che iOS segnala per queste app. L'entità reale può essere inferiore. Dopo vedrai cosa è cambiato davvero."
          }
