    "Build data and simulators. Some can't be rebuilt, so you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات البناء والمحاكيات. لا يمكن إعادة بناء بعضها، لذا أنت من يختار."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dades de compilació i simuladors. Alguns no es poden tornar a crear, així que tries tu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build-Daten und Simulatoren. Manche lassen sich nicht neu erzeugen, deshalb wählst du aus."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build data and simulators. Some can't be rebuilt, so you choose."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build data and simulators. Some can't be rebuilt, so you choose."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build data and simulators. Some can't be rebuilt, so you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos de compilación y simuladores. Algunos no se pueden reconstruir, así que eliges tú."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos de compilación y simuladores. Algunos no se pueden reconstruir, así que eliges tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données de build et simulateurs. Certains ne peuvent pas être reconstruits : c’est donc vous qui choisissez."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build-Date und Simulatore. Es paar chönd nöd neu erstellt werde, drum wählsch du sälber uus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्ड डेटा और सिम्युलेटर। कुछ दोबारा नहीं बन सकते, इसलिए आप चुनते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci izgradnje i simulatori. Neki se ne mogu ponovno izgraditi, pa ti biraš."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati di build e simulatori. Alcuni non possono essere ricostruiti, quindi scegli tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビルドデータとシミュレータ。再作成できないものもあるため、ご自身で選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빌드 데이터와 시뮬레이터. 일부는 다시 만들 수 없으므로 직접 선택합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Būvēšanas dati un simulatori. Dažus nevar izveidot no jauna, tāpēc izvēlies pats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane kompilacji i symulatory. Niektórych nie da się odbudować, więc wybierasz sam."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de compilação e simuladores. Alguns não podem ser recriados, por isso escolhe."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Të dhëna ndërtimi dhe simulatorë. Disa nuk mund të rindërtohen, prandaj ti zgjedh."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подаци о изградњи и симулатори. Неки не могу поново да се изграде, па ви бирате."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci o izgradnji i simulatori. Neki ne mogu ponovo da se izgrade, pa vi birate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byggdata och simulatorer. En del kan inte byggas om, så du väljer."
          }
        },
