    "They're removed from the device's library. Export them first if you want to keep a copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال من مكتبة الجهاز. صدّرها أولًا إذا أردت الاحتفاظ بنسخة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’eliminen de la fototeca del dispositiu. Exporta-les primer si en vols conservar una còpia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden aus der Mediathek des Geräts entfernt. Exportiere sie zuerst, wenn du eine Kopie behalten möchtest."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They're removed from the device's library. Export them first if you want to keep a copy."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They're removed from the device's library. Export them first if you want to keep a copy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They're removed from the device's library. Export them first if you want to keep a copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan de la fototeca del dispositivo. Expórtalos primero si quieres conservar una copia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan de la fototeca del dispositivo. Expórtalos primero si quieres conservar una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils sont retirés de la photothèque de l’appareil. Exportez-les d’abord si vous voulez en garder une copie."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si wärded us de Mediathek vom Grät entfernt. Exportier si zerscht, wänn du e Kopie wotsch bhalte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें डिवाइस की लाइब्रेरी से हटा दिया जाता है। प्रति रखना चाहते हैं तो पहले इन्हें एक्सपोर्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjaju se iz medijateke uređaja. Najprije ih izvezi ako želiš zadržati kopiju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono rimossi dalla libreria del dispositivo. Esportali prima se vuoi tenerne una copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスのライブラリから削除されます。コピーを残したい場合は先に書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 보관함에서 제거됩니다. 사본을 보관하려면 먼저 내보내세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tie tiek noņemti no ierīces bibliotēkas. Ja vēlies saglabāt kopiju, vispirms tos eksportē."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaną usunięte z biblioteki urządzenia. Jeśli chcesz zachować kopię, najpierw je wyeksportuj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São removidos da fototeca do dispositivo. Exporte-os primeiro se quiser guardar uma cópia."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiqen nga biblioteka e pajisjes. Eksportoji së pari nëse do të mbash një kopje."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уклањају се из медијатеке уређаја. Прво их извезите ако желите да задржите копију."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjaju se iz medijateke uređaja. Prvo ih izvezite ako želite da zadržite kopiju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tas bort från enhetens bibliotek. Exportera dem först om du vill behålla en kopia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazın arşivinden kaldırılırlar. Bir kopya saklamak istiyorsanız önce dışa aktarın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们会从设备的图库中移除。如果想保留副本，请先导出。"
          }
        }
      }
    },
