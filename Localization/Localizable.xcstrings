    },
    "Find old caches and build leftovers, without touching the work you want to keep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعثر على ذاكرات مؤقتة قديمة ومخلّفات البناء، دون المساس بالعمل الذي تريد إبقاءه."
          }
