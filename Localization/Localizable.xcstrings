          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode n’a pas pu fournir un inventaire complet des runtimes de simulateur. Examinez les runtimes installés dans Réglages de Xcode > Composants."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode hät kes vollständigs Inventar vo de Simulator-Runtimes chöne lifere. Prüef d installierte Runtimes i Xcode Settings > Components."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode सिम्युलेटर-रनटाइम की पूरी सूची नहीं दे सका। इंस्टॉल किए गए रनटाइम Xcode सेटिंग > कंपोनेंट में देखें।"
