    "Xcode could not provide a complete simulator-runtime inventory. Review installed runtimes in Xcode Settings > Components." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Xcode تقديم جرد كامل لأوقات تشغيل المحاكي. راجع أوقات التشغيل المثبّتة في Xcode Settings > Components."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode no ha pogut proporcionar un inventari complet dels runtimes de simulador. Revisa els runtimes instal·lats a Configuració de Xcode > Components."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode konnte kein vollständiges Verzeichnis der Simulator-Laufzeiten liefern. Sieh die installierten Laufzeiten in Xcode Settings > Components durch."
          }
        },
        "en-AU" : {
          "stringUnit" : {
