        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Апликације могу да успоре. Затворите апликацију коју не користите; прво сачувајте рад."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
