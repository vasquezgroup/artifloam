          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少なくとも30日間使われていない、再生成可能なコンパイラモジュールキャッシュ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 30일 동안 사용하지 않은, 다시 만들 수 있는 컴파일러 모듈 캐시."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
