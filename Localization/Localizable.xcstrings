        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema dodatnih poznatih projekata. Standardni keševi i logovi se i dalje proveravaju automatski; dodajte fasciklu samo ako nedostaje."
