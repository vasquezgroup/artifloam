    "Files inside differ from what the developer signed. Often a plugin or an update; reinstall if you didn't expect it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختلف الملفات بداخله عمّا وقّعه المطوّر. غالبًا بسبب مكوّن إضافي أو تحديث؛ أعد التثبيت إذا لم تكن تتوقع ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els arxius de dins difereixen del que va signar el desenvolupador. Sovint és un connector o una actualització; reinstal·la-la si no t’ho esperaves."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthaltene Dateien weichen von dem ab, was der Entwickler signiert hat. Oft ein Plug-in oder ein Update; installiere die App neu, wenn du das nicht erwartet hast."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files inside differ from what the developer signed. Often a plugin or an update; reinstall if you didn't expect it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files inside differ from what the developer signed. Often a plugin or an update; reinstall if you didn't expect it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files inside differ from what the developer signed. Often a plugin or an update; reinstall if you didn't expect it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de dentro difieren de lo que firmó el desarrollador. Suele ser un plugin o una actualización; reinstala si no lo esperabas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de dentro difieren de lo que firmó el desarrollador. Suele ser un plugin o una actualización; reinstala si no lo esperabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers à l’intérieur diffèrent de ce que le développeur a signé. Souvent dû à un plugin ou à une mise à jour ; réinstallez si vous ne vous y attendiez pas."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateie drin wiiche vo dem ab, was de Entwickler signiert hät. Oft isch es es Plugin oder es Update; installier nomal neu, wenn du das nöd erwartet häsch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंदर की फ़ाइलें उससे अलग हैं जिन पर डेवलपर ने हस्ताक्षर किए थे। अक्सर प्लगइन या अपडेट के कारण; अगर आपको इसकी उम्मीद नहीं थी, तो दोबारा इंस्टॉल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke unutra razlikuju se od onoga što je developer potpisao. Često je to dodatak ili ažuriranje; ponovno instaliraj ako to nisi očekivao."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file all'interno differiscono da quelli firmati dallo sviluppatore. Spesso è un plugin o un aggiornamento; reinstalla se non te lo aspettavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中のファイルが、開発元が署名した内容と異なります。プラグインやアップデートが原因のことが多いです。心当たりがなければ再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안의 파일이 개발자가 서명한 것과 다릅니다. 플러그인이나 업데이트 때문인 경우가 많습니다. 예상하지 못했다면 다시 설치하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faili iekšā atšķiras no tā, ko parakstīja izstrādātājs. Bieži tas ir spraudnis vai atjauninājums; ja negaidīji, uzstādi vēlreiz."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki w środku różnią się od tego, co podpisał deweloper. Często to wtyczka lub uaktualnienie; zainstaluj ponownie, jeśli nie jest to oczekiwane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros no interior diferem do que o criador assinou. Muitas vezes é um plugin ou uma atualização; reinstale se não estava à espera."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skedarët brenda ndryshojnë nga ato që nënshkroi zhvilluesi. Shpesh është një shtojcë ose një përditësim; riinstalo nëse nuk e prisje."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фајлови унутра се разликују од онога што је програмер потписао. Често је то додатак или ажурирање; инсталирајте поново ако то нисте очекивали."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fajlovi unutra se razlikuju od onoga što je programer potpisao. Često je to dodatak ili ažuriranje; instalirajte ponovo ako to niste očekivali."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer inuti skiljer sig från det utvecklaren signerade. Ofta ett tillägg eller en uppdatering; installera om om du inte väntade dig det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçindeki dosyalar geliştiricinin imzaladıklarından farklı. Çoğunlukla bir eklenti veya güncellemedir; beklemediyseniz yeniden kurun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部的文件与开发者签名时的不同。通常是插件或更新所致；如果这不在你预期之内，请重新安装。"
          }
        }
      }
    },
    "Files were used too recently" : {
      "localizations" : {
