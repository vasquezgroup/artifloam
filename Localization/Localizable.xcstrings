        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затражено је од апликације %@ да се затвори. Сачувајте измене ако то затражи."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatraženo je od aplikacije %@ da se zatvori. Sačuvajte izmene ako to zatraži."
