    "%@. iOS downloads these again when the simulator needs them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ينزّل iOS هذه الملفات مجددًا عندما يحتاج المحاكي إليها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS les torna a baixar quan el simulador les necessita."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS lädt sie erneut herunter, wenn der Simulator sie braucht."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS downloads these again when the simulator needs them."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS downloads these again when the simulator needs them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS downloads these again when the simulator needs them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS los vuelve a descargar cuando el simulador los necesita."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS los vuelve a descargar cuando el simulador los necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS les télécharge de nouveau quand le simulateur en a besoin."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS ladt die wieder abe, wenn de Simulator si bruucht."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। सिम्युलेटर को जब इनकी ज़रूरत होती है, तब iOS इन्हें दोबारा डाउनलोड करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS ih ponovno preuzima kad simulator to zatreba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS li scarica di nuovo quando il simulatore ne ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。シミュレータが必要とするとき、iOSが再度ダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 시뮬레이터에 필요하면 iOS가 다시 다운로드합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS tos lejupielādē atkārtoti, kad simulatoram tie ir vajadzīgi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. iOS pobiera je ponownie, gdy symulator ich potrzebuje."
          }
        },
        "pt" : {
