          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events did not answer. Allow Artifloam to control System Events in System Settings → Privacy & Security → Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events no ha respondido. Permite que Artifloam controle System Events en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events no ha respondido. Permite que Artifloam controle System Events en Configuración del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events n’a pas répondu. Autorisez Artifloam à contrôler System Events dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events hät nöd antwortet. Erlaub Artifloam i de Systemeinstellungen → Datenschutz & Sicherheit → Automation, System Events z steuere."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events ने जवाब नहीं दिया। सिस्टम सेटिंग → गोपनीयता और सुरक्षा → ऑटोमेशन में Artifloam को System Events नियंत्रित करने की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events nije odgovorio. Dopusti Artifloamu upravljanje System Eventsom u Postavkama sustava → Privatnost i sigurnost → Automatizacija."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events non ha risposto. Consenti ad Artifloam di controllare System Events in Impostazioni di Sistema → Privacy e sicurezza → Automazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Eventsが応答しませんでした。システム設定 → プライバシーとセキュリティ → オートメーションで、ArtifloamにSystem Eventsの操作を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events가 응답하지 않았습니다. 시스템 설정 → 개인정보 보호 및 보안 → 자동화에서 Artifloam이 System Events를 제어하도록 허용하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events neatbildēja. Atļauj Artifloam vadīt System Events sadaļā Sistēmas iestatījumi → Privātums un drošība → Automatizācija."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events nie odpowiedział. Zezwól Artifloam na sterowanie System Events w Ustawieniach systemowych → Prywatność i ochrona → Automatyzacja."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O System Events não respondeu. Permita ao Artifloam controlar o System Events em Definições → Privacidade e segurança → Automatização."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events nuk u përgjigj. Lejo Artifloam të kontrollojë System Events te Cilësimet e sistemit → Privatësia dhe siguria → Automatizimi."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events није одговорио. Дозволите да Artifloam контролише System Events у Системска подешавања → Приватност и безбедност → Аутоматизација."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events nije odgovorio. Dozvolite da Artifloam kontroliše System Events u Sistemska podešavanja → Privatnost i bezbednost → Automatizacija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events svarade inte. Tillåt Artifloam att styra System Events i Systeminställningar → Integritet och säkerhet → Automatisering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Events yanıt vermedi. Sistem Ayarları → Gizlilik ve Güvenlik → Otomasyon bölümünde Artifloam’ın System Events’i denetlemesine izin verin."
          }
        },
        "zh-Hans" : {
