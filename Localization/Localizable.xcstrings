    "Open-file inspection was incomplete. Automatic cleanup will remain blocked until it can be verified." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان فحص الملفات المفتوحة غير مكتمل. سيظل التنظيف التلقائي محظورًا إلى أن يمكن التحقق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inspecció dels arxius oberts no s’ha completat. La neteja automàtica seguirà bloquejada fins que es pugui verificar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prüfung geöffneter Dateien war unvollständig. Die automatische Bereinigung bleibt gesperrt, bis sie überprüft werden kann."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-file inspection was incomplete. Automatic cleanup will remain blocked until it can be verified."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-file inspection was incomplete. Automatic cleanup will remain blocked until it can be verified."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-file inspection was incomplete. Automatic cleanup will remain blocked until it can be verified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inspección de archivos abiertos no se completó. La limpieza automática seguirá bloqueada hasta que se pueda verificar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inspección de archivos abiertos no se completó. La limpieza automática seguirá bloqueada hasta que se pueda verificar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’inspection des fichiers ouverts était incomplète. Le nettoyage automatique restera bloqué tant qu’elle ne pourra pas être vérifiée."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D Inspektion vo offene Dateie isch unvollständig gsi. S automatische Ufruume blibt blockiert, bis es cha bestätigt werde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुली फ़ाइलों का निरीक्षण अधूरा रहा। जब तक यह सत्यापित नहीं हो जाता, स्वचालित सफ़ाई रुकी रहेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjera otvorenih datoteka nije bila potpuna. Automatsko čišćenje ostat će blokirano dok se ne može provjeriti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ispezione dei file aperti era incompleta. La pulizia automatica resterà bloccata finché non potrà essere verificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いているファイルの調査が不完全でした。確認できるまで、自動クリーンアップはブロックされたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열린 파일 검사가 완전하지 않았습니다. 확인할 수 있을 때까지 자동 정리는 계속 차단됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atvērto failu pārbaude bija nepilnīga. Automātiskā tīrīšana paliks bloķēta, līdz to varēs pārbaudīt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzanie otwartych plików nie zostało ukończone. Automatyczne czyszczenie pozostanie zablokowane, dopóki nie będzie można tego zweryfikować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A inspeção de ficheiros abertos ficou incompleta. A limpeza automática continuará bloqueada até poder ser verificada."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspektimi i skedarëve të hapur ishte i paplotë. Pastrimi automatik do të mbetet i bllokuar derisa të verifikohet."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провера отворених фајлова била је непотпуна. Аутоматско чишћење остаје блокирано док се не може потврдити."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provera otvorenih fajlova bila je nepotpuna. Automatsko čišćenje ostaje blokirano dok se ne može potvrditi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undersökningen av öppna filer var ofullständig. Automatisk rensning förblir blockerad tills det kan verifieras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık dosya incelemesi eksik kaldı. Doğrulanana dek otomatik temizlik engelli kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对已打开文件的检查未能完成。在能够验证之前，自动清理会保持阻止状态。"
          }
        }
      }
    },
