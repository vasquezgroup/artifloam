    "Uncommitted edits or commits that are not merged. Always kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديلات غير محفوظة في commit أو commits غير مدموجة. تُبقى دائمًا."
          }
        },
        "ca" : {
