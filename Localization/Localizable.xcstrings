    "Closes Artifloam completely, including this menu bar icon. Automatic cleanup you turned on still runs on its schedule." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُغلق Artifloam بالكامل، بما في ذلك أيقونة شريط القوائم هذه. يستمر التنظيف التلقائي الذي فعّلته في العمل وفق جدوله."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanca Artifloam del tot, també aquesta icona de la barra de menús. La neteja automàtica que hagis activat continua executant-se segons la programació."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt Artifloam vollständig, auch dieses Symbol in der Menüleiste. Die automatische Bereinigung, die du aktiviert hast, läuft weiterhin nach Zeitplan."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes Artifloam completely, including this menu bar icon. Automatic cleanup you turned on still runs on its schedule."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes Artifloam completely, including this menu bar icon. Automatic cleanup you turned on still runs on its schedule."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes Artifloam completely, including this menu bar icon. Automatic cleanup you turned on still runs on its schedule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra Artifloam por completo, incluido este icono de la barra de menús. La limpieza automática que hayas activado se sigue ejecutando según su programación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra Artifloam por completo, incluido este icono de la barra de menús. La limpieza automática que hayas activado se sigue ejecutando según su programación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferme complètement Artifloam, y compris cette icône de la barre des menus. Le nettoyage automatique que vous avez activé s’exécute toujours selon son calendrier."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schliesst Artifloam komplett, au das Symbol i de Menüleiste. Es automatischs Ufruume, wo du iigschaltet häsch, lauft witerhin nach sim Plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam को पूरी तरह बंद करता है, इस मेनू बार आइकन सहित। आपने जो स्वचालित सफ़ाई चालू की है, वह अपने शेड्यूल पर चलती रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuno zatvara Artifloam, uključujući ikonu u traci izbornika. Automatsko čišćenje koje si uključio i dalje radi prema rasporedu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiude Artifloam completamente, compresa questa icona nella barra dei menu. La pulizia automatica che hai attivato continua a funzionare secondo la sua pianificazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーのアイコンを含め、Artifloamを完全に終了します。オンにした自動クリーンアップは、スケジュールどおりに実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 아이콘을 포함해 Artifloam을 완전히 종료합니다. 켜 둔 자동 정리는 예정대로 계속 실행됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilnībā aizver Artifloam, ieskaitot šo izvēlņu joslas ikonu. Ieslēgtā automātiskā tīrīšana joprojām darbojas pēc sava grafika."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamyka Artifloam całkowicie, łącznie z tą ikoną na pasku menu. Włączone przez Ciebie automatyczne czyszczenie nadal działa według harmonogramu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha o Artifloam por completo, incluindo este ícone da barra de menus. A limpeza automática que ativou continua a ser executada de acordo com a programação."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E mbyll Artifloam plotësisht, përfshirë ikonën në shiritin e menysë. Pastrimi automatik që ke aktivizuar vazhdon të funksionojë sipas planifikimit."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потпуно затвара Artifloam, укључујући ову икону у траци менија. Аутоматско чишћење које сте укључили и даље ради по свом распореду."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuno zatvara Artifloam, uključujući ovu ikonu u traci menija. Automatsko čišćenje koje ste uključili i dalje radi po svom rasporedu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger Artifloam helt, inklusive den här ikonen i menyraden. Automatisk rensning som du har slagit på körs ändå enligt sitt schema."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam’ı, bu menü çubuğu simgesi dahil, tamamen kapatır. Açtığınız otomatik temizlik zamanlamasına göre çalışmaya devam eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全关闭 Artifloam，包括此菜单栏图标。你已开启的自动清理仍会按计划运行。"
          }
        }
      }
    },
