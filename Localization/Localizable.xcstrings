    "Finder could not empty the Trash: %@. Allow Artifloam to control Finder in System Settings → Privacy & Security → Automation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على فايندر إفراغ سلة المهملات: %@. اسمح لـ Artifloam بالتحكم في فايندر من إعدادات النظام ← الخصوصية والأمن ← التحكم التلقائي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Finder no ha pogut buidar la paperera: %@. Permet que Artifloam controli el Finder a Configuració del Sistema → Privacitat i seguretat → Automatització."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Finder konnte den Papierkorb nicht leeren: %@. Erlaube Artifloam in Systemeinstellungen → Datenschutz & Sicherheit → Automation, den Finder zu steuern."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder could not empty the Bin: %@. Allow Artifloam to control Finder in System Settings → Privacy & Security → Automation."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder could not empty the Trash: %@. Allow Artifloam to control Finder in System Settings → Privacy & Security → Automation."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder could not empty the Bin: %@. Allow Artifloam to control Finder in System Settings → Privacy & Security → Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Finder no ha podido vaciar la Papelera: %@. Permite que Artifloam controle el Finder en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Finder no ha podido vaciar el Basurero: %@. Permite que Artifloam controle el Finder en Configuración del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Finder n’a pas pu vider la Corbeille : %@. Autorisez Artifloam à contrôler le Finder dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder hät de Papierkorb nöd chöne leere: %@. Erlaub Artifloam i de Systemeinstellungen → Datenschutz & Sicherheit → Automation, de Finder z steuere."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder रद्दी खाली नहीं कर सका: %@। सिस्टम सेटिंग → गोपनीयता और सुरक्षा → ऑटोमेशन में Artifloam को Finder नियंत्रित करने की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nije mogao isprazniti Smeće: %@. Dopusti Artifloamu upravljanje Finderom u Postavkama sustava → Privatnost i sigurnost → Automatizacija."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Finder non è riuscito a svuotare il Cestino: %@. Consenti ad Artifloam di controllare il Finder in Impostazioni di Sistema → Privacy e sicurezza → Automazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderがゴミ箱を空にできませんでした:%@。システム設定 → プライバシーとセキュリティ → オートメーションで、ArtifloamにFinderの操作を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder가 휴지통을 비울 수 없었습니다: %@. 시스템 설정 → 개인정보 보호 및 보안 → 자동화에서 Artifloam이 Finder를 제어하도록 허용하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nevarēja iztukšot Atkritni: %@. Atļauj Artifloam vadīt Finder sadaļā Sistēmas iestatījumi → Privātums un drošība → Automatizācija."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nie mógł opróżnić Kosza: %@. Zezwól Artifloam na sterowanie Finderem w Ustawieniach systemowych → Prywatność i ochrona → Automatyzacja."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Finder não conseguiu esvaziar o Lixo: %@. Permita ao Artifloam controlar o Finder em Definições → Privacidade e segurança → Automatização."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nuk mundi ta boshatiste Koshin: %@. Lejo Artifloam të kontrollojë Finder te Cilësimet e sistemit → Privatësia dhe siguria → Automatizimi."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder није могао да испразни Отпад: %@. Дозволите да Artifloam контролише Finder у Системска подешавања → Приватност и безбедност → Аутоматизација."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nije mogao da isprazni Otpad: %@. Dozvolite da Artifloam kontroliše Finder u Sistemska podešavanja → Privatnost i bezbednost → Automatizacija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder kunde inte tömma papperskorgen: %@. Tillåt Artifloam att styra Finder i Systeminställningar → Integritet och säkerhet → Automatisering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder Çöp Sepeti’ni boşaltamadı: %@. Sistem Ayarları → Gizlilik ve Güvenlik → Otomasyon bölümünde Artifloam’ın Finder’ı denetlemesine izin verin."
