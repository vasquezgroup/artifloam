    "Application binaries stay intact to preserve their signatures and compatibility." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الملفات التنفيذية للتطبيقات سليمة للحفاظ على توقيعاتها وتوافقها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els binaris de les apps es deixen intactes per preservar-ne les signatures i la compatibilitat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmdateien von Apps bleiben unverändert, damit ihre Signaturen und die Kompatibilität erhalten bleiben."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application binaries stay intact to preserve their signatures and compatibility."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application binaries stay intact to preserve their signatures and compatibility."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application binaries stay intact to preserve their signatures and compatibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los binarios de las aplicaciones se mantienen intactos para conservar sus firmas y su compatibilidad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los binarios de las aplicaciones se mantienen intactos para conservar sus firmas y su compatibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les binaires des apps restent intacts afin de préserver leurs signatures et leur compatibilité."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D Programmdateie vo de Apps blibed unverändert, damit Signature und Kompatibilität erhalte blibed."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप्लिकेशन बाइनरी जस की तस रखी जाती हैं, ताकि उनके सिग्नेचर और संगतता बनी रहे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binarne datoteke aplikacija ostaju netaknute radi očuvanja potpisa i kompatibilnosti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I binari delle applicazioni restano intatti per preservarne le firme e la compatibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションのバイナリは、署名と互換性を保つためそのまま残されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 실행 파일은 서명과 호환성을 유지하기 위해 그대로 남습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietotņu binārie faili paliek neskarti, lai saglabātu to parakstus un saderību."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki binarne aplikacji pozostają nienaruszone, aby zachować ich podpisy i zgodność."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os binários das apps ficam intactos para preservar as assinaturas e a compatibilidade."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skedarët binarë të aplikacioneve mbeten të paprekur për të ruajtur nënshkrimet dhe përputhshmërinë e tyre."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бинарни фајлови апликација остају нетакнути да би се сачували њихови потписи и компатибилност."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binarni fajlovi aplikacija ostaju netaknuti da bi se sačuvali njihovi potpisi i kompatibilnost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmens binärfiler lämnas orörda för att bevara deras signaturer och kompatibilitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama ikili dosyaları, imzalarını ve uyumluluklarını korumak için olduğu gibi kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 的二进制文件保持原样，以保留其签名和兼容性。"
          }
        }
      }
