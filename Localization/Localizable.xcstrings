    "Other devices on your network can try to reach your apps. Turning it on matters most on public Wi-Fi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحاول أجهزة أخرى على شبكتك الوصول إلى تطبيقاتك. تفعيله مهم أكثر على شبكات Wi-Fi العامة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altres dispositius de la xarxa poden intentar accedir a les teves apps. Activar-ho importa sobretot en una Wi‑Fi pública."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Geräte in deinem Netzwerk können versuchen, deine Apps zu erreichen. Das Aktivieren ist im öffentlichen WLAN am wichtigsten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other devices on your network can try to reach your apps. Turning it on matters most on public Wi-Fi."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other devices on your network can try to reach your apps. Turning it on matters most on public Wi-Fi."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other devices on your network can try to reach your apps. Turning it on matters most on public Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros dispositivos de tu red pueden intentar acceder a tus apps. Activarlo importa sobre todo en redes Wi-Fi públicas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros dispositivos de tu red pueden intentar acceder a tus apps. Activarlo importa sobre todo en redes Wi-Fi públicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres appareils de votre réseau peuvent tenter d’atteindre vos apps. L’activer compte surtout sur un Wi-Fi public."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anderi Gräte i dim Netzwerk chönd versueche, dini Apps z erreiche. S Iischalte isch am wichtigschte bim öffentliche WLAN."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके नेटवर्क के दूसरे डिवाइस आपके ऐप तक पहुँचने की कोशिश कर सकते हैं। इसे चालू करना सार्वजनिक वाई-फ़ाई पर सबसे ज़्यादा मायने रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugi uređaji na tvojoj mreži mogu pokušati doći do tvojih aplikacija. Uključivanje je najvažnije na javnoj Wi‑Fi mreži."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri dispositivi della tua rete possono provare a raggiungere le tue app. Attivarlo conta soprattutto sulle reti Wi‑Fi pubbliche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク上のほかのデバイスから、お使いのアプリに接続を試みられる場合があります。公共のWi‑Fiでは、オンにすることが特に重要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크의 다른 기기가 앱에 접근을 시도할 수 있습니다. 공용 Wi-Fi에서 켜는 것이 특히 중요합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citas ierīces tavā tīklā var mēģināt sasniegt tavas lietotnes. Ieslēgšana vissvarīgākā ir publiskā Wi-Fi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne urządzenia w Twojej sieci mogą próbować połączyć się z Twoimi aplikacjami. Włączenie jest najważniejsze w publicznej sieci Wi‑Fi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros dispositivos na sua rede podem tentar alcançar as suas apps. Ativar isto importa sobretudo em Wi‑Fi público."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pajisje të tjera në rrjetin tënd mund të provojnë t'i arrijnë aplikacionet e tua. Aktivizimi ka rëndësi më të madhe në Wi-Fi publike."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Други уређаји на вашој мрежи могу да покушају да допру до ваших апликација. Укључивање је најважније на јавном Wi-Fi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugi uređaji na vašoj mreži mogu da pokušaju da dopru do vaših aplikacija. Uključivanje je najvažnije na javnom Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andra enheter i ditt nätverk kan försöka nå dina appar. Att slå på det är viktigast på offentligt Wi-Fi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağınızdaki diğer aygıtlar uygulamalarınıza ulaşmayı deneyebilir. Genel Wi-Fi’de açmak en çok önem taşır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你网络上的其他设备可以尝试访问你的 App。在公共 Wi-Fi 上打开它最为重要。"
          }
        }
      }
    },
