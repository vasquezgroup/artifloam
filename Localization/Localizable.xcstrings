          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps pueden ir más lentas. Sal de una app que no uses; guarda antes tu trabajo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps pueden ir más lentas. Sal de una app que no uses; guarda antes tu trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps risquent de ralentir. Quittez une app que vous n’utilisez pas ; enregistrez d’abord votre travail."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps chönnted langsamer werde. Beände e App, wo du nöd bruuchsch; speicher zerscht dini Arbeit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप धीमे हो सकते हैं। जो ऐप आप उपयोग नहीं कर रहे उसे बंद करें; पहले अपना काम सहेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacije bi mogle usporiti. Zatvori aplikaciju koju ne koristiš; prvo spremi rad."
