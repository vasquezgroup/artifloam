        }
      }
    },
    "Apps may slow down. Quit an app you are not using; save your work first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تبطؤ التطبيقات. أنهِ تطبيقًا لا تستخدمه؛ احفظ عملك أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps poden anar més lentes. Tanca una app que no facis servir; desa primer la feina."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps werden möglicherweise langsamer. Beende eine App, die du nicht nutzt; sichere vorher deine Arbeit."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps may slow down. Quit an app you are not using; save your work first."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps may slow down. Quit an app you are not using; save your work first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
