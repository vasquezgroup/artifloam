    "More room. Less clutter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة أكبر. فوضى أقل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Més espai. Menys desordre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Platz. Weniger Unordnung."
          }
        },
        "en-AU" : {
