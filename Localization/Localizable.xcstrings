          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find exact copies across your home folder by content. Keep one, move the rest to Bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra copias exactas en tu carpeta personal por contenido. Conserva una y mueve el resto a la Papelera."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra copias exactas en tu carpeta personal por contenido. Conserva una y mueve el resto al Basurero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez des copies exactes dans votre dossier personnel, selon leur contenu. Conservez-en une, placez les autres dans la Corbeille."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find exakti Kopie i dim Home-Ordner nach Inhalt. Behalt eini, verschieb d Rescht id Papierkorb."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री के आधार पर होम फ़ोल्डर में बिल्कुल एक जैसी प्रतियाँ खोजें। एक रखें, बाकी रद्दी में भेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronađi točne kopije u početnoj mapi po sadržaju. Zadrži jednu, ostale premjesti u Smeće."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova copie esatte nella tua cartella Home in base al contenuto. Tienine una, sposta le altre nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームフォルダ全体で、内容が完全に同じコピーを見つけます。1つ残して、ほかはゴミ箱へ移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 폴더 전체에서 내용이 완전히 같은 사본을 찾습니다. 하나는 유지하고 나머지는 휴지통으로 이동하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrodi precīzas kopijas visā mājas mapē pēc satura. Paturi vienu, pārējās pārvieto uz Atkritni."
          }
        },
        "pl" : {
          "stringUnit" : {
