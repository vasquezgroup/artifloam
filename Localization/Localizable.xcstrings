    "This Mac doesn't have room for a backup. It needs up to %@ and has %@ free. You can see chats by size in WhatsApp: Settings, Storage and data, Manage storage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر مساحة كافية على هذا الـ Mac لنسخة احتياطية. يحتاج إلى ما يصل إلى %@ ولديه %@ متاحة. يمكنك عرض المحادثات حسب الحجم في WhatsApp: الإعدادات، التخزين والبيانات، إدارة التخزين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest Mac no té espai per a una còpia de seguretat. Necessita fins a %@ i en té %@ de lliures. Pots veure els xats per mida a WhatsApp: Configuració, Emmagatzematge i dades, Gestiona l’emmagatzematge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac hat keinen Platz für ein Backup. Es braucht bis zu %@, frei sind %@. Chats nach Größe siehst du in WhatsApp: Einstellungen, Speicher und Daten, Speicher verwalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This Mac doesn't have room for a backup. It needs up to %1$@ and has %2$@ free. You can see chats by size in WhatsApp: Settings, Storage and data, Manage storage."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac doesn't have room for a backup. It needs up to %1$@ and has %2$@ free. You can see chats by size in WhatsApp: Settings, Storage and data, Manage storage."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac doesn't have room for a backup. It needs up to %1$@ and has %2$@ free. You can see chats by size in WhatsApp: Settings, Storage and data, Manage storage."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac doesn't have room for a backup. It needs up to %1$@ and has %2$@ free. You can see chats by size in WhatsApp: Settings, Storage and data, Manage storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no tiene espacio para una copia de seguridad. Necesita hasta %@ y tiene %@ libres. Puedes ver los chats por tamaño en WhatsApp: Ajustes, Almacenamiento y datos, Gestionar almacenamiento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Mac no tiene espacio para una copia de seguridad. Necesita hasta %@ y tiene %@ libres. Puedes ver los chats por tamaño en WhatsApp: Configuración, Almacenamiento y datos, Administrar almacenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac n’a pas assez de place pour une sauvegarde. Il faut jusqu’à %@ et %@ sont disponibles. Vous pouvez voir les discussions par taille dans WhatsApp : Réglages, Stockage et données, Gérer le stockage."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dä Mac het kein Platz für es Backup. Es bruucht bis zu %@, frei sind %@. Chats nach Grössi gsehsch i WhatsApp: Einstellungen, Speicher und Daten, Speicher verwalten."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Mac पर बैकअप के लिए जगह नहीं है। इसे %@ तक चाहिए और %@ खाली है। आप WhatsApp में चैट आकार के अनुसार देख सकते हैं: सेटिंग, स्टोरेज और डेटा, स्टोरेज प्रबंधित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj Mac nema prostora za sigurnosnu kopiju. Treba do %@, a slobodno je %@. Chatove po veličini možeš vidjeti u WhatsAppu: Postavke, Pohrana i podaci, Upravljanje pohranom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac non ha spazio per un backup. Servono fino a %@ e ne sono liberi %@. Puoi vedere le chat per dimensione in WhatsApp: Impostazioni, Archiviazione e dati, Gestisci archiviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacにはバックアップの空きがありません。最大%1$@が必要ですが、空きは%2$@です。チャットのサイズは、WhatsAppの設定、ストレージとデータ、ストレージを管理で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에는 백업할 공간이 부족합니다. 최대 %1$@가 필요하지만 여유 공간은 %2$@입니다. 채팅별 크기는 WhatsApp의 설정, 저장 공간 및 데이터, 저장 공간 관리에서 확인할 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šajā Mac datorā nepietiek vietas dublējumam. Vajag līdz %1$@, bet brīvs ir %2$@. Čatus pēc izmēra vari redzēt WhatsApp: Iestatījumi, Krātuve un dati, Pārvaldīt krātuvi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Mac nie ma miejsca na kopię zapasową. Potrzebuje do %@, a ma wolne %@. Czaty według rozmiaru zobaczysz w WhatsApp: Ustawienia, Pamięć i dane, Zarządzaj pamięcią."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac não tem espaço para um backup. Precisa de até %@ e tem %@ livres. Pode ver as conversas por tamanho no WhatsApp: Definições, Armazenamento e dados, Gerir armazenamento."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ky Mac nuk ka vend për një kopje rezervë. Duhen deri në %1$@ dhe ka %2$@ të lira. Bisedat sipas madhësisë mund t'i shohësh në WhatsApp: Cilësimet, Ruajtja dhe të dhënat, Menaxho ruajtjen."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овај Mac нема простора за резервну копију. Потребно је до %@, а слободно је %@. Ћаскања по величини можете видети у WhatsApp-у: Подешавања, Складиште и подаци, Управљање складиштем."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj Mac nema prostora za rezervnu kopiju. Potrebno je do %@, a slobodno je %@. Ćaskanja po veličini možete videti u WhatsApp-u: Podešavanja, Skladište i podaci, Upravljanje skladištem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Macen har inte plats för en säkerhetskopia. Den behöver upp till %@ och har %@ ledigt. Du kan se chattar efter storlek i WhatsApp: Inställningar, Lagring och data, Hantera lagring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’te yedek için yer yok. En fazla %@ gerekiyor ve %@ boş. Sohbetleri boyuta göre WhatsApp’ta görebilirsiniz: Ayarlar, Depolama ve veri, Depolamayı yönet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 没有足够的空间用于备份。最多需要 %1$@，可用空间为 %2$@。你可以在 WhatsApp 中按大小查看聊天：“设置”、“存储空间与数据”、“管理存储空间”。"
          }
        }
      }
    },
