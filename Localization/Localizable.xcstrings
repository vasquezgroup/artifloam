          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam ha limpiado por su cuenta lo que es seguro eliminar. Haz clic para revisar elementos más grandes que puedes elegir eliminar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam ha limpiado por su cuenta lo que es seguro eliminar. Haz clic para revisar elementos más grandes que puedes elegir eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam a nettoyé ce qui peut être retiré sans risque. Cliquez pour examiner les éléments plus volumineux que vous pouvez choisir de retirer."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam hät sälber ufgruumt, was sicher entfernt werde cha. Klick zum Prüefe vo grössere Elemente, wo du chasch uuswähle zum Entferne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam ने वह साफ़ कर दिया जिसे अपने आप हटाना सुरक्षित है। बड़े आइटम देखने के लिए क्लिक करें, जिन्हें आप हटाना चुन सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam je očistio ono što se može sigurno ukloniti samo od sebe. Klikni za pregled većih stavki koje možeš odlučiti ukloniti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam ha pulito da solo ciò che si può rimuovere in sicurezza. Clicca per rivedere gli elementi più grandi che puoi scegliere di rimuovere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloamは、単独で安全に削除できるものをクリーンアップしました。クリックすると、削除するかどうか選べる大きな項目を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam이 안전하게 제거할 수 있는 항목을 직접 정리했습니다. 직접 선택해 제거할 수 있는 더 큰 항목을 검토하려면 클릭하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam notīrīja to, ko droši var noņemt pats. Noklikšķini, lai pārskatītu lielākus vienumus, ko vari izvēlēties noņemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam samodzielnie wyczyścił to, co można bezpiecznie usunąć. Kliknij, aby przejrzeć większe elementy, które możesz wybrać do usunięcia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Artifloam limpou o que é seguro remover por si. Clique para rever os itens maiores que pode escolher remover."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam pastroi vetë çfarë është e sigurt për t'u hequr. Kliko për të rishikuar elementët më të mëdhenj që mund të zgjedhësh t'i heqësh."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam је очистио оно што је безбедно уклонити само од себе. Кликните да прегледате веће ставке које можете изабрати за уклањање."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam je očistio ono što je bezbedno ukloniti samo od sebe. Kliknite da pregledate veće stavke koje možete izabrati za uklanjanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam rensade det som är säkert att ta bort på egen hand. Klicka för att granska större objekt som du kan välja att ta bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam kendiliğinden kaldırılması güvenli olanı temizledi. Kaldırmayı seçebileceğiniz daha büyük öğeleri incelemek için tıklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artifloam 已清理了可安全自行移除的内容。点按以审阅你可以选择移除的较大项目。"
          }
        }
      }
    },
