    "You don't need a backup for anything above. It adds WhatsApp by person or group, and which apps have been quiet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتاج إلى نسخة احتياطية لأي شيء مما سبق. فهي تضيف WhatsApp حسب الشخص أو المجموعة، والتطبيقات التي كانت خاملة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cal cap còpia de seguretat per a res del que hi ha a dalt. Hi afegeix WhatsApp per persona o grup, i quines apps han estat inactives."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für nichts oben brauchst du ein Backup. Es ergänzt WhatsApp nach Person oder Gruppe und welche Apps ruhig waren."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need a backup for anything above. It adds WhatsApp by person or group, and which apps have been quiet."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need a backup for anything above. It adds WhatsApp by person or group, and which apps have been quiet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't need a backup for anything above. It adds WhatsApp by person or group, and which apps have been quiet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas copia de seguridad para nada de lo anterior. Añade WhatsApp por persona o grupo, y qué apps han estado inactivas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas copia de seguridad para nada de lo anterior. Agrega WhatsApp por persona o grupo, y qué apps estuvieron inactivas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez besoin d’une sauvegarde pour rien de ce qui précède. Elle ajoute WhatsApp par personne ou groupe, et les apps restées inactives."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für nüt obe bruuchsch es Backup. Es ergänzt WhatsApp nach Person oder Gruppe und welli Apps rueig gsi sind."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर की किसी भी चीज़ के लिए बैकअप ज़रूरी नहीं है। इससे WhatsApp व्यक्ति या समूह के अनुसार दिखता है, और यह भी कि कौन से ऐप शांत रहे हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosna kopija ne treba ti ni za što od gore navedenog. Dodaje WhatsApp po osobi ili grupi i koje su aplikacije bile mirne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve un backup per nulla di quanto sopra. Aggiunge WhatsApp per persona o gruppo e quali app sono rimaste inattive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上記のことには、バックアップは必要ありません。バックアップがあると、WhatsAppの個人別・グループ別の内訳と、使われていないアプリがわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 항목에는 백업이 필요하지 않습니다. 백업이 있으면 WhatsApp을 개인별·그룹별로 볼 수 있고, 사용하지 않은 앱도 알 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevienam no iepriekšminētā dublējums nav vajadzīgs. Tas pievieno WhatsApp pēc personas vai grupas un to, kuras lietotnes ir bijušas neaktīvas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zapasowa nie jest potrzebna do niczego powyżej. Dodaje WhatsApp według osoby lub grupy oraz informację, które aplikacje były nieaktywne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não precisa de backup para nada do que está acima. Acrescenta o WhatsApp por pessoa ou grupo, e as apps que estiveram inativas."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk të duhet kopje rezervë për asgjë më sipër. Ajo shton WhatsApp sipas personit ose grupit dhe cilat aplikacione kanë qenë të qeta."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервна копија вам не треба ни за шта од горе наведеног. Додаје WhatsApp по особи или групи и које су апликације биле мирне."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezervna kopija vam ne treba ni za šta od gore navedenog. Dodaje WhatsApp po osobi ili grupi i koje su aplikacije bile mirne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver ingen säkerhetskopia för något ovan. Den lägger till WhatsApp per person eller grupp och vilka appar som har varit tysta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıdakilerin hiçbiri için yedeğe gerek yok. Yedek, WhatsApp’ı kişi veya gruba göre ve hangi uygulamaların hareketsiz kaldığını ekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上内容都不需要备份。备份可以增加按个人或群组查看 WhatsApp，以及哪些 App 长期未使用。"
          }
        }
      }
    },
