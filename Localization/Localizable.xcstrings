          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haciendo una copia de seguridad de tu %@. Mantenlo desbloqueado y conectado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haciendo una copia de seguridad de tu %@. Mantenlo desbloqueado y conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde de votre %@ en cours. Gardez-le déverrouillé et connecté."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %@ wird gsicheret. Lass en entsperrt und verbunde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके %@ का बैकअप लिया जा रहा है। उसे अनलॉक और कनेक्ट रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izrada sigurnosne kopije %@a. Neka ostane otključan i spojen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup dell'%@ in corso. Tienilo sbloccato e collegato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をバックアップ中です。ロックを解除して接続したままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 백업하는 중입니다. 잠금을 해제하고 연결한 상태로 유지하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
