    "Under 10% free: macOS slows down and updates may fail. Start with the biggest items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل من 10% متاحة: يتباطأ macOS وقد تفشل التحديثات. ابدأ بأكبر العناصر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menys del 10 % lliure: macOS va més lent i les actualitzacions poden fallar. Comença pels elements més grans."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 10% frei: macOS wird langsamer, und Updates können fehlschlagen. Beginne mit den größten Objekten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 10% free: macOS slows down and updates may fail. Start with the biggest items."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 10% free: macOS slows down and updates may fail. Start with the biggest items."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 10% free: macOS slows down and updates may fail. Start with the biggest items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos del 10 % libre: macOS se ralentiza y las actualizaciones pueden fallar. Empieza por los elementos más grandes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos del 10 % libre: macOS se ralentiza y las actualizaciones pueden fallar. Empieza por los elementos más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de 10 % d’espace libre : macOS ralentit et les mises à jour peuvent échouer. Commencez par les plus gros éléments."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 10% frei: macOS wird langsamer, und Updates chönd fählschlage. Fang mit de grösschte Elemente aa."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10% से कम खाली: macOS धीमा हो जाता है और अपडेट विफल हो सकते हैं। सबसे बड़े आइटम से शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manje od 10% slobodno: macOS usporava i ažuriranja mogu ne uspjeti. Počni s najvećim stavkama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno del 10% libero: macOS rallenta e gli aggiornamenti possono fallire. Parti dagli elementi più grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空きが10%未満:macOSの動作が遅くなり、アップデートが失敗することがあります。最も大きな項目から始めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여유 공간 10% 미만: macOS가 느려지고 업데이트가 실패할 수 있습니다. 가장 큰 항목부터 시작하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazāk nekā 10% brīvi: macOS darbojas lēnāk un atjauninājumi var neizdoties. Sāc ar lielākajiem vienumiem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poniżej 10% wolnego miejsca: macOS zwalnia, a uaktualnienia mogą się nie udać. Zacznij od największych elementów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de 10% livres: o macOS fica mais lento e as atualizações podem falhar. Comece pelos maiores itens."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nën 10% të lira: macOS ngadalësohet dhe përditësimet mund të dështojnë. Fillo me elementët më të mëdhenj."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мање од 10% слободно: macOS успорава и ажурирања могу да не успеју. Почните са највећим ставкама."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manje od 10% slobodno: macOS usporava i ažuriranja mogu da ne uspeju. Počnite sa najvećim stavkama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 10 % ledigt: macOS blir långsammare och uppdateringar kan misslyckas. Börja med de största objekten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş alan yüzde 10 altında: macOS yavaşlar ve güncellemeler başarısız olabilir. En büyük öğelerden başlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间不足 10%：macOS 会变慢，更新也可能失败。请从最大的项目开始。"
          }
        }
      }
    },
