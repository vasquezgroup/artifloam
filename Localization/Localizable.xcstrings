    "Keeps the oldest copy and reviews the others before they move to the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي أقدم نسخة ويراجع النسخ الأخرى قبل نقلها إلى سلة المهملات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la còpia més antiga i revisa les altres abans que es moguin a la paperera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält die älteste Kopie und lässt dich die anderen durchsehen, bevor sie in den Papierkorb kommen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the oldest copy and reviews the others before they move to the Bin."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the oldest copy and reviews the others before they move to the Trash."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the oldest copy and reviews the others before they move to the Bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la copia más antigua y revisa las demás antes de moverlas a la Papelera."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la copia más antigua y revisa las demás antes de moverlas al Basurero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve la plus ancienne copie et examine les autres avant qu’elles soient placées dans la Corbeille."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bhaltet di eltischti Kopie; d andere werded prüeft, bevor si id Papierkorb chömed."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे पुरानी प्रति रखता है और बाकी को रद्दी में भेजने से पहले उनकी समीक्षा करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržava najstariju kopiju i pregledava ostale prije premještanja u Smeće."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene la copia più vecchia e rivede le altre prima che vengano spostate nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も古いコピーを保持し、ほかはゴミ箱へ移動する前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 오래된 사본을 유지하고 나머지는 휴지통으로 이동하기 전에 검토합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patur vecāko kopiju un liek pārskatīt pārējās, pirms tās tiek pārvietotas uz Atkritni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje najstarszą kopię i poddaje pozostałe przeglądowi, zanim trafią do Kosza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a cópia mais antiga e revê as outras antes de serem movidas para o Lixo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mban kopjen më të vjetër dhe i rishikon të tjerat para se të zhvendosen në Kosh."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задржава најстарију копију, а остале се прегледају пре премештања у Отпад."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržava najstariju kopiju, a ostale se pregledaju pre premeštanja u Otpad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåller den äldsta kopian och låter dig granska de andra innan de flyttas till papperskorgen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eski kopyayı korur ve diğerlerini Çöp Sepeti’ne taşınmadan önce incelemenize sunar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留最旧的副本，其余的在移到废纸篓之前会先审阅。"
          }
        }
      }
    },
