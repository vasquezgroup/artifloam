        }
      }
    },
    "Your %@ stopped answering, so Artifloam can't confirm what was removed. Check it, then start over." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف الـ %@ عن الاستجابة، لذا لا يستطيع Artifloam تأكيد ما تمت إزالته. تحقق منه، ثم ابدأ من جديد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’%@ ha deixat de respondre, així que Artifloam no pot confirmar què s’ha eliminat. Revisa’l i torna a començar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@ antwortet nicht mehr, daher kann Artifloam nicht bestätigen, was entfernt wurde. Prüfe es und beginne dann neu."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ stopped answering, so Artifloam can't confirm what was removed. Check it, then start over."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ stopped answering, so Artifloam can't confirm what was removed. Check it, then start over."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ stopped answering, so Artifloam can't confirm what was removed. Check it, then start over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %@ ha dejado de responder, así que Artifloam no puede confirmar qué se ha quitado. Compruébalo y empieza de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %@ dejó de responder, así que Artifloam no puede confirmar qué se quitó. Compruébalo y empieza de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre %@ a cessé de répondre ; Artifloam ne peut donc pas confirmer ce qui a été supprimé. Vérifiez-le, puis recommencez."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %@ antwortet nüme, drum cha Artifloam nöd bestätige, was entfernt worde isch. Prüef en und fang denn neu aa."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके %@ ने जवाब देना बंद कर दिया, इसलिए Artifloam पुष्टि नहीं कर सकता कि क्या हटाया गया। उसे जाँचें, फिर फिर से शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj %@ je prestao odgovarati, pa Artifloam ne može potvrditi što je uklonjeno. Provjeri ga, zatim počni ispočetka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'%@ ha smesso di rispondere, quindi Artifloam non può confermare cosa è stato rimosso. Controllalo, poi ricomincia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が応答しなくなったため、Artifloamは何が削除されたか確認できません。%1$@を確認して、最初からやり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 응답하지 않아 Artifloam이 무엇이 제거되었는지 확인할 수 없습니다. %1$@을(를) 확인한 다음 처음부터 다시 시작하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavs %@ pārstāja atbildēt, tāpēc Artifloam nevar apstiprināt, kas tika noņemts. Pārbaudi to un sāc no jauna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje urządzenie %@ przestało odpowiadać, więc Artifloam nie może potwierdzić, co zostało usunięte. Sprawdź je, a potem zacznij od nowa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu %@ deixou de responder, por isso o Artifloam não consegue confirmar o que foi removido. Verifique-o e recomece."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yt pushoi së përgjigjuri, ndaj Artifloam nuk mund të konfirmojë çfarë u hoq. Kontrollo dhe fillo nga e para."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш %@ је престао да одговара, па Artifloam не може да потврди шта је уклоњено. Проверите га, па почните испочетка."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš %@ je prestao da odgovara, pa Artifloam ne može da potvrdi šta je uklonjeno. Proverite ga, pa počnite ispočetka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din %@ slutade svara, så Artifloam kan inte bekräfta vad som togs bort. Kontrollera den och börja sedan om."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cihazınız yanıt vermeyi bıraktı, bu yüzden Artifloam nelerin kaldırıldığını doğrulayamıyor. Kontrol edin, ardından baştan başlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 停止响应，因此 Artifloam 无法确认已移除的内容。请检查 %1$@，然后重新开始。"
          }
        }
      }
    },
