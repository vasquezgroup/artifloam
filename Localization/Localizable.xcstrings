        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tā jaunākais dublējums ir vecāks par mēnesi, vai tā nav. %@: Iestatījumi, tavs vārds, iCloud, iCloud dublēšana, Dublēt tūlīt."
          }
        },
        "pl" : {
          "stringUnit" : {
