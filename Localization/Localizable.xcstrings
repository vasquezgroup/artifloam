    "From when each app's data last changed, according to the backup. Background activity counts too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منذ آخر تغيّر في بيانات كل تطبيق، بحسب النسخة الاحتياطية. ويُحتسب النشاط في الخلفية أيضًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
