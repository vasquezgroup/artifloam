          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrada antiga de cache web; as contas, os cookies e os dados de apps são preservados."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyrje e vjetër e cache të uebit; llogaritë, cookies dhe të dhënat e aplikacioneve ruhen."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стара ставка веб кеша; налози, колачићи и подаци апликације се чувају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stara stavka veb keša; nalozi, kolačići i podaci aplikacije se čuvaju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gammal webbcache-post; konton, cookies och programdata bevaras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski web önbelleği girdisi; hesaplar, çerezler ve uygulama verileri korunur."
          }
