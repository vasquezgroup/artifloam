    "This may hold your login codes. Without them or a recovery option, you can get locked out of your accounts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يحتوي هذا على رموز تسجيل الدخول الخاصة بك. وبدونها أو بدون خيار استعادة، قد لا تتمكن من الدخول إلى حساباتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pot contenir els teus codis d’inici de sessió. Sense ells o una opció de recuperació, et pots quedar sense accés als teus comptes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier können deine Login-Codes liegen. Ohne sie oder eine Wiederherstellungsoption kannst du aus deinen Konten ausgesperrt werden."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
