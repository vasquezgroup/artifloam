    "Read file sizes and folder names. This never removes files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ أحجام الملفات وأسماء المجلدات. لا يزيل ملفات أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegeix mides d’arxius i noms de carpetes. Això mai elimina arxius."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest Dateigrößen und Ordnernamen. Dabei werden nie Dateien entfernt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read file sizes and folder names. This never removes files."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read file sizes and folder names. This never removes files."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read file sizes and folder names. This never removes files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee tamaños de archivo y nombres de carpeta. Esto nunca elimina archivos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee tamaños de archivo y nombres de carpeta. Esto nunca elimina archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les tailles de fichiers et les noms de dossiers. Ne retire jamais de fichiers."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest Dateigrössi und Ordnernäme. Das entfernt nie Dateie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल आकार और फ़ोल्डर नाम पढ़ता है। यह कभी फ़ाइलें नहीं हटाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čita veličine datoteka i nazive mapa. Ovo nikad ne uklanja datoteke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge dimensioni dei file e nomi delle cartelle. Non rimuove mai file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルサイズとフォルダ名を読み取ります。ファイルが削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 크기와 폴더 이름을 읽습니다. 파일을 제거하지 않습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasa failu izmērus un mapju nosaukumus. Tas nekad nenoņem failus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuje rozmiary plików i nazwy folderów. To nigdy nie usuwa plików."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê tamanhos de ficheiros e nomes de pastas. Nunca remove ficheiros."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lexo madhësitë e skedarëve dhe emrat e dosjeve. Kjo nuk heq kurrë skedarë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чита величине фајлова и имена фасцикли. Ово никада не уклања фајлове."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čita veličine fajlova i imena fascikli. Ovo nikada ne uklanja fajlove."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser filstorlekar och mappnamn. Detta tar aldrig bort filer."
          }
