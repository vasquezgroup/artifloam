          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移到“应用程序”"
          }
        }
      }
    },
    "Moved to Recently Deleted. The space comes back when iOS empties it after about 30 days, or when you empty it in Photos." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم النقل إلى «المحذوفة مؤخرًا». تعود المساحة عندما يفرغها iOS بعد نحو 30 يومًا، أو عندما تفرغها في الصور."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha mogut a Eliminats recentment. L’espai es recupera quan l’iOS ho buida al cap d’uns 30 dies, o quan ho buides a Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In „Zuletzt gelöscht“ verschoben. Der Platz wird frei, wenn iOS es nach etwa 30 Tagen leert oder wenn du es in Fotos leerst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moved to Recently Deleted. The space comes back when iOS empties it after about 30 days, or when you empty it in Photos."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moved to Recently Deleted. The space comes back when iOS empties it after about 30 days, or when you empty it in Photos."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moved to Recently Deleted. The space comes back when iOS empties it after about 30 days, or when you empty it in Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movido a Eliminados recientemente. El espacio se recupera cuando iOS lo vacía pasados unos 30 días, o cuando lo vacías en Fotos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movido a Eliminados recientemente. El espacio se recupera cuando iOS lo vacía pasados unos 30 días, o cuando lo vacías en Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacé dans Supprimés récemment. L’espace est récupéré quand iOS le vide au bout d’environ 30 jours, ou quand vous le videz dans Photos."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In «Zuletzt gelöscht» verschobe. De Platz wird frei, wenn iOS es nach öppe 30 Täg leert oder wenn du es i Fotos leersch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“हाल ही में डिलीट किए गए” में भेजा गया। जगह तब वापस मिलती है जब iOS लगभग 30 दिन बाद इसे खाली करता है, या जब आप फ़ोटो में इसे खाली करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premješteno u Nedavno izbrisano. Prostor se vraća kad iOS to isprazni nakon oko 30 dana ili kad to isprazniš u Fotografijama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostato in Eliminati di recente. Lo spazio torna disponibile quando iOS lo svuota dopo circa 30 giorni, o quando lo svuoti in Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最近削除した項目」に移動しました。約30日後にiOSが空にするか、「写真」で空にすると、容量が戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 삭제된 항목으로 이동했습니다. 약 30일 후 iOS가 비우거나 사진 앱에서 직접 비우면 공간이 확보됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārvietots uz Nesen dzēstie. Vieta atbrīvosies, kad iOS to iztukšos pēc apmēram 30 dienām, vai kad pats to iztukšosi lietotnē Foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeniesiono do Ostatnio usunięte. Miejsce wróci, gdy iOS opróżni ten album po około 30 dniach lub gdy opróżnisz go w Zdjęciach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movido para Eliminados Recentemente. O espaço volta quando o iOS a esvazia passados cerca de 30 dias, ou quando a esvazia nas Fotografias."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U zhvendos te Fshirë së fundi. Hapësira kthehet kur iOS e boshatis pas rreth 30 ditësh, ose kur e boshatis ti te Fotot."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премештено у Недавно обрисано. Простор се враћа када iOS испразни то после око 30 дана или када то испразните у Фотографијама."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premešteno u Nedavno obrisano. Prostor se vraća kada iOS isprazni to posle oko 30 dana ili kada to ispraznite u Fotografijama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttat till Nyligen raderade. Utrymmet kommer tillbaka när iOS tömmer det efter cirka 30 dagar, eller när du tömmer det i Foton."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınlarda Silinenler’e taşındı. Alan, iOS yaklaşık 30 gün sonra bunu boşalttığında ya da Fotoğraflar’da siz boşalttığınızda geri gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移到“最近删除”。约 30 天后 iOS 清空它，或你在“照片”中将其清空后，空间才会恢复。"
          }
        }
      }
    },
