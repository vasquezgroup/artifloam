    "Starting now. Your files are still only read until you choose to remove something." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ الآن. تبقى ملفاتك للقراءة فقط إلى أن تختار إزالة شيء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comença ara. Els teus arxius només es llegeixen fins que triïs eliminar alguna cosa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es geht jetzt los. Deine Dateien werden weiterhin nur gelesen, bis du dich entscheidest, etwas zu entfernen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting now. Your files are still only read until you choose to remove something."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting now. Your files are still only read until you choose to remove something."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting now. Your files are still only read until you choose to remove something."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezando ahora. Tus archivos solo se leen hasta que elijas eliminar algo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezando ahora. Tus archivos solo se leen hasta que elijas eliminar algo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On démarre. Vos fichiers ne sont toujours que lus tant que vous ne choisissez pas de retirer quelque chose."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fangt jetzt aa. Dini Dateie werded nume gläse, bis du entscheisch, öppis z entferne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी शुरू हो रहा है। आप जब तक कुछ हटाना न चुनें, आपकी फ़ाइलें केवल पढ़ी जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počinje sada. Tvoje se datoteke i dalje samo čitaju dok ne odlučiš nešto ukloniti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si parte. I tuoi file vengono solo letti finché non scegli di rimuovere qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まもなく開始します。何かを削除することを選ぶまで、ファイルは読み取られるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 시작합니다. 제거할 항목을 직접 선택하기 전까지 파일은 읽기만 합니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sākam tūlīt. Tavi faili joprojām tikai tiek lasīti, kamēr neizvēlies kaut ko noņemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start teraz. Twoje pliki są nadal tylko odczytywane, dopóki nie wybierzesz usunięcia czegoś."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A começar agora. Os seus ficheiros continuam apenas a ser lidos até escolher remover algo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po fillon tani. Skedarët e tu vetëm lexohen derisa të zgjedhësh të heqësh diçka."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почиње сада. Ваши фајлови се и даље само читају док не изаберете да нешто уклоните."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počinje sada. Vaši fajlovi se i dalje samo čitaju dok ne izaberete da nešto uklonite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar nu. Dina filer bara läses tills du väljer att ta bort något."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
