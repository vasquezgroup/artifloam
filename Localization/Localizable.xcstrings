    "Git status, preserved commits, session activity and running processes decide whether a checkout needs review. Worktrees are never removed automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدد حالة Git وcommits المحفوظة ونشاط الجلسات والعمليات قيد التشغيل ما إذا كان checkout بحاجة إلى مراجعة. لا تتم إزالة worktrees تلقائيًا أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’estat de Git, els commits preservats, l’activitat de les sessions i els processos en execució decideixen si un checkout cal revisar-lo. Els worktrees mai s’eliminen automàticament."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git-Status, erhaltene Commits, Sitzungsaktivität und laufende Prozesse entscheiden, ob ein Checkout durchgesehen werden muss. Worktrees werden nie automatisch entfernt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git status, preserved commits, session activity and running processes decide whether a checkout needs review. Worktrees are never removed automatically."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
