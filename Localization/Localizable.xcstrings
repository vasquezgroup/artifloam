          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos ítems de inicio significa más memoria libre cada vez que arranca tu Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos elementos de inicio significa más memoria libre cada vez que arranca tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins d’éléments d’ouverture, c’est plus de mémoire libre à chaque démarrage de votre Mac."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Anmeldeobjekt heisst meh freie Arbeitsspeicher bi jedem Start vo dim Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम लॉगइन आइटम का मतलब है कि हर बार Mac शुरू होने पर ज़्यादा मेमोरी खाली रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manje stavki za prijavu znači više slobodnog RAM-a svaki put kad se tvoj Mac pokrene."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno elementi login significano più memoria libera a ogni avvio del Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン項目が少ないほど、Macを起動するたびに空きメモリが増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 항목이 적을수록 Mac을 시작할 때마다 사용 가능한 메모리가 늘어납니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazāk pieteikšanās vienumu nozīmē vairāk brīvas atmiņas katru reizi, kad Mac startē."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniej elementów logowania to więcej wolnej pamięci przy każdym uruchomieniu Maca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos itens de início de sessão significam mais memória livre sempre que o Mac inicia."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Më pak elementë hyrjeje do të thotë më shumë memorie e lirë sa herë që nis Mac-u yt."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мање ставки за пријављивање значи више слободне меморије сваки пут када се ваш Mac покрене."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manje stavki za prijavljivanje znači više slobodne memorije svaki put kada se vaš Mac pokrene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
