          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspectez les agents de lancement et les services. Gérez les éléments d’ouverture activés dans Réglages Système."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspizier Launch Agents und Dienscht. Verwalt aktivierti Anmeldeobjekt i de macOS-Systemeinstellungen."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉन्च एजेंट और सेवाओं का निरीक्षण करें। चालू लॉगइन आइटम macOS की सिस्टम सेटिंग से प्रबंधित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjeri launch agente i servise. Omogućenim stavkama za prijavu upravljaj u Postavkama sustava."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispeziona agenti di avvio e servizi. Gestisci gli elementi login attivi in Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動エージェントとサービスを調べます。有効なログイン項目の管理は、macOSのシステム設定で行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "launch agent와 서비스를 살펴봅니다. 켜져 있는 로그인 항목은 macOS 시스템 설정에서 관리하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbaudi palaišanas aģentus un pakalpojumus. Ieslēgtos pieteikšanās vienumus pārvaldi sadaļā macOS Sistēmas iestatījumi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź agenty uruchamiania i usługi. Włączonymi elementami logowania zarządzaj w Ustawieniach systemowych macOS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecione agentes de arranque e serviços. Gira os itens de início de sessão ativos nas Definições do macOS."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspekto agjentët dhe shërbimet e nisjes. Menaxho elementët e hyrjes të aktivizuar me Cilësimet e sistemit të macOS."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверите launch agents и сервисе. Укљученим ставкама за пријављивање управљајте преко Системских подешавања."
          }
        },
        "sr-Latn" : {
