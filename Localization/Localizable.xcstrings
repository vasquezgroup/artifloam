            "value" : "पुरानी वेब कैश एंट्री; खाते, कुकी और ऐप्लिकेशन डेटा रखे जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stara stavka web-predmemorije; računi, kolačići i podaci aplikacija ostaju sačuvani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vecchia voce della cache web; account, cookie e dati delle applicazioni vengono conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いWebキャッシュのエントリ。アカウント、Cookie、アプリケーションデータは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래된 웹 캐시 항목. 계정, 쿠키, 앱 데이터는 보존됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vecs tīmekļa kešatmiņas ieraksts; konti, sīkdatnes un lietotņu dati tiek paturēti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
