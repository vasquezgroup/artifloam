          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado recientemente. Aun así puedes limpiarlo; su app probablemente lo reconstruirá."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado recientemente. Aun así puedes limpiarlo; su app probablemente lo reconstruirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé récemment. Vous pouvez quand même le nettoyer ; son app le recréera probablement."
          }
        },
        "gsw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chürzlich bruucht. Du chasch en trotzdem ufruume; sini App baut en wahrschiinlich neu uf."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल में उपयोग हुआ। आप अब भी इसे साफ़ कर सकते हैं; इसका ऐप शायद इसे दोबारा बना लेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedavno korišteno. Još uvijek možeš to očistiti; njezina će je aplikacija vjerojatno ponovno izgraditi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato di recente. Puoi comunque pulirlo; la sua app probabilmente lo ricostruirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近使用されました。クリーンアップは可能です。そのアプリがおそらく再作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근에 사용했습니다. 그래도 정리할 수 있으며, 해당 앱이 다시 만들 가능성이 높습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lietots nesen. Vari to joprojām notīrīt; tās lietotne to visticamāk izveidos no jauna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedawno używane. Nadal możesz to wyczyścić; jej aplikacja prawdopodobnie to odbuduje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada recentemente. Ainda a pode limpar; a app provavelmente vai recriá-la."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përdorur së fundmi. Mund ta pastrosh prapë; aplikacioni i tij ka gjasa ta rindërtojë."
          }
        },
        "sr-Cyrl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавно коришћено. И даље можете да га очистите; његова апликација ће га вероватно поново направити."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedavno korišćeno. I dalje možete da ga očistite; njegova aplikacija će ga verovatno ponovo napraviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd nyligen. Du kan fortfarande rensa den; dess app bygger troligen upp den igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakın zamanda kullanıldı. Yine de temizleyebilirsiniz; uygulaması büyük olasılıkla yeniden oluşturur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近使用过。你仍可清理它；其 App 很可能会重新生成它。"
          }
        }
      }
