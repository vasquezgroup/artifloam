    "Inside your projects. Never ticked for you: a project may still need these. Files Git tracks aren't listed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داخل مشاريعك. لا تُحدَّد لك أبدًا: قد يظل المشروع بحاجة إليها. الملفات التي يتتبعها Git غير مدرجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dins dels teus projectes. Mai vénen marcats: potser un projecte encara ho necessita. Els arxius que Git segueix no es llisten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
